---
import { portfolio } from "../lib/content";
import BwImagePlaceholder from "./ui/BwImagePlaceholder.astro";
---

<section id="portfolio" class="scroll-mt-24 border-t border-green">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <div class="max-w-xl" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.2em]">
        {portfolio.eyebrow}
      </p>
      <h2
        class="font-display mt-3 text-3xl font-medium leading-tight tracking-tight sm:text-4xl"
      >
        {portfolio.title}
      </h2>
      <p class="mt-4 leading-relaxed text-green/80">{portfolio.description}</p>
    </div>
    <div
      class="mt-10 flex flex-wrap gap-3"
      role="group"
      aria-label={portfolio.filtersLabel}
      data-reveal
    >
      {portfolio.filters.map((filter) => (
        <button
          type="button"
          data-filter={filter.value}
          aria-pressed={filter.value === "todos" ? "true" : "false"}
          class={`rounded-md border border-green px-4 py-2 text-sm font-semibold transition-colors ${
            filter.value === "todos"
              ? "bg-green text-cream"
              : "bg-transparent text-green hover:bg-green hover:text-cream"
          }`}
        >
          {filter.label}
        </button>
      ))}
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {portfolio.items.map((item, index) => (
        <a
          href={item.href ?? "#"}
          data-category={item.category}
          class="group flex flex-col overflow-hidden rounded-md border border-green bg-green text-cream transition-colors hover:bg-green-dark"
          data-reveal
          style={{ transitionDelay: `${index * 60}ms` }}
          aria-disabled={!item.href ? "true" : undefined}
        >
          <BwImagePlaceholder class="aspect-[4/3] w-full" />
          <div class="flex flex-1 flex-col gap-2 border-t border-green p-6">
            <p class="font-mono text-xs uppercase tracking-widest text-cream/70">
              {item.client}
            </p>
            <h3 class="font-display text-xl font-medium">{item.project}</h3>
            <p class="mt-1 text-sm leading-relaxed text-cream/80">
              {item.description}
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              {item.technologies.map((tech) => (
                <span
                  class="border border-cream px-2 py-1 font-mono text-[0.65rem] uppercase tracking-widest text-cream"
                >
                  {tech}
                </span>
              ))}
            </div>
            {item.href && (
              <span class="mt-5 inline-block text-xs font-semibold uppercase tracking-[0.2em] underline underline-offset-4">
                {portfolio.detailsLabel}
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll("[data-filter]");
  const cards = document.querySelectorAll("[data-category]");

  const applyFilter = (filter: string) => {
    filterButtons.forEach((button) => {
      const isActive = button.getAttribute("data-filter") === filter;
      button.classList.toggle("bg-green", isActive);
      button.classList.toggle("text-cream", isActive);
      button.classList.toggle("bg-transparent", !isActive);
      button.classList.toggle("text-green", !isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });
    cards.forEach((card) => {
      const category = card.getAttribute("data-category");
      card.classList.toggle(
        "hidden",
        filter !== "todos" && filter !== category
      );
    });
  };

  if (filterButtons.length) {
    const initial = new URLSearchParams(window.location.search).get("cat");
    const valid = Array.from(filterButtons).some(
      (button) => button.getAttribute("data-filter") === initial
    );
    if (valid) {
      applyFilter(initial ?? "todos");
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.getAttribute("data-filter") ?? "todos";
        applyFilter(filter);
        const url = new URL(window.location.href);
        if (filter === "todos") {
          url.searchParams.delete("cat");
        } else {
          url.searchParams.set("cat", filter);
        }
        history.replaceState({}, "", url);
      });
    });
  }
</script>
