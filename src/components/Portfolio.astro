---
import { portfolio } from "../lib/content";
import { Image } from "astro:assets";
import BwImagePlaceholder from "./ui/BwImagePlaceholder.astro";
---

<section id="portfolio" class="scroll-mt-24 border-t border-green">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <div class="max-w-xl" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.2em]">
        {portfolio.eyebrow}
      </p>
      <h2
        class="font-display mt-3 text-3xl font-medium leading-tight tracking-tight sm:text-4xl"
      >
        {portfolio.title}
      </h2>
      <p class="mt-4 leading-relaxed text-green/80">{portfolio.description}</p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {portfolio.items.map((item, index) => (
        <a
          href={item.href ?? "#"}
          class="group flex flex-col overflow-hidden rounded-md border border-green bg-green text-cream transition-colors hover:bg-green-dark"
          data-reveal
          style={{ transitionDelay: `${index * 60}ms` }}
          aria-disabled={!item.href ? "true" : undefined}
        >
          <div class="aspect-[16/9] w-full overflow-hidden">
            {item.image ? (
              <Image
                src={item.image}
                alt={item.imageAlt ?? item.project}
                widths={[400, 800, 1200]}
                sizes="(min-width: 768px) 33vw, 100vw"
                class="h-full w-full object-cover object-top"
                loading="lazy"
              />
            ) : (
              <BwImagePlaceholder class="h-full w-full" />
            )}
          </div>
          <div class="flex flex-1 flex-col gap-2 border-t border-green p-6">
            <p class="font-mono text-xs uppercase tracking-widest text-cream/70">
              {item.client}
            </p>
            <h3 class="font-display text-xl font-medium">{item.project}</h3>
            <p class="mt-1 text-sm leading-relaxed text-cream/80">
              {item.description}
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              {item.technologies.map((tech) => (
                <span
                  class="border border-cream px-2 py-1 font-mono text-[0.65rem] uppercase tracking-widest text-cream"
                >
                  {tech}
                </span>
              ))}
            </div>
            {item.href && (
              <span class="mt-auto inline-block pt-5 text-xs font-semibold uppercase tracking-[0.2em] underline underline-offset-4">
                {portfolio.detailsLabel}
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

