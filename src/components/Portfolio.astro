---
import { portfolio } from "../lib/content";
import BwImagePlaceholder from "./ui/BwImagePlaceholder.astro";
---

<section id="portfolio" class="scroll-mt-24 border-t border-green">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <div class="max-w-xl" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.2em]">
        {portfolio.eyebrow}
      </p>
      <h2
        class="font-display mt-3 text-3xl font-medium leading-tight tracking-tight sm:text-4xl"
      >
        {portfolio.title}
      </h2>
      <p class="mt-4 leading-relaxed text-green/80">{portfolio.description}</p>
    </div>
    <div
      class="mt-10 flex flex-wrap gap-3"
      role="group"
      aria-label={portfolio.filtersLabel}
      data-reveal
    >
      {portfolio.filters.map((filter) => (
        <button
          type="button"
          data-filter={filter.value}
          aria-pressed={filter.value === "todos" ? "true" : "false"}
          class={`border border-green px-4 py-2 text-sm font-semibold transition-colors ${
            filter.value === "todos"
              ? "bg-green text-cream"
              : "bg-transparent text-green hover:bg-green hover:text-cream"
          }`}
        >
          {filter.label}
        </button>
      ))}
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {portfolio.items.map((item, index) => (
        <article
          data-category={item.category}
          class="flex flex-col border border-green"
          data-reveal
          style={{ transitionDelay: `${index * 60}ms` }}
        >
          <BwImagePlaceholder class="aspect-[4/3] w-full" />
          <div class="flex flex-1 flex-col gap-2 border-t border-green p-6">
            <p class="font-mono text-xs uppercase tracking-widest text-green/70">
              {item.client}
            </p>
            <h3 class="font-display text-xl font-medium">{item.project}</h3>
            <p class="mt-1 text-sm leading-relaxed text-green/80">
              {item.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll("[data-filter]");
  const cards = document.querySelectorAll("[data-category]");

  if (filterButtons.length) {
    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.getAttribute("data-filter");
        filterButtons.forEach((b) => {
          const isActive = b === button;
          b.classList.toggle("bg-green", isActive);
          b.classList.toggle("text-cream", isActive);
          b.classList.toggle("bg-transparent", !isActive);
          b.classList.toggle("text-green", !isActive);
          b.setAttribute("aria-pressed", String(isActive));
        });
        cards.forEach((card) => {
          const category = card.getAttribute("data-category");
          card.classList.toggle(
            "hidden",
            filter !== "todos" && filter !== category
          );
        });
      });
    });
  }
</script>
