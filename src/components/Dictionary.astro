---
import { dictionaryEntry } from "../lib/content";

// Apertura cinematográfica de /nosotros inspirada en los title cards de "The Mentalist":
// El logo de misure se presenta a gran escala y centrado, prescindiendo de los bordes
// superior e inferior. Debajo, un bloque de tipografía de máquina de escribir alterna
// automáticamente con efecto de desenfoque (blur) entre la pronunciación fonética/categoría
// y la traducción, pausándose al pasar el cursor (hover).
// Al scrollear, el logo de gran escala realiza un morphing continuo hacia la posición
// del logo en el navbar, logrando que no aparezca duplicado en ningún momento.
---

<section class="scroll-mt-24">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20 md:py-28 md:px-6">
    <div
      class="mx-auto flex w-full max-w-3xl flex-col items-center text-center"
      data-reveal="blur"
      data-dictionary-card
    >
      <!-- Logo misure: placeholder medido en el flujo para el viaje continuo hacia el navbar -->
      <div class="flex w-full justify-center">
        <img
          src="/misure-logo.svg"
          alt={dictionaryEntry.word}
          class="h-auto w-[82%] max-w-[340px] select-none object-contain sm:max-w-[460px] md:max-w-[560px] lg:max-w-[620px]"
          data-dictionary-logo-placeholder
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Bloque de texto animado con desenfoque / blur estilo The Mentalist.
           Sin aria-live a propósito: el bloque cambia solo cada 2 segundos y un
           aria-live haría que el lector de pantalla anuncie todo el texto cada
           vez; el slide inactivo ya está aria-hidden, así que el lector lee el
           actual cuando llega a él. -->
      <div
        class="mt-6 grid w-full grid-cols-1 grid-rows-1 place-items-center text-center sm:mt-8 md:mt-10"
      >
        <!-- Slide 1: Pronuncia -->
        <div
          class="dict-slide is-active col-start-1 row-start-1 flex w-full flex-col items-center justify-center text-center"
          data-slide="0"
          aria-hidden="false"
        >
          <p class="font-typewriter mt-1 text-base sm:text-lg md:text-xl text-green/90 tracking-wide">
            {dictionaryEntry.phonetic} /{dictionaryEntry.category}.
          </p>
        </div>

        <!-- Slide 2: Traducción -->
        <div
          class="dict-slide col-start-1 row-start-1 flex w-full flex-col items-center justify-center text-center"
          data-slide="1"
          aria-hidden="true"
        >
          <p class="font-typewriter max-w-lg text-base sm:text-lg md:text-xl leading-relaxed text-green/90 tracking-wide">
            {dictionaryEntry.senses[0]}
          </p>
        </div>

        <!-- Slide 3: En este proyecto -->
        <div
          class="dict-slide col-start-1 row-start-1 flex w-full flex-col items-center justify-center text-center"
          data-slide="2"
          aria-hidden="true"
        >
          <p class="font-typewriter max-w-lg text-base sm:text-lg md:text-xl leading-relaxed text-green/90 tracking-wide">
            {dictionaryEntry.senses[1]}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .font-typewriter {
    font-family: "Courier New", Courier, ui-monospace, monospace;
  }

  .dict-slide {
    opacity: 0;
    filter: blur(8px);
    transform: translateY(4px);
    pointer-events: none;
    transition:
      opacity 420ms ease-out,
      filter 480ms ease-out,
      transform 480ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .dict-slide.is-active {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .dict-slide {
      transition: none;
      transform: none;
      filter: none;
    }
  }
</style>

<script>
  let cleanupSlides: (() => void) | undefined;
  let cleanupMorph: (() => void) | undefined;

  // 1. Alternancia automática con desenfoque / blur y pausa en hover
  const initDictionarySlides = () => {
    cleanupSlides?.();
    cleanupSlides = undefined;

    const card = document.querySelector<HTMLElement>("[data-dictionary-card]");
    if (!card) return;

    const slides = card.querySelectorAll<HTMLElement>("[data-slide]");
    if (slides.length < 2) return;

    let activeIndex = 0;
    const intervalMs = 2500; // El autor pidió entre 2 y 2,5 segundos entre slides
    let hovering = false;
    let deadline = 0;
    let timer = 0;
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const showSlide = (index: number) => {
      activeIndex = index;
      slides.forEach((slide, i) => {
        const isActive = i === activeIndex;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", (!isActive).toString());
      });
    };

    // El reloj sigue corriendo con el mouse encima: el cambio solo espera. Si el
    // tiempo se cumple mientras el visitante lee, no se interrumpe; cuando saca
    // el mouse, si el tiempo ya pasó, cambia de una.
    const schedule = () => {
      window.clearTimeout(timer);
      deadline = performance.now() + intervalMs;
      timer = window.setTimeout(() => {
        if (hovering) return;
        advance();
      }, intervalMs);
    };

    const advance = () => {
      showSlide((activeIndex + 1) % slides.length);
      schedule();
    };

    const onEnter = () => {
      hovering = true;
    };

    const onLeave = () => {
      hovering = false;
      if (!prefersReducedMotion && performance.now() >= deadline) advance();
    };

    card.addEventListener("mouseenter", onEnter);
    card.addEventListener("mouseleave", onLeave);

    cleanupSlides = () => {
      window.clearTimeout(timer);
      timer = 0;
      card.removeEventListener("mouseenter", onEnter);
      card.removeEventListener("mouseleave", onLeave);
    };

    if (!prefersReducedMotion) schedule();
  };

  // 2. Interpolación continua del logo: viaje desde el centro de la sección al navbar
  const initLogoMorph = () => {
    cleanupMorph?.();
    cleanupMorph = undefined;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    const placeholder = document.querySelector<HTMLImageElement>(
      "[data-dictionary-logo-placeholder]",
    );
    const headerLogo = document.querySelector<HTMLImageElement>(
      "[data-header-logo]",
    );
    const headerLogoLink = document.querySelector<HTMLAnchorElement>(
      "[data-header-logo-link]",
    );

    if (!placeholder || !headerLogo || !headerLogoLink) return;

    let heroDocLeft = 0;
    let heroDocTop = 0;
    let heroWidth = 0;
    let targetWidth = 0;
    let layoutWidth = 0;
    let scaleInicio = 1;
    let scaleFin = 1;
    let announcementH = 0;
    let headerStickyTopOffset = 0;
    let headerRestX = 0;
    let travelDistance = 1;
    let currentProgress = 0;
    let isAtRest = false;

    const measure = () => {
      const scrollY = window.scrollY;
      const linkRect = headerLogoLink.getBoundingClientRect();
      const placeholderRect = placeholder.getBoundingClientRect();

      heroDocLeft = placeholderRect.left + window.scrollX;
      heroDocTop = placeholderRect.top + scrollY;
      heroWidth = placeholder.offsetWidth || placeholderRect.width;

      // El logo que viaja ya no mide el ancho del navbar: su caja mide 620px (el
      // tamaño máximo que alcanza en el diccionario) y el navbar lo muestra
      // escalado hacia abajo. Así el navegador siempre achica y nunca agranda un
      // mapa de bits, que es lo que mantiene la nitidez en todo el recorrido
      // (medido: la energía de bordes a mitad del viaje caía un 33% cuando el
      // elemento medía 133px y se escalaba hacia arriba).
      layoutWidth = headerLogo.offsetWidth || 620;
      targetWidth = headerLogoLink.offsetWidth || linkRect.width;
      if (targetWidth <= 0 || heroWidth <= 0 || layoutWidth <= 0) return;

      scaleInicio = heroWidth / layoutWidth;
      scaleFin = targetWidth / layoutWidth;

      const announcementBar = document.querySelector<HTMLElement>(".announcement-bar");
      announcementH = announcementBar ? announcementBar.offsetHeight : 0;

      headerStickyTopOffset = linkRect.top - Math.max(0, announcementH - scrollY);
      headerRestX = linkRect.left;

      // La distancia de scroll hasta que el placeholder cruza el nivel del header
      travelDistance = Math.max(1, heroDocTop - (headerStickyTopOffset + announcementH));

      update();
    };

    const update = () => {
      const scrollY = window.scrollY;
      const currentAnnouncement = Math.max(0, announcementH - scrollY);
      const currentHeaderRestY = currentAnnouncement + headerStickyTopOffset;
      const currentHeroY = heroDocTop - scrollY;

      // Progreso de 0 (arriba de todo) a 1 (apoyado en el navbar)
      const rawProgress = scrollY / travelDistance;
      const progress = Math.min(1, Math.max(0, rawProgress));
      currentProgress = progress;

      if (progress >= 1) {
        if (!isAtRest) {
          headerLogo.style.transform = `translate(0px, 0px) scale(${scaleFin.toFixed(4)})`;
          headerLogo.style.willChange = "auto";
          isAtRest = true;
        }
        return;
      }

      isAtRest = false;

      // Interpolación directa y fluida (60/120 FPS sin reflow)
      const scale = scaleInicio + (scaleFin - scaleInicio) * progress;
      const targetX = heroDocLeft * (1 - progress) + headerRestX * progress;
      const targetY = currentHeroY * (1 - progress) + currentHeaderRestY * progress;

      const dx = targetX - headerRestX;
      const dy = targetY - currentHeaderRestY;

      headerLogo.style.transformOrigin = "0 0";
      // Transform 2D y sin `will-change`: con translate3d el navegador promueve el
      // logo a su propia capa, la rasteriza una vez y despues escala ese mapa de
      // bits, que es lo que lo hacia ver borroso mientras viajaba (medido: la
      // energia de bordes a mitad del viaje caia un 33%, de 7.97 a 5.36). En 2D y
      // sin promocion, el navegador repinta el SVG en cada frame a la escala real.
      headerLogo.style.transform = `translate(${dx.toFixed(2)}px, ${dy.toFixed(2)}px) scale(${scale.toFixed(4)})`;
    };

    // Ocultar el placeholder duplicado para que solo exista un único logo visible
    placeholder.style.opacity = "0";

    // Si hacen clic en el logo mientras aún está en el hero, no navegar a home
    const onLinkClick = (event: MouseEvent) => {
      if (currentProgress < 0.85) {
        event.preventDefault();
      }
    };
    headerLogoLink.addEventListener("click", onLinkClick);

    let scrollRaf = 0;
    const onScroll = () => {
      if (!scrollRaf) {
        scrollRaf = window.requestAnimationFrame(() => {
          scrollRaf = 0;
          update();
        });
      }
    };

    let resizeTimer = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(measure, 50);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });

    // Medir de inmediato y también al terminar de cargar tipografías / imágenes
    measure();
    if (!placeholder.complete) {
      placeholder.addEventListener("load", measure, { once: true });
    }
    document.fonts?.ready.then(measure).catch(() => {});

    cleanupMorph = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onResize);
      headerLogoLink.removeEventListener("click", onLinkClick);
      if (scrollRaf) window.cancelAnimationFrame(scrollRaf);
      window.clearTimeout(resizeTimer);

      // Se vuelve al transform por defecto de la hoja (escala del navbar), no a
      // "none": la imagen mide 620px de layout y sin escala se vería gigante.
      headerLogo.style.transform = `scale(${scaleFin.toFixed(4)})`;
      headerLogo.style.transformOrigin = "";
      headerLogo.style.willChange = "";
      placeholder.style.opacity = "";
    };
  };

  const initAll = () => {
    initDictionarySlides();
    initLogoMorph();
  };

  document.addEventListener("astro:page-load", initAll);
  document.addEventListener("astro:before-swap", () => {
    cleanupSlides?.();
    cleanupMorph?.();
  });
  initAll();
</script>
