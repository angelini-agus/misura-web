---
import Button from "./ui/Button.astro";

interface Props {
  eyebrow: string;
  title: string;
  label: string;
  href: string;
}

const { eyebrow, title, label, href } = Astro.props;
---

<section class="border-t border-green">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <div
      class="flex flex-col gap-6 rounded-md border border-green bg-green p-8 text-cream md:flex-row md:items-center md:justify-between md:p-12"
      data-reveal
    >
      <div class="max-w-xl">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-cream/60">
          {eyebrow}
        </p>
        <h2 class="font-display mt-3 text-2xl font-medium leading-tight sm:text-3xl">
          {title}
        </h2>
      </div>
      <Button variant="cream" href={href} class="shrink-0">
        {label}
        <span aria-hidden="true">→</span>
      </Button>
    </div>
  </div>
</section>
