---
import { headerCta, nav, site } from "../lib/content";
import MenuIcon from "./ui/MenuIcon.astro";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<a
  href="#contenido"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:border-2 focus:border-green focus:bg-cream focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
>
  Saltar al contenido
</a>
<div
  transition:name="site-announcement"
  class="announcement-bar bg-green text-center text-xs tracking-[0.2em] text-cream"
>
  <p class="px-4 py-2.5 uppercase">{site.announcement}</p>
</div>
<header
  transition:name="site-header"
  class="sticky top-0 z-50 border-b border-green bg-cream"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 md:px-6">
    {/* `draggable="false"` en el enlace y `select-text` en el wordmark, los dos
        juntos: el <a> es arrastrable por defecto, asi que al arrastrar sobre el
        logo el navegador iniciaba el arrastre del enlace en vez de la seleccion
        (medido: el evento `dragstart` disparaba con el <a> de target y no se
        seleccionaba nada). Con solo `draggable="false"` seguia sin seleccionar:
        el wordmark necesita ademas el `user-select: text` explicito porque esta
        adentro de un enlace. */}
    <a
      href="/"
      draggable="false"
      class="relative inline-flex h-8 w-[7.1875rem] items-center"
      data-header-logo-link
    >
      {/* El wordmark mide 620px de layout (los 11rem de `.wordmark-nav`, el
          mismo tope que alcanza en el hero de la home) y el navbar lo muestra
          achicado con el transform: el navegador nunca agranda nada, y la
          interpolacion del viaje se mide contra la caja del hero.

          La caja del enlace mide 115x32 y no los 133x32 de antes: con "bottega"
          en Lora la caja del texto tiene proporcion 628/176 = 3.57, asi que
          llenando los 32px de alto el ancho da 115. Con el ancho viejo el texto
          escalaba al ancho y su tinta medía 38px sobre una caja de 32 (medido),
          que es lo que lo hacia ver desproporcionado y desalineado hacia abajo.
          El transform por defecto deja el wordmark ya escalado, para que sin JS
          o con movimiento reducido el header se vea igual. */}
      {/* Sin `pointer-events-none`: el wordmark tiene que poder seleccionarse con
          el mouse tambien cuando esta en el navbar. Su caja interactiva es la
          transformada (115x32), no los 628px de layout, asi que no le tapa nada
          al nav ni al CTA. En la home, mientras manda el wordmark de la apertura,
          el script le pone `pointer-events: none` para que el arrastre llegue al
          grande. */}
      <span
        class="wordmark wordmark-nav select-text absolute left-0 top-0 origin-top-left [transform:scale(0.1815)]"
        data-header-logo
      >{site.name}</span>
    </a>
    <div class="flex items-center gap-5 md:gap-8">
      <nav class="hidden items-center gap-7 md:flex" aria-label="Navegación principal">
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={pathname === item.href ? "page" : undefined}
            class="nav-lift text-sm"
          >
            {item.label}
          </a>
        ))}
      </nav>
      <a
        href={headerCta.href}
        class="hidden items-center rounded-md border-2 border-green bg-green px-5 py-2.5 text-sm font-semibold tracking-wide text-cream transition hover:border-green-light hover:bg-green-light md:inline-flex active:translate-x-[-4px] active:translate-y-[4px] active:duration-75"
      >
        {headerCta.label}
      </a>
      <details class="md:hidden">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-green px-3 py-1.5 text-sm text-green transition-transform duration-150 ease-out [&::-webkit-details-marker]:hidden active:translate-x-[-4px] active:translate-y-[4px] active:duration-75">
          {site.menuLabel}
          <MenuIcon class="h-4 w-4" />
        </summary>
        <nav
          class="absolute inset-x-4 top-full z-50 mt-2 flex flex-col gap-4 rounded-md border border-green bg-cream p-4"
          aria-label="Navegación móvil"
        >
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
              class="nav-lift block py-2 text-sm"
            >
              {item.label}
            </a>
          ))}
          <a
            href={headerCta.href}
            class="mt-2 inline-flex items-center justify-center rounded-md border-2 border-green bg-green px-5 py-2.5 text-center text-sm font-semibold tracking-wide text-cream transition hover:border-green-light hover:bg-green-light active:translate-x-[-4px] active:translate-y-[4px] active:duration-75"
          >
            {headerCta.label}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* En celulares chicos y bajos la barra de anuncio se compacta: su altura es
     la que hace falta para que los dos CTAs del hero entren dentro de los
     primeros 100dvh. La condicion pide ancho de celular (hasta 30rem) Y alto
     bajo (hasta 620px), igual que el escalon mas agresivo del hero, asi que el
     desktop y los celulares altos no se tocan. */
  @media (max-width: 30rem) and (max-height: 620px) {
    .announcement-bar {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
    }

    .announcement-bar p {
      padding-top: 0.375rem;
      padding-bottom: 0.375rem;
    }
  }
</style>

<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    const openMenu = document.querySelector<HTMLDetailsElement>("header details[open]");
    if (openMenu && !openMenu.contains(event.target)) {
      openMenu.open = false;
    }
  });

  const initMobileMenu = () => {
    document.querySelectorAll<HTMLDetailsElement>("header details").forEach((details) => {
      if (details.dataset.menuReady === "true") return;
      details.dataset.menuReady = "true";

      details.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !details.open) return;
        details.open = false;
        details.querySelector("summary")?.focus();
      });

      details.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          details.open = false;
        });
      });
    });
  };

  // El logo llega viajando SOLO cuando el visitante viene de la apertura de la
  // home, que es el unico caso donde el wordmark grande esta a la vista y el logo
  // tiene que nacer de ahi. Si viene de otra pagina el bottega ya estaba en el
  // navbar, asi que animarlo seria inventar un viaje que nadie vio.
  // El estado del logo se lee ANTES del swap. El header se persiste entre
  // navegaciones, pero pierde el transform inline que le dejo el script del viaje,
  // asi que en `after-swap` el logo ya aparece en su lugar (medido: 114px) y no
  // queda nada de donde arrancar. Lo que se guarda es su posicion y su escala
  // relativas al enlace, que es lo que se vuelve a aplicar del otro lado.
  let partida: { dx: number; dy: number; escala: number } | null = null;
  document.addEventListener("astro:before-swap", () => {
    const logo = document.querySelector<HTMLElement>("[data-header-logo]");
    const link = document.querySelector<HTMLElement>("[data-header-logo-link]");
    if (!logo || !link || !logo.offsetWidth) {
      partida = null;
      return;
    }
    const r = logo.getBoundingClientRect();
    const lr = link.getBoundingClientRect();
    partida = { dx: r.x - lr.x, dy: r.y - lr.y, escala: r.width / logo.offsetWidth };
  });

  const animarLlegadaDelLogo = () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    // En la home el logo lo maneja el script de la apertura, que lo hace viajar
    // con el scroll: ahi esta funcion no corre.
    if (document.querySelector("[data-brand-wordmark]")) return;

    const estado = window as Window & { __bottegaEnApertura?: boolean };
    const veniaDeLaApertura = estado.__bottegaEnApertura === true;
    estado.__bottegaEnApertura = false;
    if (!veniaDeLaApertura) return;

    const logo = document.querySelector<HTMLElement>("[data-header-logo]");
    const link = document.querySelector<HTMLElement>("[data-header-logo-link]");
    if (!logo || !link) return;

    if (!partida) return;
    const inicio = partida;
    partida = null;

    const linkRect = link.getBoundingClientRect();
    const layoutWidth = logo.offsetWidth;
    if (!layoutWidth || !linkRect.width) return;

    const escalaFinal = linkRect.width / layoutWidth;

    logo.style.transformOrigin = "0 0";
    logo.style.transition = "none";
    logo.style.transform = `translate(${inicio.dx.toFixed(2)}px, ${inicio.dy.toFixed(2)}px) scale(${inicio.escala.toFixed(4)})`;

    // Fuerza el reflow para que la transicion arranque desde el estado de arriba
    // y no desde el que deja la hoja
    void logo.offsetWidth;

    logo.style.transition = "transform 450ms var(--ease-out)";
    logo.style.transform = `translate(0px, 0px) scale(${escalaFinal.toFixed(4)})`;

    // Al terminar se sueltan los estilos: el transform por defecto de la hoja ya
    // deja el logo en su lugar
    logo.addEventListener(
      "transitionend",
      () => {
        logo.style.transition = "";
        logo.style.transform = "";
        logo.style.transformOrigin = "";
      },
      { once: true },
    );
  };

  document.addEventListener("astro:page-load", initMobileMenu);
  // `astro:after-swap` y no `astro:page-load`: el swap del ClientRouter deja el
  // DOM nuevo en su lugar antes de pintarlo, y ahi todavia se puede dejar el
  // logo en su estado de partida sin que se vea. Medido con `page-load`: el logo
  // se pintaba ya en su lugar, saltaba al tamano grande y recien despues viajaba.
  document.addEventListener("astro:after-swap", animarLlegadaDelLogo);
  initMobileMenu();
</script>
