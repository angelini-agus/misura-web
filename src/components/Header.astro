---
import { headerCta, nav, site } from "../lib/content";
import MenuIcon from "./ui/MenuIcon.astro";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<a
  href="#contenido"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:border-2 focus:border-green focus:bg-cream focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
>
  Saltar al contenido
</a>
{pathname === "/" && (
  <div class="bg-green text-center text-xs tracking-[0.2em] text-cream">
    <p class="px-4 py-2.5 uppercase">{site.announcement}</p>
  </div>
)}
<header class="sticky top-0 z-50 border-b border-green bg-cream">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 md:px-6">
    <a href="/" class="inline-flex items-center">
      <img
        src="/misure-logo.svg"
        alt={site.name}
        class="h-8 w-auto"
      />
    </a>
    <div class="flex items-center gap-5 md:gap-8">
      <nav class="hidden items-center gap-7 md:flex" aria-label="Navegación principal">
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={pathname === item.href ? "page" : undefined}
            class={`border-b-2 ${
              pathname === item.href ? "border-green" : "border-transparent"
            } text-sm text-green underline-offset-4 hover:underline active:underline`}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <a
        href={headerCta.href}
        class="inline-flex items-center rounded-md border-2 border-green bg-green px-5 py-2.5 text-xs font-semibold tracking-wide text-cream transition-colors hover:bg-green-dark"
      >
        {headerCta.label}
      </a>
      <details class="md:hidden">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-green px-3 py-1.5 text-sm text-green transition-transform duration-150 ease-out active:scale-[0.97]">
          {site.menuLabel}
          <MenuIcon class="h-4 w-4" />
        </summary>
        <nav
          class="absolute inset-x-4 top-full z-50 mt-2 flex flex-col gap-4 rounded-md border border-green bg-cream p-4"
          aria-label="Navegación móvil"
        >
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
              class="text-sm text-green underline-offset-4 hover:underline active:underline"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
