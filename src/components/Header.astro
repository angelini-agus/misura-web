---
import { headerCta, nav, site } from "../lib/content";
import MenuIcon from "./ui/MenuIcon.astro";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<a
  href="#contenido"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:border-2 focus:border-green focus:bg-cream focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
>
  Saltar al contenido
</a>
<div
  transition:name="site-announcement"
  class="announcement-bar bg-green text-center text-xs tracking-[0.2em] text-cream"
>
  <p class="px-4 py-2.5 uppercase">{site.announcement}</p>
</div>
<header
  transition:name="site-header"
  class="sticky top-0 z-50 border-b border-green bg-cream"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 md:px-6">
    <a href="/" class="inline-flex items-center">
      <img
        src="/misure-logo.svg"
        alt={site.name}
        class="h-8 w-auto"
      />
    </a>
    <div class="flex items-center gap-5 md:gap-8">
      <nav class="hidden items-center gap-7 md:flex" aria-label="Navegación principal">
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={pathname === item.href ? "page" : undefined}
            class="link-ink inline-block text-sm text-green"
          >
            {item.label}
          </a>
        ))}
      </nav>
      <a
        href={headerCta.href}
        class="hidden items-center rounded-md border-2 border-green bg-green px-5 py-2.5 text-sm font-semibold tracking-wide text-cream transition hover:border-green-light hover:bg-green-light md:inline-flex active:translate-x-[-4px] active:translate-y-[4px] active:duration-75"
      >
        {headerCta.label}
      </a>
      <details class="md:hidden">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-green px-3 py-1.5 text-sm text-green transition-transform duration-150 ease-out [&::-webkit-details-marker]:hidden active:scale-[0.97]">
          {site.menuLabel}
          <MenuIcon class="h-4 w-4" />
        </summary>
        <nav
          class="absolute inset-x-4 top-full z-50 mt-2 flex flex-col gap-4 rounded-md border border-green bg-cream p-4"
          aria-label="Navegación móvil"
        >
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
              class="link-ink block py-2 text-sm text-green"
            >
              {item.label}
            </a>
          ))}
          <a
            href={headerCta.href}
            class="mt-2 inline-flex items-center justify-center rounded-md border-2 border-green bg-green px-5 py-2.5 text-center text-sm font-semibold tracking-wide text-cream transition hover:border-green-light hover:bg-green-light active:translate-x-[-4px] active:translate-y-[4px] active:duration-75"
          >
            {headerCta.label}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* En celulares chicos y bajos la barra de anuncio se compacta: su altura es
     la que hace falta para que los dos CTAs del hero entren dentro de los
     primeros 100dvh. La condicion pide ancho de celular (hasta 30rem) Y alto
     bajo (hasta 620px), igual que el escalon mas agresivo del hero, asi que el
     desktop y los celulares altos no se tocan. */
  @media (max-width: 30rem) and (max-height: 620px) {
    .announcement-bar {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
    }

    .announcement-bar p {
      padding-top: 0.375rem;
      padding-bottom: 0.375rem;
    }
  }
</style>

<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    const openMenu = document.querySelector<HTMLDetailsElement>("header details[open]");
    if (openMenu && !openMenu.contains(event.target)) {
      openMenu.open = false;
    }
  });

  const initMobileMenu = () => {
    document.querySelectorAll<HTMLDetailsElement>("header details").forEach((details) => {
      if (details.dataset.menuReady === "true") return;
      details.dataset.menuReady = "true";

      details.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !details.open) return;
        details.open = false;
        details.querySelector("summary")?.focus();
      });

      details.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          details.open = false;
        });
      });
    });
  };

  document.addEventListener("astro:page-load", initMobileMenu);
  initMobileMenu();
</script>
