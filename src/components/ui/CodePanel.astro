---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  class:list={["block h-auto w-full", className]}
  viewBox="0 0 900 700"
  role="img"
  aria-labelledby="code-panel-title code-panel-desc"
>
  <title id="code-panel-title">Líneas de código</title>
  <desc id="code-panel-desc">
    Ilustración plana en verde y crema: un panel con líneas de código abstraídas,
    números de línea y un cursor que titila.
  </desc>

  <rect x="50" y="50" width="800" height="600" fill="#F1E8DB" stroke="#0E3B33" stroke-width="5" />
  <rect x="50" y="50" width="800" height="60" fill="#0E3B33" />
  <circle cx="86" cy="80" r="9" fill="#F1E8DB" />
  <circle cx="118" cy="80" r="9" fill="#F1E8DB" />
  <circle cx="150" cy="80" r="9" fill="#F1E8DB" />

  <!-- Números de línea -->
  <g fill="#0E3B33">
    <rect class="cd-line" x="104" y="152" width="20" height="8" style="animation-delay: 60ms" />
    <rect class="cd-line" x="104" y="196" width="20" height="8" style="animation-delay: 110ms" />
    <rect class="cd-line" x="104" y="240" width="20" height="8" style="animation-delay: 160ms" />
    <rect class="cd-line" x="104" y="284" width="20" height="8" style="animation-delay: 210ms" />
    <rect class="cd-line" x="104" y="328" width="20" height="8" style="animation-delay: 260ms" />
    <rect class="cd-line" x="104" y="372" width="20" height="8" style="animation-delay: 310ms" />
    <rect class="cd-line" x="104" y="416" width="20" height="8" style="animation-delay: 360ms" />
    <rect class="cd-line" x="104" y="460" width="20" height="8" style="animation-delay: 410ms" />
    <rect class="cd-line" x="104" y="504" width="20" height="8" style="animation-delay: 460ms" />
    <rect class="cd-line" x="104" y="548" width="20" height="8" style="animation-delay: 510ms" />
  </g>

  <!-- Líneas sólidas -->
  <g fill="#0E3B33">
    <rect class="cd-line" x="160" y="146" width="180" height="20" style="animation-delay: 80ms" />
    <rect class="cd-line" x="200" y="234" width="140" height="20" style="animation-delay: 180ms" />
    <rect class="cd-line" x="160" y="278" width="300" height="20" style="animation-delay: 230ms" />
    <rect class="cd-line" x="240" y="366" width="120" height="20" style="animation-delay: 330ms" />
    <rect class="cd-line" x="160" y="410" width="260" height="20" style="animation-delay: 380ms" />
    <rect class="cd-line" x="160" y="454" width="100" height="20" style="animation-delay: 430ms" />
    <rect class="cd-line" x="160" y="542" width="160" height="20" style="animation-delay: 530ms" />
  </g>

  <!-- Líneas de contorno -->
  <g fill="none" stroke="#0E3B33" stroke-width="4">
    <rect class="cd-line" x="200" y="190" width="240" height="20" style="animation-delay: 130ms" />
    <rect class="cd-line" x="240" y="322" width="200" height="20" style="animation-delay: 280ms" />
    <rect class="cd-line" x="200" y="498" width="220" height="20" style="animation-delay: 480ms" />
  </g>

  <!-- Cursor -->
  <rect class="cd-cursor" x="332" y="538" width="14" height="28" fill="#0E3B33" style="animation-delay: 600ms" />
</svg>

<style>
  .cd-line {
    opacity: 0;
    transform: translateX(-10px);
    animation: cd-in 380ms cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

  .cd-cursor {
    animation: cd-blink 1.1s steps(1, end) infinite;
  }

  @keyframes cd-in {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes cd-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
</style>
