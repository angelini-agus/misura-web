---
interface Props {
  compact?: boolean;
  class?: string;
  style?: string;
}

const {
  compact = false,
  class: className = "",
  style = "",
} = Astro.props;
---

{/* La captura va a color natural: el duotono de `.foto-duotono` quedo solo para
    las fotos del equipo. Mostrar la captura tal como se ve es el punto (lo dice
    el comentario viejo del propio duotono: sirve para probar que el software
    funciona), y ademas el filtro dejaba a las capturas con el mismo gris. */}
<div
  class:list={[
    "screenshot-frame",
    compact && "screenshot-frame--compact",
    className,
  ]}
  style={style || undefined}
>
  <div class="screenshot-frame-bar" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <div class="screenshot-frame-shot">
    <slot />
  </div>
</div>
