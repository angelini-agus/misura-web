---
interface Props {
  compact?: boolean;
  /** Activa el modificador que muestra el color real al hacer hover. Es
      opcional porque el resto del sitio (home portfolio, galería de casos y
      equipo) quiere el duotono fijo: el revelado es opt-in por superficie. */
  hover?: boolean;
  class?: string;
}

const {
  compact = false,
  hover = false,
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "screenshot-frame",
    compact && "screenshot-frame--compact",
    className,
  ]}
>
  <div class="screenshot-frame-bar" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <div class="screenshot-frame-shot">
    <div class:list={["foto-duotono", hover && "foto-duotono--hover"]}>
      <slot />
    </div>
  </div>
</div>
