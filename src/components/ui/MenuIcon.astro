---
interface Props {
  class?: string;
}

const { class: className = "h-5 w-5" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  aria-hidden="true"
>
  <path d="M4 7h16" />
  <path d="M4 12h16" />
  <path d="M4 17h16" />
</svg>
