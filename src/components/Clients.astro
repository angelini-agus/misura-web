---
import { clients } from "../lib/content";
---

<section id="clientes" class="scroll-mt-24 border-t border-green">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <div class="max-w-xl" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.2em]">
        {clients.eyebrow}
      </p>
      <h2
        class="font-display mt-3 text-3xl font-medium leading-tight tracking-tight sm:text-4xl"
      >
        {clients.title}
      </h2>
      <p class="mt-4 leading-relaxed text-green/80">{clients.description}</p>
    </div>

    <div class="mt-12 grid gap-px border border-green md:grid-cols-3" data-reveal>
      {clients.metrics.map((metric) => (
        <div class="flex flex-col bg-green p-8 text-cream">
          <div class="flex items-baseline gap-2">
            <span class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
              {metric.value}
            </span>
            <span class="font-mono text-xs uppercase tracking-widest text-cream/60">
              {metric.unit}
            </span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-cream/75">{metric.label}</p>
        </div>
      ))}
    </div>

    <div class="mt-8" data-reveal>
      <a
        href={clients.cta.href}
        class="inline-flex items-center gap-2 rounded-md border-2 border-green bg-green px-6 py-3 text-sm font-semibold text-cream transition-colors duration-150 hover:bg-green-dark"
      >
        {clients.cta.label}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
