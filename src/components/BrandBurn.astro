---
// BrandBurn — el preload de la home: el estampado. La pantalla arranca cubierta
// por la tinta (verde bottega liso), ese plato baja hasta la cara del taco, el
// taco se levanta, golpea seco sobre el lino y se queda presionando mientras la
// tinta pasa a la fibra. Y se despega inclinándose como lo haría un artesano.
// Abajo queda impreso el wordmark de la marca.
//
// La tinta del plato es la MISMA de la impresión (`--color-green`, el verde del
// sitio): por eso el plato puede aterrizar sobre el taco sin que se vea una
// costura y por eso, al destaparse, la marca no cambia ni de color ni de lugar.
//
// La vista es cenital (primera persona): el taco es una tabla plana vista
// desde arriba y su altura se cuenta con dos cosas y nada más: la escala (1 abajo,
// 1,42 arriba) y la sombra, que pasa de ancha y difusa a pegada y dura. La madera
// es un rectángulo con los extremos chaflanados (los "bordes redondeados"), del
// verde de la marca calentado con un poco de lino, sin veta, sin nudos, sin
// catedral, sin bisel: el taco no se transforma en madera después del masazo.
//
// La impresión ES el wordmark del hero: mismas clases de la marca, mismo glifo,
// mismo tamaño, sin marco y sin filtros. El script solo la corre hasta la caja del
// wordmark, así que al destaparse la marca no se mueve un píxel.
//
// La escena tiene una sola paleta propia: lino #F2ECE1 (a tres puntos del crema
// del sitio) y la tinta, que es el verde de la marca. El plato que cubre la
// pantalla al arranque, el taco y la impresión son el mismo color.
//
// Secuencia, medidas y verificación: odd/tasks/brand-burn-intro.md

// El golpe cae a los 1.28s: es el momento que sincroniza el resto (el shake del
// lino, la salida del plato, la tinta que se asienta y el destape del taco).
// Todos esos tiempos viven en los animation-delay de la hoja de abajo, no en el
// script.
---

<div id="brand-burn" aria-hidden="true">
  <!-- El lienzo: una textura de fibra quieta, hecha con ruido, encima del crema -->
  <svg class="lino" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <filter id="lino-fibra" x="0" y="0" width="100%" height="100%">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.012 0.42"
        numOctaves="3"
        seed="5"
        result="hebra"
      />
      <feColorMatrix
        in="hebra"
        type="matrix"
        values="0 0 0 0 0.32
                0 0 0 0 0.30
                0 0 0 0 0.24
                0 0 0 0.5 0"
      />
    </filter>
    <rect width="100%" height="100%" filter="url(#lino-fibra)" />
  </svg>

  <!-- Todo lo que tiembla con el golpe: el lienzo, la tinta y el taco -->
  <div class="golpe">
    <!-- La impresión, abajo del taco. El script la planta en la caja del wordmark
         del hero para que el destape caiga donde después va la marca. -->
    <!-- La impresión: el wordmark de siempre, con las clases de la marca (mismo
         glifo, mismo peso, mismo clamp de tamaño que el hero) y sin un solo efecto.
         El script solo la planta en la caja del wordmark del hero, así que el
         destape cae exactamente donde después vive la marca. -->
    <div class="tinta" data-tinta>
      <span class="wordmark wordmark-hero">bottega</span>
    </div>

    <!-- El taco: una tabla plana vista desde arriba (referencia del autor: un
         listón de madera, sin corteza, sin mango, sin veta, sin nudos). La forma
         es un rectángulo con los extremos chaflanados (no hay `A` en el `d`, así
         que el script puede leer el contorno como una lista de pares) y la cara es
         plana: un solo `rect` del verde de la marca calentado con un poco de lino.
         Sin corteza, sin mango, sin anillos, sin filtros, sin texturas. El primer
         pintado se paga una sola vez.
         El plato de tinta copia este contorno: el script lee el `d` del `clipPath`
         y arma con él su `clip-path`, así que la tinta aterriza sobre la madera y
         no sobre una caja. -->
    <div class="taco" data-taco>
      <svg
        class="taco-madera"
        viewBox="0 0 1000 338"
        preserveAspectRatio="none"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <clipPath id="taco-corte">
            <path
              d="M 18 0 L 982 0 L 1000 18 L 1000 320 L 984 338 L 18 338 L 0 320 L 0 16 Z"
            />
          </clipPath>
        </defs>
        <g clip-path="url(#taco-corte)">
          <!-- La cara, plana: la base es el verde de la marca calentado con un
               poco de lino. Sin veta, sin nudos, sin catedral, sin vetas oscuras. -->
          <rect class="taco-cara" width="1000" height="338" />
        </g>
      </svg>
    </div>

    <!-- La masa de tinta: arranca cubriendo la ventana entera y baja hasta la cara
         del taco. Es lo primero que se ve de la home. -->
    <div class="masa" data-masa></div>
  </div>
</div>

<style>
  :root {
    --lino: #f2ece1;
    /* La tinta no tiene tono propio a propósito: es el verde de la marca, el
       mismo que hereda el wordmark de la impresión y el mismo que después vive
       en el hero. El plato que cubre la pantalla al arranque, el taco y la
       impresión son entonces el MISMO color: por eso el plato puede aterrizar
       sobre la cara del taco sin que se vea una costura y por eso el masazo no
       tiene que cambiar ningún color. */
    --tinta: var(--color-green);
    /* Las duraciones de la ceremonia. Viven en variables por un solo motivo: la
       regla global de movimiento reducido de `global.css` (`* {
       animation-duration: .01ms !important }`) también alcanza a la ceremonia
       forzada por `?burn=1` y la colapsa a un cuadro, así que el camino forzado
       tiene que reponerlas y no queremos las duraciones escritas dos veces. */
    --burn-total: 3000ms;
    --burn-golpe: 190ms;
    --burn-retiro: 420ms;
    /* Las sombras son de la tinta, nunca grises: lo único que cambia es el
       alpha. */
    --tinta-0: color-mix(in srgb, var(--tinta) 0%, transparent);
    --tinta-10: color-mix(in srgb, var(--tinta) 10%, transparent);
    --tinta-22: color-mix(in srgb, var(--tinta) 22%, transparent);
    --tinta-34: color-mix(in srgb, var(--tinta) 34%, transparent);
    --tinta-38: color-mix(in srgb, var(--tinta) 38%, transparent);
    --tinta-50: color-mix(in srgb, var(--tinta) 50%, transparent);
  }

  /* La ceremonia entera vive en este bloque. El overlay no existe hasta que el
     <head> pone `has-burn` en el <html>: así la segunda visita no muestra ni un
     frame de lino. */
  #brand-burn {
    display: none;
  }

  :root.has-burn #brand-burn {
    display: block;
  }

  #brand-burn {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--lino);
    overflow: hidden;
  }

  /* El lienzo: la fibra quieta, apenas marcada, con multiply para que no lave */
  .lino {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.2;
    mix-blend-mode: multiply;
  }

  .golpe {
    position: absolute;
    inset: 0;
    animation: golpe-lino var(--burn-golpe) cubic-bezier(0.3, 0, 0.4, 1) both;
    animation-delay: 1280ms;
  }

  /* El golpe del mazo sobre el taco: un sacudón seco de 1.5px y se asienta */
  @keyframes golpe-lino {
    0% {
      transform: translate(0, 0);
    }
    16% {
      transform: translate(1.5px, -1px);
    }
    42% {
      transform: translate(-1.2px, 1.5px);
    }
    68% {
      transform: translate(0.6px, -0.4px);
    }
    100% {
      transform: translate(0, 0);
    }
  }

  /* ── La tinta impresa ────────────────────────────────────────────────────── */

  /* La impresión no tiene animación propia: la descubre el taco al despegarse */
  .tinta {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
  }

  /* ── El plato de tinta ───────────────────────────────────────────────────── */

  /* La tinta, al arranque, cubre la ventana entera: el primer pintado de la home
     es verde bottega liso y ahí no se ve nada más. Después el plato baja hasta
     las cuatro medidas de la caja del taco, que el script escribe como custom
     properties, y se queda pegado a su cara.

     El taco está abajo, a escala 1, esperando debajo del plato: por eso la
     contracción puede ser un `clip-path` sobre la caja exacta del taco y no hay
     ni un píxel que ajustar cuando la tinta aterriza. */
  .masa {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--tinta);
    /* `contain: paint` acota el repintado de la contracción (el plato se recorta
       con un `path()` que se mueve cuadro a cuadro). */
    contain: paint;
    border-radius: 3px;
    /* El pivote lo escribe el script: es el mismo punto físico que el
       `transform-origin` del taco (18% 88% de su caja), medido en el espacio de
       la ventana. Así la carga y el masazo escalan las dos piezas como si fueran
       una sola. */
    will-change: clip-path, opacity, transform;
    animation: masa-plato var(--burn-total) both;
  }

  /* 0 → 450ms      verde pleno: la ventana entera es tinta y no pasa nada
     450 → 850ms    la contracción: el plato baja hasta el contorno del taco
     850 → 1150ms   la pausa: la tinta ya está sobre la madera y no pasa nada más
     1150 → 1280ms  la carga, en sincronía con el taco que se levanta
     1280 → 1400ms  el masazo: la tinta deja la cara del taco y pasa a la fibra
                    (el mismo cuadro en el que el taco toca el lino)

     El recorte no es un rectángulo: son dos `path()` con el MISMO contorno del
     tronco (el `d` del `clipPath` del taco, leído y reescalado por el script), así
     que la tinta aterriza sobre la madera y la pausa la muestra pegada a su forma.
     Uno está escalado para tapar la ventana (el arranque) y el otro es el contorno
     en su tamaño: entre los dos, el plato se contrae y se vuelve tronco.

     La escala del plato tiene un cuadro propio en la pausa (38.3%) aunque valga
     lo mismo que el anterior: si no estuviera, el tramo 28.3% → 42.7% interpola la
     escala de una sola vez y el plato empezaría a crecer durante la pausa, cuando
     el taco todavía está abajo. Se vería un canto verde afuera del bloque.

     La opacidad se declara en cada cuadro a propósito: es la trampa del cuadro
     implícito que ya nos comió tres veces en esta escena. */
  @keyframes masa-plato {
    0% {
      clip-path: var(--masa-cubre);
      opacity: 1;
      transform: scale(1);
    }
    15% {
      clip-path: var(--masa-cubre);
      opacity: 1;
      transform: scale(1);
      animation-timing-function: cubic-bezier(0.35, 0, 0.2, 1);
    }
    28.3% {
      clip-path: var(--masa-forma);
      opacity: 1;
      transform: scale(1);
    }
    38.3% {
      clip-path: var(--masa-forma);
      opacity: 1;
      transform: scale(1);
      animation-timing-function: cubic-bezier(0.4, 0, 0.7, 0.6);
    }
    42.7% {
      clip-path: var(--masa-forma);
      opacity: 1;
      transform: scale(1.42);
      animation-timing-function: cubic-bezier(0.55, 0, 0.9, 0.7);
    }
    46.7% {
      clip-path: var(--masa-forma);
      opacity: 0;
      transform: scale(1);
    }
    100% {
      clip-path: var(--masa-forma);
      opacity: 0;
      transform: scale(1);
    }
  }

  /* ── El taco: una pieza de madera ───────────────────────────────────────── */

  .taco {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    /* Sin fondo propio: la madera la pinta el SVG, que tiene el contorno del
       tronco. El rectángulo no existe en ninguna parte, así que la sombra es un
       `drop-shadow` (sigue el contorno) y no un `box-shadow` (seguiría la caja). */
    will-change: transform, filter, opacity;
    filter: drop-shadow(0 0 0 var(--tinta-0)) drop-shadow(0 0 0 var(--tinta-0))
      blur(0px);
    animation: taco-golpe var(--burn-total) both;
  }

  .taco-madera {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* La cara: plana, del mismo verde de la marca que el plato y la impresión
     (una sola tinta: la pieza no se aclara después del masazo, siempre es
     el mismo verde). */
  .taco-cara {
    fill: var(--tinta);
  }




  /* Los tramos, con su curva cada uno:
     0 → 0.85s   abajo, a escala 1, esperando debajo del plato de tinta
     0.85 → 1.15 la pausa: el plato ya está sobre la cara y no pasa nada más
     1.15 → 1.28 se levanta (1 → 1,42): la carga, con la sombra que se abre
     1.28 → 1.4  el masazo (1,42 → 1) en 120ms, con curva de impacto seco
     1.4 → 1.85  presiona contra el lino (1 → 0,995), sin rebotar
     1.85 → 2.33 se despega inclinándose, todavía SÓLIDO
     2.33 → 2.55 se disuelve y se va; el lino queda con la impresión
     2.55 → 3.0  ya no está

     La pausa de la 0,85 a la 1,15 es la que pidió el autor: la contracción llega
     a la cara del taco y la escena se queda quieta un cachito antes del masazo.
     Es el único tramo en el que no se mueve nada, y es lo que hace que el golpe
     se sienta como un golpe.

     El despegue se sostiene opaco hasta los 2,33s a propósito: con el taco del
     MISMO verde que la impresión, un desvanecido temprano se lee como un velo
     lechoso sobre la marca (un gris verdoso translúcido, que además no es de la
     paleta) en vez de un bloque que se levanta. Sólido casi hasta el final y
     disuelto en los últimos 215ms, que es el cuadro que el ojo lee como "el
     bloque se fue": lo que queda es la marca.

     La sombra arranca en cero porque durante el primer segundo el taco vive
     debajo del plato y no se ve. Y la opacidad Y el filtro se declaran en CADA
     cuadro hasta el despegue a propósito: si solo aparecen al principio y al
     final, Chrome interpola entre esos dos y el taco se desvanece y se desenfoca
     en rampa desde el arranque (se veía la impresión a través del bloque). Es la
     trampa del cuadro implícito, que en esta escena ya nos comió tres veces.

     La lista de transformaciones es la misma en todos los cuadros (perspectiva,
     los dos ejes, escala y traslación) aunque al principio valga la identidad: si
     una lista no coincide con la de al lado, Chrome interpola matrices y la
     perspectiva entra en la cuenta. */
  @keyframes taco-golpe {
    0% {
      opacity: 1;
      filter: drop-shadow(0 0 0 var(--tinta-0))
        drop-shadow(0 0 0 var(--tinta-0)) blur(0px);
      transform: perspective(900px) rotateX(0deg) rotateY(0deg) scale(1)
        translate(0px, 0px);
    }
    38.3% {
      opacity: 1;
      filter: drop-shadow(0 0 0 var(--tinta-0))
        drop-shadow(0 0 0 var(--tinta-0)) blur(0px);
      transform: perspective(900px) rotateX(0deg) rotateY(0deg) scale(1)
        translate(0px, 0px);
      animation-timing-function: cubic-bezier(0.4, 0, 0.7, 0.6);
    }
    42.7% {
      opacity: 1;
      filter: drop-shadow(0 52px 80px var(--tinta-38))
        drop-shadow(0 12px 26px var(--tinta-22)) blur(0px);
      transform: perspective(900px) rotateX(0deg) rotateY(0deg) scale(1.42)
        translate(0px, 0px);
      animation-timing-function: cubic-bezier(0.55, 0, 0.9, 0.7);
    }
    46.7% {
      opacity: 1;
      filter: drop-shadow(0 2px 3px var(--tinta-50))
        drop-shadow(0 0 0 var(--tinta-0)) blur(0px);
      transform: perspective(900px) rotateX(0deg) rotateY(0deg) scale(1)
        translate(0px, 0px);
      animation-timing-function: cubic-bezier(0.2, 0, 0.2, 1);
    }
    61.7% {
      opacity: 1;
      filter: drop-shadow(0 2px 3px var(--tinta-50))
        drop-shadow(0 0 0 var(--tinta-0)) blur(0px);
      transform: perspective(900px) rotateX(0deg) rotateY(0deg) scale(0.995)
        translate(0px, 0px);
      animation-timing-function: cubic-bezier(0.5, 0, 0.5, 1);
    }
    77.7% {
      opacity: 1;
      filter: drop-shadow(0 26px 44px var(--tinta-22))
        drop-shadow(0 4px 10px var(--tinta-10)) blur(1px);
      transform: perspective(900px) rotateX(5deg) rotateY(-7.5deg) scale(1.18)
        translate(-9%, -3.5%);
      animation-timing-function: cubic-bezier(0.45, 0, 0.7, 1);
    }
    85% {
      opacity: 0;
      filter: drop-shadow(0 18px 30px var(--tinta-10))
        drop-shadow(0 0 0 var(--tinta-0)) blur(6px);
      transform: perspective(900px) rotateX(9deg) rotateY(-6deg) scale(1.24)
        translate(-30%, -15%);
    }
    100% {
      opacity: 0;
      filter: drop-shadow(0 18px 30px var(--tinta-10))
        drop-shadow(0 0 0 var(--tinta-0)) blur(6px);
      transform: perspective(900px) rotateX(9deg) rotateY(-6deg) scale(1.24)
        translate(-30%, -15%);
    }
  }

  /* El retiro: la hoja se enrolla hacia arriba y deja a la vista el hero, con la
     marca ya en su lugar. `clip-path` y no `opacity`: el lino se descubre. */
  :root.has-burn #brand-burn.is-running {
    animation: retirar var(--burn-retiro) cubic-bezier(0.62, 0, 0.34, 1) both;
    animation-delay: 2600ms;
  }

  @keyframes retirar {
    from {
      clip-path: inset(0 0 0 0);
    }
    to {
      clip-path: inset(0 0 100% 0);
    }
  }

  /* El corte por movimiento reducido no cuenta cuando la ceremonia viene forzada
     por `?burn=1`: esa es la herramienta del autor para revisarla. */
  @media (prefers-reduced-motion: reduce) {
    :root.has-burn:not([data-burn-forzado]) #brand-burn,
    :root.has-burn:not([data-burn-forzado]) #brand-burn.is-running,
    :root:not([data-burn-forzado]) .golpe,
    :root:not([data-burn-forzado]) .taco,
    :root:not([data-burn-forzado]) .masa,
    :root:not([data-burn-forzado]) .tinta {
      animation: none !important;
    }
    /* Sin movimiento, la marca está donde va y no hay ceremonia que ver */
    :root.has-burn:not([data-burn-forzado]) #brand-burn {
      display: none;
    }

    /* La ceremonia forzada corre a velocidad real. Hay que decirlo acá porque el
       `!important` de global.css pisa a TODA animación de la página, incluida
       esta: dos `!important` los desempata la especificidad, y estos selectores
       son bastante más específicos que un `*`. Sin esto, el autor que revisa con
       movimiento reducido (el caso más común en Windows) ve la ceremonia entera
       pasar en un cuadro y el overlay retirarse solo. */
    :root[data-burn-forzado] .taco,
    :root[data-burn-forzado] .masa {
      animation-duration: var(--burn-total) !important;
    }

    :root[data-burn-forzado] .golpe {
      animation-duration: var(--burn-golpe) !important;
    }

    :root[data-burn-forzado] #brand-burn.is-running {
      animation-duration: var(--burn-retiro) !important;
    }
  }
</style>

<script>
  const CLAVE_SESION = "bottega-burn";
  const DURACION = 3200;

  const raiz = document.documentElement;
  const overlay = document.getElementById("brand-burn");
  // `?burn=lento` corre la ceremonia a un tercio de velocidad, para revisarla sin
  // perderse el golpe (120ms) ni el despegue. Es solo para el autor.
  const RITMO_REVISION = 0.3;

  if (overlay && raiz.classList.contains("has-burn")) {
    const forzado = raiz.dataset.burnForzado === "1";
    // Una recarga a mitad de página no es una entrada: el preload sobra. Con
    // `?burn=1` no se pregunta nada, que es para lo que existe el forzado.
    if (!forzado && window.scrollY > 2) {
      raiz.classList.remove("has-burn");
    } else {
      const tinta = overlay.querySelector<HTMLElement>("[data-tinta]");
      const taco = overlay.querySelector<HTMLElement>("[data-taco]");
      const masa = overlay.querySelector<HTMLElement>("[data-masa]");
      // El contorno de la madera: el plato de tinta lo copia (ver `aForma`).
      const corte = overlay.querySelector<SVGPathElement>("#taco-corte path");
      const marca = document.querySelector<HTMLElement>("[data-brand-wordmark]");

      if (!tinta || !taco || !masa || !corte || !marca) {
        raiz.classList.remove("has-burn");
      } else {
        // Posición en el documento por suma de offsetTop/offsetLeft: es inmune a
        // las transformaciones de entrada de `data-reveal`.
        const cajaDe = (nodo: HTMLElement) => {
          let x = 0;
          let y = 0;
          let actual: HTMLElement | null = nodo;
          while (actual) {
            x += actual.offsetLeft;
            y += actual.offsetTop;
            actual = actual.offsetParent as HTMLElement | null;
          }
          return { x, y, ancho: nodo.offsetWidth, alto: nodo.offsetHeight };
        };

        // La impresión ES el wordmark del hero: mismas clases, mismo glifo, mismo
        // tamaño. El script solo la corre hasta su caja, así que el destape cae
        // exactamente donde después vive la marca. El taco la cubre con 30px de
        // margen por lado (que el golpe tape el logo es parte del pedido).
        const plantar = () => {
          const caja = cajaDe(marca);
          const anchoTinta = caja.ancho;
          const altoTinta = caja.alto;
          const centroX = caja.x + caja.ancho / 2;
          const centroY = caja.y + caja.alto / 2;

          tinta.style.transform = `translate(${centroX - anchoTinta / 2}px, ${centroY - altoTinta / 2}px)`;

          const anchoTaco = anchoTinta + 60;
          const altoTaco = altoTinta + 60;
          taco.style.width = `${anchoTaco}px`;
          taco.style.height = `${altoTaco}px`;
          const izquierdaTaco = centroX - anchoTaco / 2;
          const arribaTaco = centroY - altoTaco / 2;
          taco.style.left = `${izquierdaTaco}px`;
          taco.style.top = `${arribaTaco}px`;
          // El despegue pivotea en la esquina de abajo a la izquierda: el taco se
          // levanta desde un borde, como se despega un bloque de madera.
          taco.style.transformOrigin = "18% 88%";

          // El plato de tinta tiene que aterrizar sobre el CONTORNO del taco y no
          // sobre su caja, así que su recorte se arma con el mismo `d` que dibuja
          // la madera. El camino tiene un solo subcamino de líneas rectas (M, L, Z),
          // así que se lee como pares de números en el espacio del viewBox.
          const numeros = corte?.getAttribute("d")?.match(/-?\d+(?:\.\d+)?/g);
          const forma = numeros ? numeros.map(Number) : [];
          const anchoVentana = document.documentElement.clientWidth;
          const altoVentana = document.documentElement.clientHeight;

          // El mismo contorno en píxeles, en el espacio del plato (que es la ventana
          // entera: el overlay es `fixed; inset: 0`). Con `escala` 1 cae en la caja
          // del taco; con la de cobertura, escalado sobre su propio centro, la
          // ventana queda tapada y el primer pintado es verde liso.
          const aForma = (escala: number) => {
            const puntos: string[] = [];
            for (let i = 0; i < forma.length; i += 2) {
              const x = izquierdaTaco + (forma[i] / 1000) * anchoTaco;
              const y = arribaTaco + (forma[i + 1] / 338) * altoTaco;
              puntos.push(
                `${(centroX + (x - centroX) * escala).toFixed(1)} ${(
                  centroY +
                  (y - centroY) * escala
                ).toFixed(1)}`,
              );
            }
            return `path("M ${puntos.join(" L ")} Z")`;
          };
          const cobertura =
            Math.max(
              (centroX * 2) / anchoTaco,
              ((anchoVentana - centroX) * 2) / anchoTaco,
              (centroY * 2) / altoTaco,
              ((altoVentana - centroY) * 2) / altoTaco,
            ) + 0.02;
          masa.style.setProperty("--masa-forma", aForma(1));
          masa.style.setProperty("--masa-cubre", aForma(cobertura));
          // El mismo pivote físico que el `18% 88%` del taco, medido en la
          // ventana: así la carga y el masazo escalan las dos piezas juntas.
          masa.style.transformOrigin = `${
            izquierdaTaco + anchoTaco * 0.18
          }px ${arribaTaco + altoTaco * 0.88}px`;
        };

        const terminar = () => {
          raiz.classList.remove("has-burn");
          raiz.style.overflow = "";
          // Con el forzado no se marca la sesión: así se puede repetir cuantas
          // veces haga falta sin cerrar la pestaña.
          if (!forzado) {
            try {
              sessionStorage.setItem(CLAVE_SESION, "1");
            } catch {
              /* modo privado: el preload se repetirá, es lo menos malo */
            }
          }
        };

        const arrancar = () => {
          plantar();
          raiz.style.overflow = "hidden";
          overlay.classList.add("is-running");
          const ritmo =
            new URLSearchParams(window.location.search).get("burn") === "lento"
              ? RITMO_REVISION
              : 1;
          if (ritmo !== 1) {
            window.requestAnimationFrame(() => {
              document.getAnimations().forEach((animacion) => {
                animacion.updatePlaybackRate(ritmo);
              });
            });
          }
          overlay.addEventListener("animationend", (evento) => {
            if ((evento as AnimationEvent).animationName === "retirar") {
              terminar();
            }
          });
          // Red de seguridad: si el evento de animación no llega (pestaña de fondo,
          // preferencia cambiada a mitad de camino), el overlay se saca igual.
          window.setTimeout(terminar, DURACION / ritmo + 500);
        };

        // La impresión tiene que estar en Lora antes de que el taco golpee: si la
        // fuente tarda, arranca igual a los 300ms.
        const fuenteALista = Promise.race([
          document.fonts ? document.fonts.ready : Promise.resolve(),
          new Promise((listo) => window.setTimeout(listo, 300)),
        ]);
        fuenteALista.then(() => {
          window.requestAnimationFrame(() =>
            window.requestAnimationFrame(arrancar),
          );
        });
      }
    }
  }
</script>
