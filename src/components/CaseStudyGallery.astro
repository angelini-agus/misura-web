---
// Galería de un caso: una captura por vista, en un carrusel que se corre de
// costado (scroll nativo con snap: anda con el dedo, con el trackpad, con las
// flechas y arrastrando con el mouse). Al tocar la captura se abre el visor a
// pantalla completa sobre el fondo difuminado, donde se ven todas una por una.
//
// Por qué scroll nativo y no un carrusel de clases: mover las fotos no depende
// de ningún handler de click. El navegador se encarga del desplazamiento, del
// swipe y del snap, y el JS solo sincroniza las flechas, el contador y el visor.
import { Image } from "astro:assets";
import type { CaseStudyCover } from "../lib/types";
import ScreenshotFrame from "./ui/ScreenshotFrame.astro";

interface Props {
  images?: CaseStudyCover[];
  label?: string;
  class?: string;
}

const {
  images = [],
  label = "Galería del proyecto",
  class: className = "",
} = Astro.props;
const total = images.length;
---

{
  total > 0 && (
    <section
      class:list={["case-gallery border-t border-green", className]}
      data-gallery
      aria-label={label}
    >
      <div class="case-gallery__inner">
        <div class="case-gallery__viewport">
          <div class="case-gallery__track" data-gallery-track>
            {images.map((image, index) => (
              <div class="case-gallery__slide" data-gallery-slide>
                <button
                  type="button"
                  data-gallery-open={index}
                  aria-label={`Ampliar: ${image.alt}`}
                  class="group case-gallery__btn"
                >
                  <ScreenshotFrame class="case-gallery__frame">
                    <Image
                      src={image.src}
                      alt={image.alt}
                      /* Hasta 1920: en pantallas retina la captura ocupa 1104
                         puntos CSS, o sea 2208 reales, y con la variante tope
                         de 1200 quedaba al 54%. */
                      widths={[480, 800, 1200, 1920]}
                      sizes="(min-width: 768px) 72vw, 100vw"
                      class="case-gallery__img"
                      loading={index === 0 ? "eager" : "lazy"}
                      draggable="false"
                    />
                  </ScreenshotFrame>
                  <span class="gallery-cta" aria-hidden="true">Ampliar</span>
                </button>
              </div>
            ))}
          </div>

          {total > 1 && (
            <>
              <button
                type="button"
                data-gallery-prev
                aria-label="Foto anterior"
                class="case-gallery__nav case-gallery__nav--prev"
              >
                <span aria-hidden="true">←</span>
              </button>
              <button
                type="button"
                data-gallery-next
                aria-label="Foto siguiente"
                class="case-gallery__nav case-gallery__nav--next"
              >
                <span aria-hidden="true">→</span>
              </button>
            </>
          )}
        </div>

        {total > 1 && (
          <p
            class="case-gallery__counter"
            data-gallery-counter
            aria-live="polite"
          >
            {`01 / ${String(total).padStart(2, "0")}`}
          </p>
        )}
      </div>
    </section>
  )
}

{
  total > 1 && (
    <dialog
      data-lightbox
      class="lightbox"
      aria-label={`Capturas ampliadas: ${label}`}
    >
      <div class="lightbox__inner">
        {images.map((image) => (
          <figure class="lightbox__slide" data-lightbox-slide>
            <figcaption class="lightbox__caption">{image.alt}</figcaption>
            <Image
              src={image.src}
              alt={image.alt}
              widths={[1200, 1920]}
              sizes="min(96vw, 110rem)"
              class="lightbox__img"
              loading="lazy"
            />
          </figure>
        ))}

        <div class="lightbox__bar" data-lightbox-bar>
          <button
            type="button"
            data-lightbox-prev
            aria-label="Foto anterior"
            class="lightbox__nav"
          >
            <span aria-hidden="true">←</span>
          </button>
          <p class="lightbox__counter" data-lightbox-counter aria-live="polite">
            {`01 / ${String(total).padStart(2, "0")}`}
          </p>
          <button
            type="button"
            data-lightbox-next
            aria-label="Foto siguiente"
            class="lightbox__nav"
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <button
          type="button"
          data-lightbox-close
          aria-label="Cerrar"
          class="lightbox__nav lightbox__close"
        >
          <span aria-hidden="true">✕</span>
        </button>
      </div>
    </dialog>
  )
}

<style>
  /* La sección no fija alto propio: en la ficha del caso ocupa lo que sobra
     entre el título y las tecnologías (ver `.case-hero`), y si se usa suelta se
     queda con el alto de la captura. */
  .case-gallery__inner {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-block: var(--gallery-pad-y, 1.5rem);
    margin-inline: auto;
    max-width: 72rem;
    padding-inline: 1rem;
  }

  @media (min-width: 48rem) {
    .case-gallery__inner {
      padding-inline: 1.5rem;
    }
  }

  .case-gallery__viewport {
    position: relative;
    display: flex;
    width: 100%;
    min-height: 0;
    flex: 1;
    align-items: center;
    justify-content: center;
  }

  /* Carrusel: scroll nativo horizontal con snap, una captura por vista. La
     barra de scroll se oculta porque la posición la dice el contador. */
  .case-gallery__track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    /* Sin esto el arrastre con el mouse arranca el drag nativo de la imagen
       (el fantasma) en vez de correr el carrusel. */
    user-select: none;
  }

  .case-gallery__track::-webkit-scrollbar {
    display: none;
  }

  .case-gallery__slide {
    display: flex;
    flex: 0 0 100%;
    min-height: 0;
    align-items: stretch;
    justify-content: center;
    scroll-snap-align: center;
  }

  /* La captura se centra y puede encogerse: el botón mide lo que mide la vista
     del carrusel y el marco se queda con ese alto menos su barra. */
  .case-gallery__btn {
    display: flex;
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: zoom-in;
  }

  /* El marco de la captura tiene que poder encogerse: la barra de arriba mide
     fijo y la captura se queda con el alto que sobra. */
  :global(.case-gallery__frame) {
    display: flex;
    max-height: 100%;
    max-width: 100%;
    flex-direction: column;
    min-height: 0;
  }

  :global(.case-gallery__frame .screenshot-frame-shot) {
    display: flex;
    min-height: 0;
    align-items: center;
    justify-content: center;
  }

  :global(.case-gallery__img) {
    display: block;
    width: auto;
    height: auto;
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    -webkit-user-drag: none;
  }

  /* Aviso de "Ampliar": aparece al pasar el mouse o al enfocar, y en pantallas
     sin hover queda a la vista, porque si no la captura no dice que se toca. */
  .gallery-cta {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background-color: var(--color-green);
    color: var(--color-cream);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  .case-gallery__btn {
    position: relative;
  }

  .group:hover .gallery-cta,
  .group:focus-visible .gallery-cta {
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: none) {
    .gallery-cta {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-cta {
      transition: none;
    }
  }

  .case-gallery__nav {
    position: absolute;
    top: 50%;
    display: none;
    height: 2.75rem;
    width: 2.75rem;
    translate: 0 -50%;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-green);
    border-radius: 999px;
    background-color: var(--color-cream);
    color: var(--color-green);
    font-size: 1.125rem;
    transition:
      background-color 150ms var(--ease-out),
      color 150ms var(--ease-out);
  }

  /* Las flechas son solo para mouse: en táctil el carrusel se corre con el dedo. */
  @media (hover: hover) and (pointer: fine) {
    .case-gallery__nav {
      display: flex;
    }
  }

  .case-gallery__nav:hover {
    background-color: var(--color-green);
    color: var(--color-cream);
  }

  .case-gallery__nav--prev {
    left: 0;
  }

  .case-gallery__nav--next {
    right: 0;
  }

  .case-gallery__counter {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-green) 70%, transparent);
  }

  /* Visor: fondo difuminado y nada más, sin tinte de color. El contenedor de
     adentro no recibe clicks, así un click en el aire cierra el visor. */
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-green);
    overflow: hidden;
  }

  .lightbox::backdrop {
    background-color: transparent;
    -webkit-backdrop-filter: blur(28px);
    backdrop-filter: blur(28px);
  }

  .lightbox__inner {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    /* Arriba queda el aire del botón de cerrar (que va en la esquina) y abajo
       el de la barra: todo lo demás es captura. */
    padding: 3.25rem 0.75rem 0.75rem;
    pointer-events: none;
  }

  /* El estado activo va por atributo y no por la utilidad `hidden`: el selector
     con scope (`.lightbox__slide[data-astro-cid-...]`) tiene más especificidad
     que `.hidden` y el `display: flex` le ganaba al `none`, así que las cuatro
     capturas quedaban apiladas y la visible fuera de cuadro. */
  .lightbox__slide {
    display: none;
    max-height: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    pointer-events: auto;
  }

  .lightbox__slide[data-activo] {
    display: flex;
  }

  /* La captura se queda con todo el alto que sobra: arriba el epígrafe, abajo la
     barra de navegación. El ancho lo limita la ventana. */
  .lightbox__img {
    display: block;
    width: auto;
    min-height: 0;
    max-width: min(96vw, 110rem);
    max-height: calc(100dvh - 9.5rem);
    border: 1px solid color-mix(in srgb, var(--color-green) 55%, transparent);
    border-radius: 0.375rem;
    box-shadow: 0 1.5rem 4rem color-mix(in srgb, var(--color-green) 35%, transparent);
  }

  .lightbox__caption {
    max-width: min(92vw, 60rem);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-green) 85%, transparent);
    text-align: center;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-cream);
  }

  .lightbox__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    pointer-events: auto;
  }

  .lightbox__counter {
    min-width: 5rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-green) 85%, transparent);
    text-align: center;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-cream);
  }

  .lightbox__nav {
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-green);
    border-radius: 999px;
    background-color: var(--color-cream);
    color: var(--color-green);
    font-size: 1.125rem;
    transition:
      background-color 150ms var(--ease-out),
      color 150ms var(--ease-out);
  }

  .lightbox__nav:hover {
    background-color: var(--color-green);
    color: var(--color-cream);
  }

  .lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    pointer-events: auto;
  }
</style>

<script>
  // Todos los listeners van en el documento y las búsquedas se hacen dentro del
  // handler: así el carrusel y el visor siguen andando aunque el router de Astro
  // reemplace el DOM al navegar entre páginas.
  let bound = false;
  let indiceVisor = 0;
  let touchX: number | null = null;
  let arrastre: { x: number; scroll: number; movido: boolean } | null = null;
  // Momento en que termina un arrastre: sirve para distinguir el click que
  // cierra ese gesto (que no debe abrir el visor) de un click nuevo.
  let finDeArrastre = 0;

  const pad = (value: number) => String(value).padStart(2, "0");

  const pistaDe = (nodo: Element | null) =>
    nodo?.closest("[data-gallery]")?.querySelector<HTMLElement>("[data-gallery-track]") ?? null;
  const visor = () => document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const slidesDe = (dialog: HTMLDialogElement) => [
    ...dialog.querySelectorAll<HTMLElement>("[data-lightbox-slide]"),
  ];

  const indiceDePista = (track: HTMLElement) =>
    Math.round(track.scrollLeft / Math.max(1, track.clientWidth));

  const pintarContador = (track: HTMLElement) => {
    const contador = track
      .closest("[data-gallery]")
      ?.querySelector<HTMLElement>("[data-gallery-counter]");
    if (!contador) return;
    const total = track.querySelectorAll("[data-gallery-slide]").length;
    contador.textContent = `${pad(indiceDePista(track) + 1)} / ${pad(total)}`;
  };

  const irAPista = (track: HTMLElement, indice: number, suave = true) => {
    const total = track.querySelectorAll("[data-gallery-slide]").length;
    const destino = Math.max(0, Math.min(total - 1, indice));
    track.scrollTo({
      left: destino * track.clientWidth,
      behavior: suave ? "smooth" : "auto",
    });
  };

  const renderVisor = (dialog: HTMLDialogElement) => {
    const slides = slidesDe(dialog);
    slides.forEach((slide, i) =>
      slide.toggleAttribute("data-activo", i === indiceVisor)
    );
    const counter = dialog.querySelector<HTMLElement>("[data-lightbox-counter]");
    if (counter) {
      counter.textContent = `${pad(indiceVisor + 1)} / ${pad(slides.length)}`;
    }
  };

  const moverVisor = (dialog: HTMLDialogElement, direction: number) => {
    const total = slidesDe(dialog).length;
    if (total < 2) return;
    indiceVisor = (indiceVisor + direction + total) % total;
    renderVisor(dialog);
  };

  const abrirVisor = (dialog: HTMLDialogElement, i: number) => {
    indiceVisor = i;
    renderVisor(dialog);
    dialog.showModal();
    document.documentElement.style.overflow = "hidden";
    dialog.addEventListener(
      "close",
      () => {
        document.documentElement.style.overflow = "";
      },
      { once: true }
    );
  };

  const onClick = (event: MouseEvent) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    // El click que cierra un arrastre no es un click: no abre el visor. Se
    // compara por tiempo y no con una bandera, porque una bandera se comería
    // también el click siguiente del usuario.
    if (performance.now() - finDeArrastre < 350) return;

    const flechaPista = target.closest<HTMLElement>("[data-gallery-next], [data-gallery-prev]");
    if (flechaPista) {
      const track = pistaDe(flechaPista);
      if (!track) return;
      const paso = flechaPista.hasAttribute("data-gallery-next") ? 1 : -1;
      irAPista(track, indiceDePista(track) + paso);
      return;
    }

    const dialog = visor();
    if (!dialog) return;

    const disparador = target.closest<HTMLElement>("[data-gallery-open]");
    if (disparador) {
      abrirVisor(dialog, Number(disparador.dataset.galleryOpen) || 0);
      return;
    }

    if (!dialog.open) return;
    if (target.closest("[data-lightbox-next]")) return moverVisor(dialog, 1);
    if (target.closest("[data-lightbox-prev]")) return moverVisor(dialog, -1);
    if (target.closest("[data-lightbox-close]")) return dialog.close();
    if (target === dialog) dialog.close();
  };

  const onKeydown = (event: KeyboardEvent) => {
    const dialog = visor();
    if (!dialog?.open) return;
    if (event.key === "ArrowRight") {
      moverVisor(dialog, 1);
      event.preventDefault();
    }
    if (event.key === "ArrowLeft") {
      moverVisor(dialog, -1);
      event.preventDefault();
    }
  };

  const onScroll = (event: Event) => {
    const track = event.target;
    if (track instanceof HTMLElement && track.hasAttribute("data-gallery-track")) {
      pintarContador(track);
    }
  };

  // Arrastre con el mouse: en táctil el scroll ya es nativo y no hace falta.
  const onPointerDown = (event: PointerEvent) => {
    if (event.pointerType === "touch") return;
    const track = event.target instanceof Element ? pistaDe(event.target) : null;
    if (!track) return;
    arrastre = { x: event.clientX, scroll: track.scrollLeft, movido: false };
    track.style.scrollSnapType = "none";
  };

  const onPointerMove = (event: PointerEvent) => {
    if (!arrastre) return;
    const track = pistaDe(event.target instanceof Element ? event.target : null);
    if (!track) return;
    const delta = event.clientX - arrastre.x;
    if (Math.abs(delta) > 6) arrastre.movido = true;
    if (arrastre.movido) {
      track.scrollLeft = arrastre.scroll - delta;
      event.preventDefault();
    }
  };

  const onPointerUp = () => {
    if (!arrastre) return;
    const movido = arrastre.movido;
    arrastre = null;
    const track = document.querySelector<HTMLElement>("[data-gallery-track]");
    if (!track) return;
    track.style.scrollSnapType = "";
    if (movido) {
      finDeArrastre = performance.now();
      irAPista(track, indiceDePista(track));
      pintarContador(track);
    }
  };

  const onTouchStart = (event: TouchEvent) => {
    if (!visor()?.open) return;
    touchX = event.changedTouches[0]?.clientX ?? null;
  };

  const onTouchEnd = (event: TouchEvent) => {
    const dialog = visor();
    if (!dialog?.open || touchX === null) return;
    const delta = (event.changedTouches[0]?.clientX ?? touchX) - touchX;
    touchX = null;
    if (Math.abs(delta) < 40) return;
    moverVisor(dialog, delta < 0 ? 1 : -1);
  };

  const onResize = () => {
    const track = document.querySelector<HTMLElement>("[data-gallery-track]");
    if (!track) return;
    irAPista(track, indiceDePista(track), false);
  };

  const init = () => {
    if (bound) return;
    bound = true;
    document.addEventListener("click", onClick);
    document.addEventListener("keydown", onKeydown);
    document.addEventListener("scroll", onScroll, true);
    document.addEventListener("pointerdown", onPointerDown);
    document.addEventListener("pointermove", onPointerMove, { passive: false });
    document.addEventListener("pointerup", onPointerUp);
    document.addEventListener("pointercancel", onPointerUp);
    document.addEventListener("touchstart", onTouchStart, { passive: true });
    document.addEventListener("touchend", onTouchEnd, { passive: true });
    window.addEventListener("resize", onResize);
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
