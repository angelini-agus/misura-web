---
import { about, pages } from "../lib/content";
import MisureWord from "./ui/MisureWord.astro";

// Reveal por oración: esta es la única sección animada de /nosotros, así que el
// contador arranca después de la apertura (eyebrow + h1) para que el texto se
// escriba detrás de ella y no encima. 80ms entre oraciones: las 4 oraciones del
// cuerpo entran en 320ms y se leen como una escritura, no como un parpadeo.
const LEAD = 120;
const STEP = 80;
type Sentence = { text: string; delay: number };

const blocks: Sentence[][] = [];
let cursor = LEAD;
about.body.forEach((paragraph) => {
  const sentences = paragraph.split(/(?<=[.!?])\s+/);
  blocks.push(
    sentences.map((text) => {
      const delay = cursor;
      cursor += STEP;
      return { text, delay };
    }),
  );
});
---

<section>
  <div
    class="mx-auto flex min-h-[calc(100dvh-var(--nav-h))] max-w-6xl flex-col justify-center px-4 py-[clamp(1.5rem,4dvh,3rem)] text-center md:px-6"
  >
    <p class="text-xs font-semibold uppercase tracking-[0.2em]" data-reveal>
      <MisureWord text={about.eyebrow} />
    </p>
    <h1
      data-reveal
      class="font-display mx-auto mt-4 max-w-3xl text-4xl font-medium leading-tight tracking-tight sm:text-5xl"
    >
      {pages.nosotros.h1}
    </h1>
    <div class="mx-auto mt-8 flex max-w-3xl flex-col gap-5">
      {blocks.map((sentences) => (
        <p class="text-xl leading-relaxed text-green/80 md:text-2xl">
          {/*
            Cada oración es un <span> inline con su propio data-reveal y
            transitionDelay. Los <span> inline no aceptan transform en
            navegadores modernos (transform no aplica a cajas inline no
            reemplazadas), así que el translateY del primitivo [data-reveal]
            lo ignora el navegador y el efecto queda solo de opacidad: la
            línea se escribe sin que cada span mueva layout ni corte de
            línea. No hace falta display: inline-block; agregarlo haría
            visibles los translateY y cambiaría los wraps del párrafo.
            Si parece un bug, es a propósito: el reveal es de opacidad pura.
          */}
          {sentences.map((sentence) => (
            <span data-reveal style={{ transitionDelay: `${sentence.delay}ms` }}>
              <MisureWord text={sentence.text} />{" "}
            </span>
          ))}
        </p>
      ))}
    </div>
  </div>
</section>
