---
import { about } from "../lib/content";
import MisureWord from "./ui/MisureWord.astro";
---

<section id="nosotros" class="scroll-mt-24 border-t border-green">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-28">
    <p class="text-xs font-semibold uppercase tracking-[0.2em]" data-reveal>
      <MisureWord text={about.eyebrow} />
    </p>
    <h2
      data-reveal
      class="font-display mt-4 max-w-3xl text-4xl font-medium leading-tight tracking-tight sm:text-5xl"
    >
      {about.title}
    </h2>
    <div class="mt-8 flex max-w-3xl flex-col gap-5">
      {about.body.map((paragraph, index) => (
        <p
          data-reveal
          style={{ transitionDelay: `${index * 80}ms` }}
          class="text-xl leading-relaxed text-green/80 md:text-2xl"
        >
          {paragraph}
        </p>
      ))}
    </div>
  </div>
</section>
