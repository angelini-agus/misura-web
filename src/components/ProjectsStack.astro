---
import { Image } from "astro:assets";
import { caseStudies, portfolio } from "../lib/content";
import Button from "./ui/Button.astro";
import ScreenshotFrame from "./ui/ScreenshotFrame.astro";

// Un mazo de "carpetas" por proyecto, en el orden curado de `portfolio.items`.
// El href de cada item (`/proyectos/<slug>`) cruza con el caso correspondiente
// para tomar cliente, título, descripción, tecnologías, slug y la galería.
// No se inventa copy: todo sale de content.ts.
//
// La galería se corta a tres capturas aunque SOLO se renderiza la primera en
// v2: con 40vh de tope para el cuerpo de la carpeta no entran dos miniaturas
// debajo de la grande sin romper el límite. Revertir ese recorte es volver a
// pintar el bloque `gallery.slice(1)` debajo de la captura grande (mismo
// patrón de v1); la parte de slicing en este archivo no cambia.
const projects = portfolio.items.flatMap((item) => {
  const slug = item.href?.replace("/proyectos/", "") ?? "";
  const study = Object.values(caseStudies).find((cs) => cs.slug === slug);
  return study
    ? [{ study, gallery: study.gallery?.slice(0, 3) ?? [] }]
    : [];
});

// Etiqueta del CTA: la del portfolio ("Ver caso completo"), que ya existe en
// content.ts y es la misma que usan las tarjetas del home.
const detailsLabel = portfolio.detailsLabel;
const projectCount = projects.length;
---

<section
  id="portfolio"
  class="projects-stack scroll-mt-24 border-t border-green"
  style={`--flip-count: ${projectCount}`}
>
  <div class="mx-auto max-w-6xl px-4 pt-16 pb-8 md:px-6 md:pt-24 md:pb-10">
    <div class="max-w-xl" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.2em]">
        {portfolio.eyebrow}
      </p>
      <h2
        class="font-display mt-3 text-3xl font-medium leading-tight tracking-tight sm:text-4xl"
      >
        {portfolio.title}
      </h2>
      <p class="mt-4 leading-relaxed text-green/80">
        {portfolio.description}
      </p>
    </div>
  </div>

  <div class="projects-stack__runway" data-flip-runway>
    <div class="projects-stack__sticky">
      <div class="projects-stack__stage" data-flip-stage>
        <div class="projects-stack__deck">
          {projects.map(({ study, gallery }, index) => (
            <article
              class="folder"
              data-flip-card={index}
              style={`z-index: ${index + 1}`}
            >
              <div class="folder__tab">
                <p class="folder__label">
                  Proyecto {String(index + 1).padStart(2, "0")}
                </p>
              </div>
              <div class="folder__body">
                <div class="folder__copy">
                  <h3 class="folder__title">{study.title}</h3>
                  <p class="folder__client">{study.client}</p>
                  <p class="folder__description">{study.seo.description}</p>
                  <div class="folder__tags">
                    {study.technologies.map((tech) => (
                      <span class="folder__tag">{tech}</span>
                    ))}
                  </div>
                  <div class="folder__cta">
                    <Button
                      variant="cream"
                      href={`/proyectos/${study.slug}`}
                    >
                      {detailsLabel}
                    </Button>
                  </div>
                </div>
                <div class="folder__shots">
                  <div class="folder__shot">
                    <ScreenshotFrame compact hover>
                      <Image
                        src={gallery[0].src}
                        alt={gallery[0].alt}
                        widths={[480, 768, 1088]}
                        sizes="(min-width: 48rem) 30rem, 88vw"
                        class="folder__image"
                        loading={index === 0 ? "eager" : "lazy"}
                      />
                    </ScreenshotFrame>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* --nav-h: alto del header sticky, el mismo numero que usa Contact.astro.
     mobile = py-4 (2 x 16px) + el summary del menu (34px) + border-b (1px) = 67px
     = 4.1875rem; desde md = py-4 + el CTA de escritorio (44px) + border-b (1px)
     = 77px = 4.8125rem. La barra de anuncio NO se cuenta: cuando el visitante
     llega a estas carpetas ya scrolleo y la barra no esta visible. Si cambia el
     padding del header, su contenido mas alto o su borde, hay que tocar los dos
     valores. */
  .projects-stack {
    --nav-h: 4.1875rem;
  }

  @media (min-width: 48rem) {
    .projects-stack {
      --nav-h: 4.8125rem;
    }
  }

  /* Reglas BASE (sin JS): el carrete se desarma. El runway es alto automatico,
     el sticky no se pega, las carpetas se ven una debajo de la otra en flujo
     normal. Es el patron de [data-reveal] en global.css y la misma idea: con
     JS deshabilitado o fallando, el contenido no queda apilado en un solo
     punto del DOM. */
  .projects-stack__runway {
    height: auto;
  }

  .projects-stack__sticky {
    position: static;
    height: auto;
    overflow: visible;
    display: block;
  }

  .projects-stack__stage {
    position: relative;
    width: 100%;
    margin: 0 auto;
  }

  .projects-stack__deck {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    max-width: 32rem;
    margin: 0 auto;
  }

  /* La caja visible (borde, crema) vive en el BODY de la carpeta: la pestaña
     se posiciona absolutamente arriba a la izquierda y sobresale por arriba
     del cuerpo. Sin JS cada carpeta se ve como una entrada propia en la
     lista vertical del deck. */
  .folder {
    position: relative;
  }

  /* Superficie verde con letras crema: la misma piel de las cards del sitio
     (CTA del navbar, barra de anuncios). El borde crema es hairline: se lee
     dentro de la pila (separa solapas) y desaparece contra el fondo crema de
     la pagina, asi la silueta la define el verde. */
  .folder__body {
    height: auto;
    overflow: hidden;
    border: 1px solid var(--color-cream);
    border-radius: 0.375rem;
    /* La esquina superior IZQUIERDA va a 90°: ahí apoya la solapa, que comparte
       el borde con el cuerpo. Con el radio, la curva cortaba la unión y se veía
       un escalon entre la solapa y el cuerpo. Las otras tres siguen redondeadas:
       es la silueta de carpeta (recta donde entra la pestaña, curva en el resto). */
    border-top-left-radius: 0;
    background-color: var(--color-green);
    color: var(--color-cream);
  }

  /* Reglas CON JS (gate en .js del <html>): el runway se vuelve el carrete de
     scroll y el sticky se pega a la ventana. Las carpetas pasan a estar
     apiladas en el stage. .js lo pone BaseLayout.astro cuando el modulo del
     cliente carga; sin ese gate, el contenido se ve como una lista. */

  :global(.js) .projects-stack__runway {
    /* El carrete mide 100dvh (el tramo de entrada del sticky) + n * 60dvh: un
       60% de pantalla de scroll por proyecto, incluido el tramo final propio de
       la ultima carpeta (ver flipGeometry: un tramo por carpeta). Antes era
       n * 100dvh, o sea una pantalla entera por proyecto: el autor lo sintio
       lento ("tarda mucho en llegar"). */
    height: calc(100dvh + var(--flip-count) * 60dvh);
  }

  :global(.js) .projects-stack__sticky {
    position: sticky;
    top: 0;
    height: 100dvh;
    /* overflow: clip (no hidden) recorta las carpetas que se asientan fuera del
       viewport sin crear un scroll container interno. */
    overflow: clip;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--nav-h) + 1.5rem) clamp(1rem, 4vw, 2.5rem) 2.5rem;
  }

  :global(.js) .projects-stack__stage {
    position: relative;
    width: 100%;
    height: 100%;
    /* Bloque, no flex: el desplazamiento vertical del mazo lo calcula el
       script (`margin-top` sobre el deck), porque el centrado tiene que
       tener en cuenta la PILA que se asienta hacia arriba del frente. */
    display: block;
  }

  /* El deck tiene la altura que el JS le ponga (ver medida). Por defecto en
     desktop ocupa 40vh; en mobile se ajusta al contenido del cuerpo (que a
     su vez puede crecer si la descripción, los tags y el CTA no entran en
     40vh). El `max-height` evita que un contenido excepcional desborde el
     stage. */
  :global(.js) .projects-stack__deck {
    position: relative;
    width: min(100%, 80rem, calc((100dvh - var(--nav-h) - 4rem) * 2));
    max-width: 80rem;
    /* `auto` horizontal: el deck lo centra el navegador; el script escribe el
       `transform: translateY()` con el que la pila se pega arriba del stage.
       Sin el `auto`, en pantallas anchas el mazo queda pegado a la izquierda. */
    margin: 0 auto;
  }

  /* === Geometría de la carpeta (mobile y base) ===========================
     Mobile: una columna, ancho util del stage, alto del cuerpo crece con el
     contenido y la pestaña arriba a la izquierda. */

  .folder {
    display: flex;
    flex-direction: column;
  }

  /* La pestaña NO usa `white-space: nowrap` ni ellipsis: si el título es largo
     y no entra en una línea, se parte en dos y la pestaña crece en alto.
     El script mide la altura real de la pestaña más alta al init y en cada
     resize, y deriva de ahí el escalón del asentado (step = tab + sliver).
     Eso es lo que mantiene el "tab + sliver" coherente cuando una pestaña
     pasa de 1 a 2 líneas. */
  .folder__tab {
    align-self: flex-start;
    border: 1px solid var(--color-cream);
    border-bottom: 0;
    /* Arriba redondeada (como la referencia del autor), abajo a 90° para
       fusionarse con el cuerpo, que tiene la esquina superior izquierda recta. */
    border-radius: 0.375rem 0.375rem 0 0;
    background-color: var(--color-green);
    color: var(--color-cream);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    line-height: 1.25;
    max-width: 100%;
  }

  /* Faldon verde que tapa el borde superior del cuerpo justo debajo de la
     solapa, sin agregarle bordes laterales (esos quedan sobre la linea del
     cuerpo). 2px de alto para que el solape siga tapando el borde del cuerpo
     con el `scale(0.98)` de las carpetas asentadas, y 1px extra a cada lado
     para cubrir el ancho de los bordes laterales de la solapa. */
  :global(.js) .folder__tab::after {
    content: "";
    position: absolute;
    top: 100%;
    left: -1px;
    right: -1px;
    height: 2px;
    background-color: var(--color-green);
  }

  .folder__label {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.005em;
    font-size: inherit;
    line-height: inherit;
    /* Etiqueta de la solapa: "Proyecto 01". Una linea siempre (el numero es
       corto): la solapa no crece y el escalon del asentado queda chico. */
    display: block;
    white-space: nowrap;
  }

  .folder__body {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    /* padding-top usa --folder-step (medido en runtime): equivale al alto
       del escalón, así la franja que asoma arriba del cuerpo de la carpeta
       siguiente es SOLO cuerpo liso (sin contenido) y NO muestra un
       pedazo de la captura. Ver defecto 1. */
    padding: var(--folder-step, 44px) clamp(1rem, 2.5vw, 1.5rem)
      clamp(1rem, 2.5vw, 1.5rem) clamp(1rem, 2.5vw, 1.5rem);
  }

  .folder__copy {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  /* Titulo del caso: vive en el cuerpo del folder (la solapa lleva el numero,
     como en la referencia del autor). */
  .folder__title {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.7cqw, 1.375rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .folder__client {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-cream) 72%, transparent);
  }

  .folder__description {
    font-size: 0.875rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-cream) 85%, transparent);
  }

  .folder__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .folder__tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    /* floor del spec: tags >= 10px. Antes 0.6rem (9.6px). */
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--color-cream);
  }

  .folder__cta {
    margin-top: 0.25rem;
  }

  .folder__shots {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
  }

  .folder__shot {
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 100%;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
  }

  .folder__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* === JS-gated: posiciones y dimensiones cuando el mazo esta vivo ====== */

  :global(.js) .folder {
    /* Cada carpeta es una caja absoluta del tamaño del deck, llena el deck
       entero. La pestaña se posiciona para sobresalir arriba. */
    position: absolute;
    inset: 0;
    /* Animacion: translateY + scale, manejados por el script. */
    transform: translateY(var(--folder-y, 0px)) scale(var(--folder-scale, 1));
    transform-origin: 50% 50%;
    /* will-change se aplica SOLO mientras el mazo esta en movimiento (clase
       .projects-stack--moving, gestionada por el script). */
  }

  :global(.js) .projects-stack--moving .folder,
  :global(.js) .projects-stack--moving .projects-stack__deck {
    will-change: transform;
  }

  :global(.js) .folder__tab {
    position: absolute;
    /* bottom: 100% deja la pestaña "apoyada" sobre el borde superior del
       cuerpo: su lado inferior coincide con el top del cuerpo. Es el gesto
       de "carpeta de Windows" del recorte. */
    /* La caja de la solapa termina EXACTAMENTE en el borde superior del cuerpo
       (`bottom: 100%`): asi sus bordes laterales no bajan ni un pixel por
       debajo de la linea del cuerpo. El borde crema del cuerpo se tapa con el
       faldon verde de `::after`, que no tiene bordes laterales. Con el solape
       hecho por la caja (`bottom: calc(100% - 2px)`), la linea vertical derecha
       de la solapa quedaba 2px mas abajo que el borde del cuerpo: se veia un
       escalon en la esquina inferior derecha. */
    bottom: 100%;
    /* `left: 0` (no -1px): el borde izquierdo de la solapa tiene que caer
       EXACTAMENTE sobre el del cuerpo para leerse como una sola linea. Con
       -1px quedaban uno al lado del otro y el filo izquierdo hacia un escalon
       de 1px entre la solapa y el cuerpo. */
    left: 0;
    /* Para que el borde inferior de la pestaña se fusione con el borde
       superior del cuerpo, sin que se vea una línea doble: el offset de -1px
       sube la pestaña para superponerse con el borde de 1px del cuerpo. */
    border-bottom: 0;
    /* Tope de ancho: la pestaña no excede el ancho del cuerpo. Por defecto
       se queda con el ancho de su contenido (un título corto da una pestaña
       estrecha, un título largo que parte en 2 líneas da una pestaña más
       ancha). */
    max-width: calc(100% - 0px);
  }

  :global(.js) .folder__body {
    /* El cuerpo crece con su contenido (alto = scrollHeight del JS, ver
       `measure()`). Con `height: auto` el body deja de "llenar" el deck y
       pasa a ser content-driven: en mobile, si la descripción + tags + CTA
       + captura suman más que 40vh, el body crece para que nada se corte
       (ver defecto 2). En desktop, el `max-height: 40vh` del @media mantiene
       el tope pedido por el autor y se respeta por arriba. El `min-height`
       asegura que el cuerpo nunca quede más bajo que 40vh aunque el contenido
       sea corto. */
    height: auto;
    min-height: 40vh;
  }

  /* === Desktop (>= 48rem): dos columnas, mas aire, tope 40vh ============ */

  @media (min-width: 48rem) {
    :global(.js) .folder__body {
      display: grid;
      grid-template-columns: 45fr 55fr;
      gap: clamp(0.75rem, 2vw, 1.5rem);
      align-items: stretch;
      padding: var(--folder-step, 44px) clamp(1.25rem, 2.5vw, 2rem)
        clamp(1.25rem, 2.5vw, 2rem) clamp(1.25rem, 2.5vw, 2rem);
      /* En desktop el cuerpo se queda en 40vh: la captura se recorta con
         object-fit: cover dentro de su columna (lo que no entra se pierde
         por arriba/abajo según el aspect del shot). */
      max-height: 40vh;
    }

    .folder__copy {
      /* El contenido va al tope y la CTA al fondo con margin-top: auto.
         La columna se estira al alto del body (que lo dicta el shot en 16:10);
         con el contenido arriba y la CTA abajo queda un aire controlado en
         el medio, no un bloque vacío al final. */
      justify-content: flex-start;
    }

    .folder__cta {
      /* Empuja la CTA al fondo de la columna del copy para que no quede
         colgando arriba del bloque vacío que deja la diferencia entre el
         contenido del copy y el alto del shot (que es quien define el alto
         de la columna con align-items: stretch). */
      margin-top: auto;
    }

    .folder__shots {
      align-items: stretch;
    }

    .folder__shot {
      max-height: 100%;
    }

    .folder__description {
      /* Sin line-clamp en ningún breakpoint: la descripción es contenido
        (per la brief del autor "abajo, lo mismo que ya teníamos antes")
        y no se recorta con … nunca. Reducimos el tamaño (14 px en desktop,
        13 px en mobile) y el interlineado para que el caso más largo
        (CRM / Legal, ~290 chars) entre en el alto 40vh sin clipping. El
        line-height 1.45 mantiene lectura cómoda a 14 px. */
      font-size: 0.875rem;
      line-height: 1.45;
    }
  }

  /* === Mobile (< 48rem): una columna, contenido compaginado para entrar ===
     El autor pidió no esconder contenido: la descripción va entera, los tags
     van, el CTA va. Para que entren en 40vh en mobile, ajusto type scale y
     spacing. Lo que cede primero: el shot (en mobile la captura se renderiza
     con object-fit: cover rellenando el alto disponible, no manteniendo
     16:10 estricto, porque la columna es estrecha y 16:10 daría un cuerpo
     de ~60vh que se come el resto). */

  @media (max-width: 47.99rem) {
    :global(.js) .folder__body {
      /* Permite que el cuerpo crezca con el contenido. El JS acota la
         altura del deck para que el cuerpo no se desborde del stage. */
      max-height: calc(100dvh - var(--nav-h) - 4rem);
    }

    .folder__body {
      padding: var(--folder-step, 44px) 12px 12px 12px;
    }

    .folder__client {
      font-size: 0.6rem;
    }

    .folder__description {
      font-size: 0.8125rem;
      line-height: 1.45;
      /* La descripción va entera en mobile (sin line-clamp). El alto del
         cuerpo absorbe las líneas extra; el JS acota el deck para que no
         se desborde. */
    }

    .folder__tags {
      gap: 0.3rem;
    }

    .folder__tag {
      /* floor del spec: tags >= 10px en mobile. */
      font-size: 0.625rem;
      padding: 0.2rem 0.45rem;
    }

    .folder__cta :global(a) {
      /* floor CTA >= 13px. 0.8125rem = 13px (16 base). */
      font-size: 0.8125rem;
      padding: 0.45rem 1rem;
    }

    .folder__cta {
      margin-top: 0.25rem;
    }

    .folder__copy {
      flex: 0 0 auto;
    }

    .folder__shots {
      /* La captura deja de mandar el alto en mobile: es una foto apoyada
         dentro de la carpeta, no el bloque principal. */
      flex: 0 0 auto;
      min-height: 0;
    }

    .folder__shot {
      width: 100%;
      /* Alto acotado (136-176px según ancho): muestra el encabezado de la
         interfaz, que es la parte que informa, y deja la carpeta compacta
         sin tocar el copy. */
      height: clamp(8.5rem, 26vw, 11rem);
      aspect-ratio: auto;
    }

    .folder__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      aspect-ratio: auto;
    }
  }

  /* Mobile pequeño (≤ 30rem): paddings más cerrados y type scale más chico
     para que entre todo el contenido en viewports estrechos. Sin line-clamp:
     la descripción va entera (el body crece con el contenido). Respetamos
     los floors del brief: desc >= 13px, tags >= 10px, tab >= 12px,
     CTA >= 13px. */
  @media (max-width: 30rem) {
    /* Captura todavía más baja en la pantalla más chica: la carpeta tiene
       que entrar en el alto útil sin mutilar el copy. */
    .folder__shot {
      height: 8rem;
    }

    :global(.js) .folder__body {
      gap: 0.5rem;
      padding: var(--folder-step, 44px) 0.75rem 0.75rem 0.75rem;
    }

    .folder__label {
      /* floor etiqueta de solapa >= 12px. 0.8125rem = 13px. */
      font-size: 0.8125rem;
    }

    .folder__title {
      /* El titulo del cuerpo baja un punto en la pantalla mas chica. */
      font-size: 1.0625rem;
    }

    .folder__description {
      /* floor desc >= 13px. 0.8125rem = 13px. */
      font-size: 0.8125rem;
      line-height: 1.4;
    }

    .folder__cta :global(a) {
      /* floor CTA >= 13px. 0.8125rem = 13px. */
      font-size: 0.8125rem;
      padding: 0.45rem 1rem;
    }

    .folder__body {
      gap: 0.4rem;
    }

    .folder__tags {
      gap: 0.2rem;
    }
  }
</style>

<script>
  // Importamos la matemática como módulo puro (sin DOM). El bundler de Astro
  // emite un chunk por modulo y este vive en su propio archivo, lo que
  // también ayuda al verizador de tipos de `astro check`.
  import {
    flipCardState,
    flipFront,
    flipGeometry,
    flipProgress,
    springStep,
    defaultSpringConfig,
  } from "../lib/flip-stack";

  // Estado de la ultima animacion en curso, a nivel de MODULO (no de init):
  // asi la siguiente llamada a init() puede interrumpir el rAF anterior sin
  // que se acumulen timers entre navegaciones SPA. El cleanup vive en
  // init() y se llama antes de re-medir.
  let cleanup: (() => void) | null = null;
  let rafId: number | null = null;

  // Sliver: la cantidad de cuerpo que queda visible entre la pestaña de la
  // carpeta de atrás y el top de la carpeta siguiente. El autor pidió que las
  // carpetas apiladas estén más cerca entre sí, así que quedó en 3px: la pila
  // se lee como pestañas casi pegadas, con apenas un filo de cuerpo entre una y
  // otra. El alto del cuerpo no cambia (el padding-top sigue siendo el escalón).
  const SLIVER = 3;

  const init = () => {
    if (cleanup) {
      cleanup();
      cleanup = null;
    }

    const section = document.querySelector<HTMLElement>(".projects-stack");
    const runway = document.querySelector<HTMLElement>("[data-flip-runway]");
    const stage = document.querySelector<HTMLElement>("[data-flip-stage]");
    const deck = stage?.querySelector<HTMLElement>(".projects-stack__deck");
    const folders = Array.from(
      document.querySelectorAll<HTMLElement>("[data-flip-card]"),
    );

    if (!section || !runway || !stage || !deck || folders.length === 0) {
      return;
    }

    let springValue = 0;
    let springVelocity = 0;
    let targetProgress = 0;
    let lastFrameAt: number | null = null;
    let reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let currentFront = -1;

    // Geometría: la recalculamos en cada medición leyendo el alto real del
    // cuerpo y de la pestaña. Sale del DOM, no de constantes. Esto es lo que
    // mantiene el "tab + sliver" honesto aunque el visitante rote el
    // dispositivo o cambie el tamaño de fuente (y la pestaña pase de 1 a 2
    // líneas en un viewport estrecho).
    let geometry = flipGeometry(folders.length, 44, 80);
    const springConfig = defaultSpringConfig();

    let runwayTop = 0;
    let runwayHeight = 0;
    let stickyHeight = 0;
    let deckMaxH = 0;
    // Parametros del desplazamiento de la pila, recalculados en measure().
    let pileStep = 44;
    let pileTabH = 44;
    let pileMaxOffset = 44;

    const measure = () => {
      const runwayRect = runway.getBoundingClientRect();
      runwayTop = runwayRect.top + window.scrollY;
      runwayHeight = runwayRect.height;
      const sticky = runway.querySelector<HTMLElement>(
        ".projects-stack__sticky",
      );
      stickyHeight = sticky?.offsetHeight ?? window.innerHeight;

      // Paso: alto de la pestaña MÁS ALTA + sliver. Medimos TODAS las
      // pestañas (no solo la primera) y tomamos el máximo, porque el spec
      // permite que el título se parta en 2 líneas en viewports estrechos
      // y eso cambia el alto de la pestaña de esa carpeta. El escalón del
      // asentado se deriva de la pestaña más alta para que TODAS las
      // carpetas (incluidas las de pestaña corta) suban exactamente lo
      // mismo.
      const tabHeights = folders.map((f) => {
        const t = f.querySelector<HTMLElement>(".folder__tab");
        return t?.offsetHeight ?? 34;
      });
      const maxTabHeight = Math.max(...tabHeights);
      const step = maxTabHeight + SLIVER;

      // entryOffset: la distancia desde la posición de reposo (carpeta al
      // frente) hasta donde aparece la carpeta entrante. Sale del alto util
      // del sticky: el cuerpo debe quedar casi debajo del stage para que
      // SOLO la pestaña asome en el borde inferior del stage cuando la
      // carpeta esta "esperando abajo".
      const entryOffset = Math.max(stickyHeight - maxTabHeight - 1, step);

      // El CSS lee --folder-step para decidir la padding-top del cuerpo (asi
      // la franja que asoma arriba es cuerpo liso sin contenido). Lo
      // publicamos en el <section> para que todos los .folder__body lo
      // hereden por cascada.
      section.style.setProperty("--folder-step", `${step}px`);

      geometry = flipGeometry(folders.length, step, entryOffset);

      // Alto del deck: en mobile, donde el cuerpo puede crecer con el
      // contenido (descripción + tags + CTA + captura), el deck tiene que
      // acompañar para que la carpeta siguiente no se apile sobre la
      // actual. Usamos scrollHeight (alto del contenido, independiente de
      // cómo esté renderizado el body) en vez de offsetHeight, porque
      // offsetHeight puede ser chico si las capturas aún no terminaron de
      // cargar y eso nos haría setear un deck subdimensionado.
      const bodyHeights = folders.map((f) => {
        const b = f.querySelector<HTMLElement>(".folder__body");
        return b?.scrollHeight ?? 0;
      });
      const maxBodyHeight = Math.max(...bodyHeights);

      // Tope por stage: no dejamos que el deck crezca más allá del alto
      // disponible dentro del sticky (que tiene overflow: clip).
      const availH = stage.clientHeight;
      deckMaxH = availH;

      const desiredDeckH = maxBodyHeight + maxTabHeight;
      deck.style.height = `${Math.min(desiredDeckH, deckMaxH)}px`;

      // La pila se pega ARRIBA del stage y el mazo baja un escalon por cada
      // carpeta asentada (ver syncDomFromProgress). Con el centrado de la pila
      // el arranque quedaba ~300px abajo de "Casos de exito" y dejaba un hueco
      // grande arriba del Proyecto 01; pegado arriba, el primer folder arranca
      // junto a la seccion y la pila crece hacia abajo sin cortarse contra el
      // navbar.
      const deckH = deck.getBoundingClientRect().height;
      pileStep = step;
      pileTabH = maxTabHeight;
      pileMaxOffset = Math.max(maxTabHeight, availH - deckH);
    };

    const syncDomFromProgress = (progress: number) => {
      const front = flipFront(progress, geometry);
      if (front !== currentFront) {
        currentFront = front;
        for (let i = 0; i < folders.length; i++) {
          if (i === front) {
            folders[i].removeAttribute("inert");
          } else {
            folders[i].setAttribute("inert", "");
          }
        }
      }

      for (let i = 0; i < folders.length; i++) {
        const state = flipCardState(progress, i, geometry, reduceMotion);
        const folder = folders[i];

        folder.style.setProperty("--folder-y", `${state.y}px`);
        folder.style.setProperty("--folder-scale", String(state.scale));

        if (reduceMotion) {
          folder.style.opacity = String(state.opacity);
        } else if (folder.style.opacity) {
          folder.style.opacity = "";
        }
      }

      // El mazo entero baja un escalon por cada carpeta asentada, para que la
      // pila quede pegada arriba del stage (y no centrada, que dejaba un hueco
      // grande arriba del Proyecto 01) sin cortarse contra el navbar. Con
      // movimiento reducido no hay paneo. Se escribe con transform (no margin)
      // para no disparar layout en cada frame.
      const headroom = reduceMotion
        ? 0
        : progress * (folders.length - 1) * pileStep;
      const deckOffset = Math.min(
        Math.max(headroom, pileTabH),
        pileMaxOffset,
      );
      deck.style.transform = `translateY(${Math.round(deckOffset)}px)`;
    };

    const tick = (now: number) => {
      rafId = null;
      const dt =
        lastFrameAt === null ? 1 / 60 : Math.max(0, (now - lastFrameAt) / 1000);
      lastFrameAt = now;

      const result = springStep(
        springValue,
        springVelocity,
        targetProgress,
        dt,
        springConfig,
      );
      springValue = result.value;
      springVelocity = result.velocity;

      syncDomFromProgress(springValue);

      if (!result.settled) {
        if (!section.classList.contains("projects-stack--moving")) {
          section.classList.add("projects-stack--moving");
        }
        rafId = requestAnimationFrame(tick);
      } else {
        if (section.classList.contains("projects-stack--moving")) {
          section.classList.remove("projects-stack--moving");
        }
      }
    };

    const requestTick = () => {
      if (rafId !== null) return;
      lastFrameAt = null;
      rafId = requestAnimationFrame(tick);
    };

    const onScroll = () => {
      targetProgress = flipProgress(
        window.scrollY,
        runwayTop,
        runwayHeight,
        stickyHeight,
      );
      requestTick();
    };

    const onResize = () => {
      measure();
      targetProgress = flipProgress(
        window.scrollY,
        runwayTop,
        runwayHeight,
        stickyHeight,
      );
      requestTick();
    };

    measure();

    // Re-medimos cuando las capturas terminen de cargar: el body puede
    // crecer (porque ahora conoce la altura natural de la <img>) y el deck
    // debe acompañar para que no se corte la descripción, los tags o el CTA
    // en mobile.
    const imageLoadListeners: Array<() => void> = [];
    folders.forEach((f) => {
      const img = f.querySelector<HTMLImageElement>(".folder__image");
      if (img && !img.complete) {
        const onLoad = () => {
          // Una vez que la imagen cargó, scrollHeight puede haber cambiado.
          measure();
        };
        img.addEventListener("load", onLoad, { once: true });
        img.addEventListener("error", onLoad, { once: true });
        imageLoadListeners.push(() => {
          img.removeEventListener("load", onLoad);
          img.removeEventListener("error", onLoad);
        });
      }
    });

    targetProgress = flipProgress(
      window.scrollY,
      runwayTop,
      runwayHeight,
      stickyHeight,
    );
    springValue = targetProgress;
    springVelocity = 0;
    syncDomFromProgress(springValue);

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
    let resizeObserver: ResizeObserver | null = null;
    if ("ResizeObserver" in window) {
      resizeObserver = new ResizeObserver(() => onResize());
      resizeObserver.observe(runway);
    }

    const motionQuery = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const onMotionChange = () => {
      reduceMotion = motionQuery.matches;
      syncDomFromProgress(springValue);
    };
    if (typeof motionQuery.addEventListener === "function") {
      motionQuery.addEventListener("change", onMotionChange);
    }

    cleanup = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onResize);
      if (resizeObserver) {
        resizeObserver.disconnect();
        resizeObserver = null;
      }
      if (typeof motionQuery.removeEventListener === "function") {
        motionQuery.removeEventListener("change", onMotionChange);
      }
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      for (const folder of folders) {
        folder.style.removeProperty("--folder-y");
        folder.style.removeProperty("--folder-scale");
        if (folder.style.opacity) folder.style.opacity = "";
      }
      section.style.removeProperty("--folder-step");
      deck.style.removeProperty("height");
      for (const cleanupFn of imageLoadListeners) cleanupFn();
    };
  };

  document.addEventListener("astro:page-load", init);
  init();
</script>