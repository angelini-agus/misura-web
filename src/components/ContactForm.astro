---
import { contactForm } from "../lib/content";
import ArrowRightIcon from "./ui/ArrowRightIcon.astro";
import CheckIcon from "./ui/CheckIcon.astro";

interface Props {
  simple?: boolean;
}

const { simple = false } = Astro.props;
const { web3forms } = contactForm;
---

<div data-service-flow data-step="service" class="h-full">
  <div data-service-step role="group" aria-labelledby="cf-service-question" class="flex flex-col justify-center">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-green">
      {contactForm.serviceStep.eyebrow}
    </p>
    <p id="cf-service-question" class="mt-3 text-2xl font-bold text-green">
      {contactForm.serviceStep.title}
    </p>
    <p class="mt-2 text-sm text-green/75">
      {contactForm.serviceStep.help}
    </p>
    <ul class="mt-6 grid auto-rows-fr gap-3 sm:grid-cols-2">
      {contactForm.serviceOptions.map((option) => (
        <li>
          <button
            type="button"
            data-service-option
            data-value={option.value}
            class="flex h-full w-full cursor-pointer items-center justify-center rounded-md border border-green bg-cream px-4 py-3 text-center text-sm font-semibold text-green transition hover:bg-green hover:text-cream active:translate-x-[-4px] active:translate-y-[4px] active:duration-75"
          >
            {option.label}
          </button>
        </li>
      ))}
    </ul>
  </div>

  <form
    id="contact-form"
    data-service-form
    data-form-error-message={contactForm.formError}
    class="flex h-full flex-col gap-8"
    novalidate
  >
    <input
      type="hidden"
      name="access_key"
      value={web3forms.accessKey}
    />

    <div class="flex flex-col gap-2">
      <button
        type="button"
        data-service-change
        data-field-visual="service"
        aria-describedby="cf-service-error"
        aria-label={contactForm.serviceStep.backAriaLabel}
        class="group flex w-full cursor-pointer items-center gap-3 rounded-md text-left text-green transition duration-150 ease-out hover:text-green-dark active:translate-x-[-4px] active:translate-y-[4px] active:duration-75 aria-[invalid=true]:text-error"
      >
        <ArrowRightIcon class="h-6 w-6 shrink-0 -scale-x-100 transition-transform duration-150 ease-out group-hover:-translate-x-1" />
        <span
          data-service-chosen
          class="block min-h-8 text-2xl font-bold"
        ></span>
      </button>
      <input
        type="hidden"
        name="service"
        value=""
        data-error-message={contactForm.errors.service}
      />
      <p id="cf-service-error" data-error-for="service" class="sr-only text-sm text-error" role="alert"></p>
    </div>

    <div class="flex flex-1 flex-col justify-center">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="flex flex-col gap-2">
          <label
            for="cf-name"
            class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
          >
            {contactForm.labels.name} <span aria-hidden="true" class="text-error">*</span>
          </label>
          <input
            id="cf-name"
            name="name"
            type="text"
            autocomplete="name"
            required
            aria-describedby="cf-name-error"
            data-error-message={contactForm.errors.name}
            placeholder={contactForm.placeholders.name}
            class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/75 aria-[invalid=true]:border-error"
          />
          <p id="cf-name-error" data-error-for="name" class="sr-only text-sm text-error" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2">
          <label
            for="cf-company"
            class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
          >
            {contactForm.labels.company} <span class="normal-case tracking-normal text-green/75">(opcional)</span>
          </label>
          <input
            id="cf-company"
            name="company"
            type="text"
            autocomplete="organization"
            placeholder={contactForm.placeholders.company}
            class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/75"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label
            for="cf-email"
            class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
          >
            {contactForm.labels.email} <span aria-hidden="true" class="text-error">*</span>
          </label>
          <input
            id="cf-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            aria-describedby="cf-email-error"
            data-error-message={contactForm.errors.email}
            placeholder={contactForm.placeholders.email}
            class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/75 aria-[invalid=true]:border-error"
          />
          <p id="cf-email-error" data-error-for="email" class="sr-only text-sm text-error" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2">
          <label
            for="cf-phone"
            class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
          >
            {contactForm.labels.phone} <span class="normal-case tracking-normal text-green/75">(opcional)</span>
          </label>
          <input
            id="cf-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            aria-describedby="cf-phone-error"
            data-error-message={contactForm.errors.phone}
            placeholder={contactForm.placeholders.phone}
            class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/75 aria-[invalid=true]:border-error"
          />
          <p id="cf-phone-error" data-error-for="phone" class="sr-only text-sm text-error" role="alert"></p>
        </div>

        {!simple && (
          <div class="flex flex-col gap-2 md:col-span-2">
            <label
              for="cf-message"
              class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
            >
              {contactForm.labels.message} <span class="normal-case tracking-normal text-green/75">(opcional)</span>
            </label>
            <textarea
              id="cf-message"
              name="message"
              rows="5"
              placeholder={contactForm.placeholders.message}
              class="w-full resize-none overflow-y-auto rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/75 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
            ></textarea>
          </div>
        )}
      </div>
    </div>

    <div class="flex flex-col items-center gap-4">
      <button
        id="contact-submit"
        type="submit"
        data-submitting-label={contactForm.submittingLabel}
        data-retry-label={contactForm.retryLabel}
        class="cursor-pointer inline-flex items-center justify-center gap-2 rounded-md border-2 border-green bg-green px-6 py-3 text-sm font-semibold text-cream transition duration-150 ease-out hover:border-green-light hover:bg-green-light active:translate-x-[-4px] active:translate-y-[4px] active:duration-75 disabled:cursor-not-allowed disabled:opacity-60 md:text-base"
      >
        {contactForm.submitLabel}
      </button>
      <p id="contact-form-error" data-form-error class="sr-only text-sm text-error" role="alert"></p>
      <p class="max-w-md text-center text-xs text-green/75">{contactForm.disclaimer}</p>
      <a
        href="/privacidad"
        class="link-ink text-xs text-green/75 hover:text-green"
      >
        {contactForm.privacyLabel}
      </a>
    </div>
  </form>
</div>

<dialog
  id="contact-modal"
  aria-labelledby="cf-modal-title"
  aria-describedby="cf-modal-body"
  class="m-auto w-[min(90vw,28rem)] rounded-md border-2 border-green bg-cream p-8 text-green shadow-none backdrop:bg-green-dark/80"
>
  <span
    class="modal-stamp mx-auto flex h-12 w-12 items-center justify-center rounded-full border-2 border-green text-green"
    aria-hidden="true"
  >
    <CheckIcon class="h-6 w-6" />
  </span>
  <h2 id="cf-modal-title" class="mt-4 text-2xl font-bold">{contactForm.modal.title}</h2>
  <p id="cf-modal-body" class="mt-3 text-sm text-green/80">{contactForm.modal.body}</p>
  <a
    href={contactForm.modal.nextHref}
    class="mt-4 inline-block text-sm font-semibold text-green underline underline-offset-4 hover:text-green-dark"
  >
    {contactForm.modal.nextLabel}
  </a>
  <button
    id="contact-modal-close"
    type="button"
    class="mt-6 cursor-pointer inline-flex items-center justify-center gap-2 rounded-md border-2 border-green bg-green px-6 py-3 text-sm font-semibold text-cream transition duration-150 ease-out hover:border-green-light hover:bg-green-light active:translate-x-[-4px] active:translate-y-[4px] active:duration-75"
  >
    {contactForm.modal.closeLabel}
  </button>
</dialog>

<style>
  /* Both steps live in the same grid cell, so the cell always measures the
     taller step and the panel keeps its size when switching. */
  [data-service-flow] {
    display: grid;
  }

  [data-service-step],
  [data-service-form] {
    grid-area: 1 / 1;
  }

  /* Without JS step 1 does not exist: it stays hidden, and `visibility` keeps
     it out of the tab order and the accessibility tree while the form stays
     visible and reachable. */
  [data-service-step] {
    visibility: hidden;
  }

  /* With JS the form starts hidden; `data-step` defines the visible step. */
  :global(.js) [data-service-form] {
    visibility: hidden;
  }

  :global(.js) [data-service-flow][data-step="service"] [data-service-step] {
    visibility: visible;
  }

  :global(.js) [data-service-flow][data-step="form"] [data-service-form] {
    visibility: visible;
  }
</style>

<script is:inline>
  // Reset del flujo del formulario al paso 1. El paso vive en un atributo del
  // DOM, así que sobrevive a cualquier navegación que no recargue el documento:
  // un link al ancla de la sección, la vuelta desde la bfcache o un cambio de
  // hash. Se reasigna en cada page-load para apuntar siempre al form vivo.
  let resetCurrentFlow = null;

  const resetFlowSoon = () => {
    window.setTimeout(() => {
      if (resetCurrentFlow) resetCurrentFlow();
    }, 0);
  };

  // Los links a la sección del formulario van en fase de captura a propósito:
  // el router de Astro corta la propagación del click, así que un listener de
  // burbuja no llega a verlo. Cubre también el caso de tocar el mismo CTA dos
  // veces seguidas, cuando el hash no cambia y no hay ningún otro evento.
  document.addEventListener(
    "click",
    (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest("a[href]");
      if (!link) return;
      const href = link.getAttribute("href") || "";
      if (!href.endsWith("#contacto")) return;
      resetFlowSoon();
    },
    true
  );

  // La vuelta desde la bfcache restaura el DOM tal como estaba, atributo
  // incluido.
  window.addEventListener("pageshow", resetFlowSoon);

  // Un cambio de hash que no venga de un click sobre un link. Se filtra por el
  // hash del formulario para no reaccionar a las anclas del FAQ.
  window.addEventListener("hashchange", () => {
    if (window.location.hash === "#contacto") resetFlowSoon();
  });

  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form");
    if (!form) return;

    const submitButton = document.getElementById("contact-submit");
    const formErrorRegion = document.getElementById("contact-form-error");
    const modal = document.getElementById("contact-modal");
    const closeButton = document.getElementById("contact-modal-close");
    const submitLabel = submitButton.textContent;
    const submittingLabel = submitButton.dataset.submittingLabel || submitLabel;
    const retryLabel = submitButton.dataset.retryLabel || submitLabel;
    const formErrorMessage = form.dataset.formErrorMessage || "";
    const validatedFields = ["name", "email", "phone", "service"];

    const validators = {
      name: (value) => value.trim().length >= 2,
      email: (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim()),
      phone: (value) => value.trim().length === 0 || value.trim().length >= 6,
      service: (value) => value.length > 0,
    };

    const getField = (name) => form.elements.namedItem(name);

    const getValue = (name) => {
      const field = getField(name);
      return field ? field.value : "";
    };

    const setError = (name, hasError) => {
      const field = getField(name);
      const visual = form.querySelector("[data-field-visual='" + name + "']") || field;
      const error = form.querySelector("[data-error-for='" + name + "']");
      if (!field || !error) return;
      if (hasError) {
        if (visual) visual.setAttribute("aria-invalid", "true");
        error.textContent = field.dataset.errorMessage || "";
        error.classList.remove("sr-only");
      } else {
        if (visual) visual.removeAttribute("aria-invalid");
        error.textContent = "";
        error.classList.add("sr-only");
      }
    };

    const validate = () => {
      let firstInvalid = null;
      for (const name of validatedFields) {
        const valid = validators[name](getValue(name));
        setError(name, !valid);
        if (!valid && !firstInvalid) {
          firstInvalid =
            form.querySelector("[data-field-visual='" + name + "']") || getField(name);
        }
      }
      return firstInvalid;
    };

    form.addEventListener("input", (event) => {
      const target = event.target;
      if (target && validatedFields.includes(target.name)) {
        setError(target.name, false);
      }
    });

    const serviceFlow = document.querySelector("[data-service-flow]");
    const serviceStep = serviceFlow
      ? serviceFlow.querySelector("[data-service-step]")
      : null;
    const serviceOptions = serviceFlow
      ? Array.from(serviceFlow.querySelectorAll("[data-service-option]"))
      : [];
    const serviceInput = form.querySelector("input[name='service']");
    const serviceChosen = serviceFlow
      ? serviceFlow.querySelector("[data-service-chosen]")
      : null;
    const serviceChange = serviceFlow
      ? serviceFlow.querySelector("[data-service-change]")
      : null;

    const chooseService = (option) => {
      if (serviceInput) {
        serviceInput.value = option.dataset.value || "";
      }
      if (serviceChosen) {
        serviceChosen.textContent = option.textContent.trim();
      }
      if (serviceFlow) {
        serviceFlow.dataset.step = "form";
      }
      setError("service", false);
      if (serviceInput) {
        serviceInput.dispatchEvent(new Event("input", { bubbles: true }));
      }
      const firstField = document.getElementById("cf-name");
      if (firstField) {
        firstField.focus();
      }
    };

    const changeService = () => {
      if (serviceFlow) {
        serviceFlow.dataset.step = "service";
      }
      const current = serviceInput ? serviceInput.value : "";
      const target =
        serviceOptions.find((option) => option.dataset.value === current) ||
        serviceOptions[0];
      if (target) {
        target.focus();
      }
    };

    // Vuelve al paso 1 y limpia el servicio elegido, para que nadie pueda
    // enviar un servicio que no volvió a elegir. No toca el resto de los
    // campos: lo que el visitante ya escribió se conserva.
    const resetServiceFlow = () => {
      if (serviceInput) {
        serviceInput.value = "";
      }
      if (serviceChosen) {
        serviceChosen.textContent = "";
      }
      if (serviceFlow) {
        serviceFlow.dataset.step = "service";
      }
      setError("service", false);
    };

    resetCurrentFlow = resetServiceFlow;

    serviceOptions.forEach((option) => {
      option.addEventListener("click", () => chooseService(option));
    });

    if (serviceStep && serviceChange) {
      serviceChange.addEventListener("click", changeService);
    }

    closeButton.addEventListener("click", () => {
      if (typeof modal.showModal === "function" && modal.open) {
        modal.close();
      } else {
        modal.setAttribute("open", "");
        modal.removeAttribute("open");
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (formErrorRegion) {
        formErrorRegion.textContent = "";
        formErrorRegion.classList.add("sr-only");
      }
      const firstInvalid = validate();
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }
      submitButton.disabled = true;
      submitButton.textContent = submittingLabel;
      let failed = false;
      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });
        if (!response.ok) {
          throw new Error("web3forms submission failed");
        }
        form.reset();
        resetServiceFlow();
        if (typeof modal.showModal === "function") {
          modal.showModal();
        } else {
          modal.setAttribute("open", "");
        }
      } catch {
        failed = true;
        if (formErrorRegion) {
          formErrorRegion.textContent = formErrorMessage;
          formErrorRegion.classList.remove("sr-only");
        }
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = failed ? retryLabel : submitLabel;
      }
    });
  });
</script>
