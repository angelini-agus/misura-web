---
import { contactForm } from "../lib/content";
import CheckIcon from "./ui/CheckIcon.astro";
import ChevronDownIcon from "./ui/ChevronDownIcon.astro";

interface Props {
  simple?: boolean;
}

const { simple = false } = Astro.props;
const { web3forms } = contactForm;
---

<form id="contact-form" class="grid gap-8" novalidate>
  <input
    type="hidden"
    name="access_key"
    value={web3forms.accessKey}
  />

  <div class="grid gap-6 md:grid-cols-2">
    <div class="flex flex-col gap-2">
      <label
        for="cf-name"
        class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
      >
        {contactForm.labels.name} <span aria-hidden="true" class="text-error">*</span>
      </label>
      <input
        id="cf-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        data-error-message={contactForm.errors.name}
        placeholder={contactForm.placeholders.name}
        class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/75 aria-[invalid=true]:border-error"
      />
      <p data-error-for="name" class="hidden text-sm text-error" role="alert"></p>
    </div>

    <div class="flex flex-col gap-2">
      <label
        for="cf-company"
        class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
      >
        {contactForm.labels.company} <span class="normal-case tracking-normal text-green/75">(opcional)</span>
      </label>
      <input
        id="cf-company"
        name="company"
        type="text"
        autocomplete="organization"
        placeholder={contactForm.placeholders.company}
        class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/75"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label
        for="cf-email"
        class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
      >
        {contactForm.labels.email} <span aria-hidden="true" class="text-error">*</span>
      </label>
      <input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        data-error-message={contactForm.errors.email}
        placeholder={contactForm.placeholders.email}
        class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/75 aria-[invalid=true]:border-error"
      />
      <p data-error-for="email" class="hidden text-sm text-error" role="alert"></p>
    </div>

    <div class="flex flex-col gap-2">
      <label
        for="cf-phone"
        class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
      >
        {contactForm.labels.phone} <span aria-hidden="true" class="text-error">*</span>
      </label>
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        required
        data-error-message={contactForm.errors.phone}
        placeholder={contactForm.placeholders.phone}
        class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/75 aria-[invalid=true]:border-error"
      />
      <p data-error-for="phone" class="hidden text-sm text-error" role="alert"></p>
    </div>

    <div class="flex flex-col gap-2">
      <label
        for="cf-service"
        class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
      >
        {contactForm.labels.service} <span aria-hidden="true" class="text-error">*</span>
      </label>
      <div
        class="relative"
        data-select
        data-placeholder={contactForm.servicePlaceholder}
      >
        <button
          type="button"
          id="cf-service"
          class="flex w-full items-center justify-between gap-3 rounded-md border border-green bg-cream px-4 py-3 text-left text-sm text-green aria-[invalid=true]:border-error"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="cf-service-listbox"
          aria-required="true"
          data-select-trigger
          data-field-visual="service"
        >
          <span data-select-label class="text-green/75">
            {contactForm.servicePlaceholder}
          </span>
          <ChevronDownIcon class="h-4 w-4 shrink-0 text-green/75" />
        </button>
        <ul
          id="cf-service-listbox"
          role="listbox"
          aria-label={contactForm.labels.service}
          class="absolute inset-x-0 top-full z-20 mt-1 hidden overflow-hidden rounded-md border border-green bg-cream"
          data-select-list
        >
          {contactForm.serviceOptions.map((option) => (
            <li
              role="option"
              id={`cf-service-${option.value}`}
              aria-selected="false"
              data-select-option
              data-value={option.value}
              class="px-4 py-2.5 text-sm text-green hover:bg-green hover:text-cream"
            >
              {option.label}
            </li>
          ))}
        </ul>
        <input
          type="hidden"
          name="service"
          value=""
          data-error-message={contactForm.errors.service}
          data-select-input
        />
      </div>
      <p data-error-for="service" class="hidden text-sm text-error" role="alert"></p>
    </div>

    {!simple && (
      <div class="flex flex-col gap-2 md:col-span-2">
        <label
          for="cf-message"
          class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
        >
          {contactForm.labels.message} <span class="normal-case tracking-normal text-green/75">(opcional)</span>
        </label>
        <textarea
          id="cf-message"
          name="message"
          rows="5"
          placeholder={contactForm.placeholders.message}
          class="w-full resize-y rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/75"
        ></textarea>
      </div>
    )}
  </div>

  <div class="flex flex-col items-start gap-4">
    <button
      id="contact-submit"
      type="submit"
      class="cursor-pointer inline-flex items-center justify-center gap-2 rounded-md border-2 border-green bg-green px-6 py-3 text-sm font-semibold text-cream transition duration-150 ease-out hover:border-green-light hover:bg-green-light active:translate-x-[-4px] active:translate-y-[4px] active:duration-75 disabled:cursor-not-allowed disabled:opacity-60 md:text-base"
    >
      {contactForm.submitLabel}
    </button>
    <p class="text-xs text-green/75">{contactForm.disclaimer}</p>
  </div>
</form>

<dialog
  id="contact-modal"
  class="m-auto w-[min(90vw,28rem)] rounded-md border-2 border-green bg-cream p-8 text-green shadow-none backdrop:bg-green-dark/80"
>
  <span
    class="modal-stamp mx-auto flex h-12 w-12 items-center justify-center rounded-full border-2 border-green text-green"
    aria-hidden="true"
  >
    <CheckIcon class="h-6 w-6" />
  </span>
  <h2 class="mt-4 text-2xl font-bold">{contactForm.modal.title}</h2>
  <p class="mt-3 text-sm text-green/80">{contactForm.modal.body}</p>
  <a
    href={contactForm.modal.nextHref}
    class="mt-4 inline-block text-sm font-semibold text-green underline underline-offset-4 hover:text-green-dark"
  >
    {contactForm.modal.nextLabel}
  </a>
  <button
    id="contact-modal-close"
    type="button"
    class="mt-6 cursor-pointer inline-flex items-center justify-center gap-2 rounded-md border-2 border-green bg-green px-6 py-3 text-sm font-semibold text-cream transition duration-150 ease-out hover:border-green-light hover:bg-green-light active:translate-x-[-4px] active:translate-y-[4px] active:duration-75"
  >
    {contactForm.modal.closeLabel}
  </button>
</dialog>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form");
    if (!form) return;

    const submitButton = document.getElementById("contact-submit");
    const modal = document.getElementById("contact-modal");
    const closeButton = document.getElementById("contact-modal-close");
    const submitLabel = submitButton.textContent;
    const validatedFields = ["name", "email", "phone", "service"];

    const validators = {
      name: (value) => value.trim().length >= 2,
      email: (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim()),
      phone: (value) => value.trim().length >= 6,
      service: (value) => value.length > 0,
    };

    const getField = (name) => form.elements.namedItem(name);

    const getValue = (name) => {
      const field = getField(name);
      return field ? field.value : "";
    };

    const setError = (name, hasError) => {
      const field = getField(name);
      const visual = form.querySelector("[data-field-visual='" + name + "']") || field;
      const error = form.querySelector("[data-error-for='" + name + "']");
      if (!field || !error) return;
      if (hasError) {
        if (visual) visual.setAttribute("aria-invalid", "true");
        error.textContent = field.dataset.errorMessage || "";
        error.classList.remove("hidden");
      } else {
        if (visual) visual.removeAttribute("aria-invalid");
        error.textContent = "";
        error.classList.add("hidden");
      }
    };

    const validate = () => {
      let firstInvalid = null;
      for (const name of validatedFields) {
        const valid = validators[name](getValue(name));
        setError(name, !valid);
        if (!valid && !firstInvalid) {
          firstInvalid =
            form.querySelector("[data-field-visual='" + name + "']") || getField(name);
        }
      }
      return firstInvalid;
    };

    form.addEventListener("input", (event) => {
      const target = event.target;
      if (target && validatedFields.includes(target.name)) {
        setError(target.name, false);
      }
    });

    const select = form.querySelector("[data-select]");
    let resetSelect = () => {};

    if (select) {
      const trigger = select.querySelector("[data-select-trigger]");
      const list = select.querySelector("[data-select-list]");
      const label = select.querySelector("[data-select-label]");
      const input = select.querySelector("[data-select-input]");
      const options = Array.from(select.querySelectorAll("[data-select-option]"));
      const placeholder = select.dataset.placeholder || "";
      let activeIndex = -1;

      const isOpen = () => !list.classList.contains("hidden");

      const setActive = (index) => {
        options.forEach((option, i) => {
          option.classList.toggle("bg-green", i === index);
          option.classList.toggle("text-cream", i === index);
        });
        if (index >= 0) {
          trigger.setAttribute("aria-activedescendant", options[index].id);
        } else {
          trigger.removeAttribute("aria-activedescendant");
        }
        activeIndex = index;
      };

      const close = () => {
        list.classList.add("hidden");
        trigger.setAttribute("aria-expanded", "false");
        setActive(-1);
      };

      const open = () => {
        list.classList.remove("hidden");
        const rect = trigger.getBoundingClientRect();
        const clip = trigger.closest(".overflow-hidden");
        const limit = clip ? clip.getBoundingClientRect().bottom : window.innerHeight;
        if (limit - rect.bottom < list.offsetHeight + 8) {
          list.setAttribute("data-flip", "true");
        } else {
          list.removeAttribute("data-flip");
        }
        trigger.setAttribute("aria-expanded", "true");
        setActive(-1);
      };

      const selectOption = (option) => {
        options.forEach((item) =>
          item.setAttribute("aria-selected", String(item === option))
        );
        input.value = option.dataset.value || "";
        label.textContent = option.textContent.trim();
        label.classList.remove("text-green/75");
        input.dispatchEvent(new Event("input", { bubbles: true }));
        close();
        trigger.focus();
      };

      resetSelect = () => {
        options.forEach((item) => item.setAttribute("aria-selected", "false"));
        input.value = "";
        label.textContent = placeholder;
        label.classList.add("text-green/75");
        close();
      };

      select.__closeSelect = close;

      trigger.addEventListener("click", () => {
        if (isOpen()) {
          close();
        } else {
          open();
        }
      });

      trigger.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          if (!isOpen()) {
            open();
            return;
          }
          if (activeIndex === -1) {
            setActive(event.key === "ArrowDown" ? 0 : options.length - 1);
            return;
          }
          const delta = event.key === "ArrowDown" ? 1 : -1;
          setActive((activeIndex + delta + options.length) % options.length);
        } else if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          if (!isOpen()) {
            open();
            return;
          }
          if (activeIndex >= 0) selectOption(options[activeIndex]);
        } else if (event.key === "Escape") {
          if (isOpen()) {
            event.preventDefault();
            close();
          }
        } else if (event.key === "Home" || event.key === "End") {
          if (!isOpen()) return;
          event.preventDefault();
          setActive(event.key === "Home" ? 0 : options.length - 1);
        } else if (event.key === "Tab") {
          close();
        }
      });

      options.forEach((option) => {
        option.addEventListener("click", () => selectOption(option));
      });

      if (!document.documentElement.dataset.selectOutside) {
        document.documentElement.dataset.selectOutside = "true";
        document.addEventListener("click", (event) => {
          const wrapper = document.querySelector("[data-select]");
          if (!wrapper || wrapper.contains(event.target)) return;
          if (typeof wrapper.__closeSelect === "function") wrapper.__closeSelect();
        });
      }
    }

    closeButton.addEventListener("click", () => {
      if (typeof modal.showModal === "function" && modal.open) {
        modal.close();
      } else {
        modal.setAttribute("open", "");
        modal.removeAttribute("open");
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const firstInvalid = validate();
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }
      submitButton.disabled = true;
      submitButton.textContent = "Enviando...";
      let failed = false;
      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });
        if (!response.ok) {
          throw new Error("web3forms submission failed");
        }
        form.reset();
        resetSelect();
        if (typeof modal.showModal === "function") {
          modal.showModal();
        } else {
          modal.setAttribute("open", "");
        }
      } catch {
        failed = true;
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = failed ? "Reintentar" : submitLabel;
      }
    });
  });
</script>
