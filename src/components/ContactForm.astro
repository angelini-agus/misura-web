---
import { contactForm } from "../lib/content";

interface Props {
  simple?: boolean;
}

const { simple = false } = Astro.props;
const { web3forms } = contactForm;
---

<form id="contact-form" class="grid gap-8">
  <input
    type="hidden"
    name="access_key"
    value={web3forms.accessKey}
  />

  <div class="grid gap-6 md:grid-cols-2">
    <div class="flex flex-col gap-2">
      <label
        for="cf-name"
        class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
      >
        {contactForm.labels.name} <span aria-hidden="true">*</span>
      </label>
      <input
        id="cf-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        placeholder={contactForm.placeholders.name}
        class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/50 focus:outline-none"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label
        for="cf-company"
        class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
      >
        {contactForm.labels.company}
      </label>
      <input
        id="cf-company"
        name="company"
        type="text"
        autocomplete="organization"
        placeholder={contactForm.placeholders.company}
        class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/50 focus:outline-none"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label
        for="cf-email"
        class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
      >
        {contactForm.labels.email} <span aria-hidden="true">*</span>
      </label>
      <input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        placeholder={contactForm.placeholders.email}
        class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/50 focus:outline-none"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label
        for="cf-phone"
        class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
      >
        {contactForm.labels.phone} <span aria-hidden="true">*</span>
      </label>
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        required
        placeholder={contactForm.placeholders.phone}
        class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/50 focus:outline-none"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label
        for="cf-service"
        class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
      >
        {contactForm.labels.service}
      </label>
      <select
        id="cf-service"
        name="service"
        class="w-full rounded-md border border-green bg-cream px-4 py-3 text-sm text-green focus:outline-none"
      >
        <option value="" disabled selected>
          {contactForm.servicePlaceholder}
        </option>
        {contactForm.serviceOptions.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    </div>

    {!simple && (
      <div class="flex flex-col gap-2 md:col-span-2">
        <label
          for="cf-message"
          class="text-xs font-semibold uppercase tracking-[0.2em] text-green"
        >
          {contactForm.labels.message}
        </label>
        <textarea
          id="cf-message"
          name="message"
          rows="5"
          placeholder={contactForm.placeholders.message}
          class="w-full resize-y rounded-md border border-green bg-cream px-4 py-3 text-sm text-green placeholder:text-green/50 focus:outline-none"
        ></textarea>
      </div>
    )}
  </div>

  <div class="flex flex-col items-start gap-4">
    <button
      id="contact-submit"
      type="submit"
      class="inline-flex items-center justify-center gap-2 rounded-md border-2 border-green bg-green px-6 py-3 text-sm font-semibold text-cream transition-transform duration-150 ease-out hover:bg-green-dark active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-60 md:text-base"
    >
      {contactForm.submitLabel}
    </button>
    <p class="text-xs text-green/60">{contactForm.disclaimer}</p>
  </div>
</form>

<dialog
  id="contact-modal"
  class="m-auto w-[min(90vw,28rem)] rounded-md border-2 border-green bg-cream p-8 text-green shadow-none backdrop:bg-green-dark/80"
>
  <h2 class="text-2xl font-bold">{contactForm.modal.title}</h2>
  <p class="mt-3 text-sm text-green/80">{contactForm.modal.body}</p>
  <button
    id="contact-modal-close"
    type="button"
    class="mt-6 inline-flex items-center justify-center gap-2 rounded-md border-2 border-green bg-green px-6 py-3 text-sm font-semibold text-cream transition-colors duration-150 ease-out hover:bg-green-dark"
  >
    {contactForm.modal.closeLabel}
  </button>
</dialog>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form");
    if (!form) return;

    const submitButton = document.getElementById("contact-submit");
    const modal = document.getElementById("contact-modal");
    const closeButton = document.getElementById("contact-modal-close");
    const submitLabel = submitButton.textContent;

    closeButton.addEventListener("click", () => {
      if (typeof modal.showModal === "function" && modal.open) {
        modal.close();
      } else {
        modal.setAttribute("open", "");
        modal.removeAttribute("open");
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      submitButton.disabled = true;
      submitButton.textContent = "Enviando...";
      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });
        if (!response.ok) {
          throw new Error("web3forms submission failed");
        }
        form.reset();
        if (typeof modal.showModal === "function") {
          modal.showModal();
        } else {
          modal.setAttribute("open", "");
        }
      } catch {
        submitButton.textContent = "Reintentar";
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = submitLabel;
      }
    });
  });
</script>
