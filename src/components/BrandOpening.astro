---
import { dictionaryEntry } from "../lib/content";
import BrandSenses from "./BrandSenses.astro";

// La apertura de marca: el wordmark a gran escala y centrado con su fonetica y
// su categoria debajo, en tipografia de maquina de escribir. Es una seccion en
// si misma, arriba del hero, y no un bloque adentro: el hero mide una pantalla
// con su propio piso por alto de ventana y la apertura tiene el suyo.
//
// En pantallas horizontales la apertura se queda con lo que sobra de la primera
// ventana despues del anuncio y el navbar, asi que los tres bloques juntos suman
// `100svh` exactos y el hero empieza recien abajo del pliegue. En vertical (y en
// las ventanas bajas, donde el piso no se alcanza) la seccion mide lo que mide su
// contenido, como siempre.
//
// El wordmark se queda en su tamano maximo (los 12rem del tope, unos 685px de
// caja) sin importar el alto de la ventana: lo unico que se compacta por alto es
// el aire (ver el `<style>` de abajo).
---

<section class="brand-opening scroll-mt-24">
  <div class="mx-auto max-w-6xl mt-[var(--apertura-bajada)] px-4 py-[var(--apertura-aire)] md:px-6">
    {/* `md:w-min`: en escritorio el ancho del grupo lo fija el wordmark y la
        entrada del diccionario se estira a esa misma medida, asi que el bloque de
        texto queda del ancho de la palabra y no de los 1104px del contenedor. En
        celular y tablet sigue en `w-full` (el `min-content` del envoltorio mediria
        lo que el wordmark, mas angosto que el contenedor) para no cambiar nada de
        lo que ya habia. */}
    <div
      class="mx-auto flex w-full flex-col items-center text-center md:w-min"
      data-reveal="blur"
    >
      {/* Sin `select-none`: el wordmark es texto y se tiene que poder seleccionar.
          Aunque este elemento esta en `opacity: 0` (el que se ve es el gemelo del
          navbar, que viaja sobre este), es el que recibe el mouse: el del header
          lleva `pointer-events: none` justamente para no interceptar nada con su
          caja, asi que el arrastre aterriza aca y la seleccion funciona. */}
      <span class="wordmark wordmark-hero" data-brand-wordmark
        >{dictionaryEntry.word}</span
      >
      {/* `mt-10` y no un margen corto: con line-height 1 la caja del wordmark corta
          la tinta, asi que el descendente de la "g" baja 2,5px por debajo de la
          caja y el hueco real entre la letra y la entrada es siempre menor que
          el margen. Medido: con 12px quedaba en 9,5px (se veian pegadas), con
          24px en 21,5px, y con 40px queda en 37,5px. */}
      <div class="mt-[var(--apertura-gap)] w-full">
        <BrandSenses />
      </div>
    </div>
  </div>
</section>

<style>
  /* El aire de la apertura sale de variables y no de un `py` fijo: la franja de
     pantalla se queda con la ventana entera en las pantallas horizontales, y ahi
     el aire lo reparte el centrado, asi que el unico tramo que necesita un numero
     es el de abajo (vertical y ventanas bajas), donde la seccion mide lo que mide
     su contenido. El valor de cada breakpoint es el que daba la escala de
     Tailwind (`py-16` / `sm:py-20` / `md:py-28`) y el hueco entre el wordmark y
     la entrada va por la misma via (40px, el `mt-10` de antes). */
  .brand-opening {
    --apertura-aire: 4rem;
    --apertura-gap: 2.5rem;
    /* El descenso del grupo: 0 fuera de la franja centrada de escritorio. */
    --apertura-bajada: 0;
  }

  @media (min-width: 40rem) {
    .brand-opening {
      --apertura-aire: 5rem;
    }
  }

  @media (min-width: 48rem) {
    .brand-opening {
      --apertura-aire: 7rem;
    }
  }

  /* Pantallas horizontales: el anuncio, el navbar y la apertura se quedan con la
     primera ventana entera. La seccion mide `100svh` menos el bloque de arriba
     (los mismos `--announcement-h` + `--nav-h` que usa el resto del sitio) y su
     contenido se centra EN LA VENTANA, no en la franja que queda debajo del
     header: por eso el relleno de abajo es exactamente el alto del bloque de
     arriba, que es el que corre el centro hacia arriba. Sin ese relleno el
     wordmark queda centrado el solo y la entrada del diccionario cae muy abajo.

     El aire de la entrada se pone en cero adentro de esta franja porque el
     centrado ya lo reparte: sumarle los 7rem de abajo inflaria el alto natural de
     la seccion (contenido + 224) y el piso subiria otros 224px.

     `min-height` y no `height`: si el contenido no entra, la seccion crece y la
     pagina scrollea como siempre, en vez de recortar o pisar el header.

     Los numeros estan medidos. El contenido son 323px (wordmark 192 de caja +
     hueco 40 + entrada 91) y el bloque de arriba 113px (anuncio 36 + navbar 77).
     El piso de 507px es donde el contenido, centrado en la ventana, deja la TINTA
     del wordmark justo debajo del header: la caja arranca 21px antes que su tinta
     (medido), asi que la cuenta es `507/2 - 323/2 + 21 = 113`. Con ventanas mas
     bajas la seccion crece (el grupo se corre para abajo del header en vez de
     meterse atras) y la pagina scrollea los pixeles que sobren: a 540 son 9px.

     El ancho de celular y tablet queda afuera por la condicion de ancho, y una
     ventana de escritorio mas alta que ancha tambien. */
  @media (orientation: landscape) and (min-width: 48rem) and (min-height: 507px) {
    .brand-opening {
      --apertura-aire: 0;
      display: grid;
      min-height: calc(100svh - var(--announcement-h) - var(--nav-h));
      padding-bottom: calc(var(--announcement-h) + var(--nav-h));
      align-content: center;
    }
  }

  /* Ventanas horizontales bajas, por debajo del piso de arriba: ahi vuelve el
     alto natural (el aire de la escala) y lo unico que se recorta es ese aire,
     para que la entrada no quede cortada por el pliegue. El corte esta medido
     contra el alto del contenido, que es lo que no se toca: los 1rem entran desde
     `16 + 323 + 113 = 452`. El rango arranca ahi a proposito: mas abajo manda el
     alto de siempre, que es lo que deja intacto al celular acostado (390px). */
  @media (orientation: landscape) and (min-width: 48rem) and (min-height: 452px) and (max-height: 506px) {
    .brand-opening {
      --apertura-aire: 1rem;
    }
  }

  /* El descenso del grupo (pedido del autor: el wordmark baja un poco de su
     centro exacto). Solo en la franja centrada de escritorio y con holgura
     comprobada: en un grid con `align-content: center` un margin extra del
     contenido hace que el contenido baje LA MITAD del margin (el track crece y
     el centrado reparte el resto), asi que 3rem de margin son 1.5rem netos
     (24px). El umbral de 540px (un escalon de la matriz de alturas del sitio)
     deja 28px de aire arriba y abajo del contenido en el piso del tramo: mas
     abajo no baja, porque entre 507 y 539 la entrada ya queda pegada al
     pliegue. El viaje al navbar y la impresion del preload miden el wordmark
     por offsetTop (posicion de layout), asi que siguen el descenso sin cambios
     en sus scripts: el relevo y la impresion no saltan ni un pixel. */
  @media (orientation: landscape) and (min-width: 48rem) and (min-height: 540px) {
    .brand-opening {
      --apertura-bajada: 3rem;
    }
  }
</style>

<script>
  let cleanupMorph: (() => void) | undefined;

  // El wordmark de la apertura viaja hasta el navbar mientras se scrollea: un
  // solo logo visible en todo momento, sin que aparezca duplicado al llegar
  // arriba.
  const initLogoMorph = () => {
    cleanupMorph?.();
    cleanupMorph = undefined;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    const brandWordmark = document.querySelector<HTMLElement>(
      "[data-brand-wordmark]",
    );
    const headerLogo = document.querySelector<HTMLElement>(
      "[data-header-logo]",
    );
    const headerLogoLink = document.querySelector<HTMLAnchorElement>(
      "[data-header-logo-link]",
    );

    // En cualquier pagina que no sea la home no hay wordmark de apertura, asi
    // que el script no tiene nada que animar y sale sin tocar el header.
    if (!brandWordmark || !headerLogo || !headerLogoLink) return;

    let heroDocLeft = 0;
    let heroDocTop = 0;
    let heroWidth = 0;
    let targetWidth = 0;
    let layoutWidth = 0;
    let scaleInicio = 1;
    let scaleFin = 1;
    let announcementH = 0;
    let headerStickyTopOffset = 0;
    let headerRestX = 0;
    let travelDistance = 1;
    let currentProgress = 0;
    let isAtRest = false;

    // Quien manda con el scroll en cero: mientras el viaje no arranco se ve el
    // wordmark de la apertura, que es el que recibe el mouse y por lo tanto el
    // que se puede seleccionar con su resaltado a la vista; desde el primer
    // pixel de scroll manda el gemelo del navbar, que es el que viaja. Arranca
    // en `true` a proposito, para que el primer `setRelevo(false)` del init
    // siempre escriba el estado (sin JS los dos quedan visibles, cada uno en su
    // lugar, que es como se veia el logo de imagen antes).
    let mandaElNavbar = true;

    // Los dos ocupam la misma posicion con el scroll en cero, asi que el cambio
    // de mando no se ve. El que manda es tambien el que recibe el mouse: el de la
    // apertura al principio (para poder seleccionar el wordmark grande, con el
    // resaltado a la vista) y el del navbar desde el primer pixel de scroll. El
    // otro queda con `pointer-events: none`, porque su caja de layout mide 628px
    // y taparia el contenido de alrededor. El flag evita escribir en el DOM en
    // cada frame.
    const setRelevo = (alNavbar: boolean) => {
      if (mandaElNavbar === alNavbar) return;
      mandaElNavbar = alNavbar;
      brandWordmark.style.opacity = alNavbar ? "0" : "";
      headerLogo.style.opacity = alNavbar ? "" : "0";
      brandWordmark.style.pointerEvents = alNavbar ? "none" : "";
      headerLogo.style.pointerEvents = alNavbar ? "" : "none";
    };

    // Posicion de LAYOUT de un elemento, no la pintada: `getBoundingClientRect`
    // incluye los transforms de las animaciones de reveal (`data-reveal` mueve
    // el contenido con translateY durante ~600ms despues de cargar la pagina), y
    // medir ahi dejaba el viaje 16px abajo: al arrancar, la caja del wordmark ya
    // estaba en su lugar pero su rect devolvia 16px mas. Sumando `offsetTop` y
    // `offsetLeft` por la cadena de `offsetParent` se obtiene la posicion real
    // del flujo, que es la misma desde el primer pintado y no depende de en que
    // momento del reveal se mida.
    const offsetDoc = (el: HTMLElement) => {
      let x = 0;
      let y = 0;
      let node: HTMLElement | null = el;
      while (node) {
        x += node.offsetLeft;
        y += node.offsetTop;
        node = node.offsetParent as HTMLElement | null;
      }
      return { x, y };
    };

    // El texto del navegador se rasteriza donde cae, y con `line-height: 1` el
    // baseline queda a medio pixel: medido en la apertura, el half-leading da
    // -24,5px y el baseline cae en 152,5px dentro de la caja. Encima, el texto
    // mide 628,1px (no entero), asi que al centrarlo la x queda en 405,95. Con
    // las dos coordenadas a mitad de camino, cada borde vertical del asta se
    // reparte entre dos columnas de pixeles y el wordmark se ve con halo (medido
    // con la captura ampliada: alineado, el borde izquierdo de la b queda duro).
    // El ajuste se calcula en vez de fijarse a mano porque depende del ancho del
    // texto y del tamano de fuente, que cambian con el viewport.
    const alinearALaGrilla = () => {
      brandWordmark.style.transform = "";
      const rect = brandWordmark.getBoundingClientRect();
      const cs = getComputedStyle(brandWordmark);
      const ctx = document.createElement("canvas").getContext("2d");
      if (!ctx) return;
      ctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
      const t = ctx.measureText(brandWordmark.textContent || "");
      const lh = parseFloat(cs.lineHeight);
      const baselineLocal =
        (lh - (t.fontBoundingBoxAscent + t.fontBoundingBoxDescent)) / 2 +
        t.fontBoundingBoxAscent;
      const baseline = rect.top + baselineLocal;
      const dx = Math.round(rect.x) - rect.x;
      const dy = Math.round(baseline) - baseline;
      brandWordmark.style.transform = `translate(${dx.toFixed(5)}px, ${dy.toFixed(5)}px)`;
    };

    const measure = () => {
      const scrollY = window.scrollY;
      const linkRect = headerLogoLink.getBoundingClientRect();
      const brandRect = brandWordmark.getBoundingClientRect();
      const brandDoc = offsetDoc(brandWordmark);

      heroDocLeft = brandDoc.x;
      heroDocTop = brandDoc.y;
      heroWidth = brandWordmark.offsetWidth || brandRect.width;

      // El logo que viaja mide lo mismo en la apertura y en el navbar, y el
      // navbar lo muestra achicado con el transform: el navegador nunca agranda
      // nada.
      layoutWidth = headerLogo.offsetWidth || 628;
      targetWidth = headerLogoLink.offsetWidth || linkRect.width;
      if (targetWidth <= 0 || heroWidth <= 0 || layoutWidth <= 0) return;

      scaleInicio = heroWidth / layoutWidth;
      scaleFin = targetWidth / layoutWidth;

      const announcementBar = document.querySelector<HTMLElement>(".announcement-bar");
      announcementH = announcementBar ? announcementBar.offsetHeight : 0;

      headerStickyTopOffset = linkRect.top - Math.max(0, announcementH - scrollY);
      headerRestX = linkRect.left;

      // La distancia de scroll hasta que el wordmark cruza el nivel del header
      travelDistance = Math.max(1, heroDocTop - (headerStickyTopOffset + announcementH));

      alinearALaGrilla();
      update();
    };

    const update = () => {
      const scrollY = window.scrollY;
      const currentAnnouncement = Math.max(0, announcementH - scrollY);
      const currentHeaderRestY = currentAnnouncement + headerStickyTopOffset;
      const currentHeroY = heroDocTop - scrollY;

      // Progreso de 0 (arriba de todo) a 1 (apoyado en el navbar)
      const rawProgress = scrollY / travelDistance;
      const progress = Math.min(1, Math.max(0, rawProgress));
      currentProgress = progress;

      // Queda anotado si el wordmark grande todavia domina la pantalla. Lo lee el
      // script del header para saber si, al navegar a otra pagina, el logo tiene
      // que llegar viajando desde aca. El umbral es tolerante a proposito: con el
      // trackpad es casi imposible dejar el scroll en cero exacto (medido: con 5px
      // de residuo el logo ya no viajaba), y unos pocos pixeles no cambian nada de
      // lo que se ve. Con un cuarto del recorrido hecho el wordmark sigue mas
      // cerca de su lugar que del navbar.
      (window as Window & { __bottegaEnApertura?: boolean }).__bottegaEnApertura =
        progress < 0.25;

      // Con el scroll en cero el logo vuelve a la apertura, donde se puede
      // seleccionar
      setRelevo(progress > 0);

      if (progress >= 1) {
        if (!isAtRest) {
          headerLogo.style.transform = `translate(0px, 0px) scale(${scaleFin.toFixed(4)})`;
          headerLogo.style.willChange = "auto";
          isAtRest = true;
        }
        return;
      }

      isAtRest = false;

      // Interpolacion directa y fluida (60/120 FPS sin reflow)
      const scale = scaleInicio + (scaleFin - scaleInicio) * progress;
      const targetX = heroDocLeft * (1 - progress) + headerRestX * progress;
      const targetY = currentHeroY * (1 - progress) + currentHeaderRestY * progress;

      const dx = targetX - headerRestX;
      const dy = targetY - currentHeaderRestY;

      headerLogo.style.transformOrigin = "0 0";
      // Transform 2D y sin `will-change`: con translate3d el navegador promueve
      // el logo a su propia capa, la rasteriza una vez y despues escala ese mapa
      // de bits, que es lo que lo hacia ver borroso mientras viajaba (medido: la
      // energia de bordes a mitad del viaje caia un 33%, de 7.97 a 5.36). En 2D y
      // sin promocion, el navegador repinta el texto en cada frame a la escala
      // real.
      headerLogo.style.transform = `translate(${dx.toFixed(2)}px, ${dy.toFixed(2)}px) scale(${scale.toFixed(4)})`;
    };

    // Con el scroll en cero manda el wordmark de la apertura, que es el que
    // recibe el mouse: asi se puede seleccionar y el resaltado se ve.
    setRelevo(false);

    // Si hacen clic en el logo mientras aun esta en la apertura, no navegar
    const onLinkClick = (event: MouseEvent) => {
      if (currentProgress < 0.85) {
        event.preventDefault();
      }
    };
    headerLogoLink.addEventListener("click", onLinkClick);

    let scrollRaf = 0;
    const onScroll = () => {
      if (!scrollRaf) {
        scrollRaf = window.requestAnimationFrame(() => {
          scrollRaf = 0;
          update();
        });
      }
    };

    let resizeTimer = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(measure, 50);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
    // Red de seguridad: el evento `load` de la ventana vuelve a medir cuando ya
    // terminaron de asentarse las imagenes y el primer layout. El ancho del
    // wordmark puede cambiar entre el primer pintado y `load`, asi que no
    // alcanza con medir una sola vez al arrancar.
    window.addEventListener("load", measure);

    // Medir de inmediato y otra vez cuando la tipografia del wordmark termina de
    // cargar: Lora cambia el ancho de la caja y el viaje se mide contra ese
    // ancho.
    measure();
    document.fonts?.ready.then(measure).catch(() => {});

    cleanupMorph = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onResize);
      window.removeEventListener("load", measure);
      headerLogoLink.removeEventListener("click", onLinkClick);
      if (scrollRaf) window.cancelAnimationFrame(scrollRaf);
      window.clearTimeout(resizeTimer);

      // Se vuelve al transform por defecto de la hoja (la escala del navbar), no
      // a "none": el wordmark mide 628px de layout y sin escala se veria
      // gigante.
      headerLogo.style.transform = `scale(${scaleFin.toFixed(4)})`;
      headerLogo.style.transformOrigin = "";
      headerLogo.style.willChange = "";
      headerLogo.style.opacity = "";
      headerLogo.style.pointerEvents = "";
      brandWordmark.style.transform = "";
      brandWordmark.style.opacity = "";
      brandWordmark.style.pointerEvents = "";
    };
  };

  document.addEventListener("astro:page-load", initLogoMorph);
  document.addEventListener("astro:before-swap", () => {
    cleanupMorph?.();
  });
  initLogoMorph();
</script>
