---
import { differentiators } from "../lib/content";
---

<section id="diferenciales" class="scroll-mt-24 border-t border-green">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <div
      class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      data-reveal
    >
      <div class="max-w-xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em]">
          {differentiators.eyebrow}
        </p>
        <h2
          class="font-display mt-3 text-3xl font-medium leading-tight tracking-tight sm:text-4xl"
        >
          {differentiators.title}
        </h2>
      </div>
      <p class="max-w-sm leading-relaxed text-green/80">
        {differentiators.subtitle}
      </p>
    </div>
    <div class="mt-12 grid gap-px border border-green bg-green md:grid-cols-3">
      {differentiators.items.map((item, index) => (
        <article
          class="bg-cream p-6"
          data-reveal
          style={{ transitionDelay: `${index * 60}ms` }}
        >
          <span class="font-mono text-sm">{`0${index + 1}`}</span>
          <h3 class="font-display mt-4 text-xl font-medium">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-green/80">
            {item.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
