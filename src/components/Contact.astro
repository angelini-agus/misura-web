---
import { contact, isPending } from "../lib/content";
import Button from "./ui/Button.astro";
import Placeholder from "./ui/Placeholder.astro";

const emailHref = isPending(contact.email) ? null : `mailto:${contact.email}`;
const whatsappHref = isPending(contact.whatsapp)
  ? null
  : `https://wa.me/${contact.whatsapp}`;
const primaryHref = emailHref ?? whatsappHref;
---

<section id="contacto" class="scroll-mt-24 border-t border-green">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <div
      class="flex flex-col items-center border border-green bg-green px-6 py-16 text-center md:py-24"
      data-reveal
    >
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cream">
        {contact.eyebrow}
      </p>
      <h2
        class="font-display mt-4 max-w-2xl text-3xl font-medium leading-tight tracking-tight text-cream sm:text-5xl"
      >
        {contact.title}
      </h2>
      <p class="mt-5 max-w-xl leading-relaxed text-cream/75">
        {contact.description}
      </p>
      <div class="mt-10">
        {primaryHref ? (
          <Button
            href={primaryHref}
            variant="cream"
            class="uppercase tracking-[0.2em]"
          >
            {contact.ctaLabel}
          </Button>
        ) : (
          <Placeholder inverse label={`${contact.ctaLabel} · enlace [PENDIENTE]`} />
        )}
      </div>
      <div
        class="mt-10 flex flex-col items-center gap-3 text-sm text-cream/75 sm:flex-row sm:gap-8"
      >
        {emailHref ? (
          <a href={emailHref} class="underline underline-offset-4">
            {contact.email}
          </a>
        ) : (
          <span>{contact.email}</span>
        )}
        {whatsappHref ? (
          <a href={whatsappHref} class="underline underline-offset-4">
            {contact.whatsapp}
          </a>
        ) : (
          <span>{contact.whatsapp}</span>
        )}
      </div>
    </div>
  </div>
</section>
