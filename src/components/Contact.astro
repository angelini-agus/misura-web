---
import { contact, isPending } from "../lib/content";
import ContactForm from "./ContactForm.astro";
import Placeholder from "./ui/Placeholder.astro";

const emailHref = isPending(contact.email) ? null : `mailto:${contact.email}`;
---

<section id="contacto" class="scroll-mt-24 border-t border-green">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <div class="grid overflow-hidden rounded-lg border border-green md:grid-cols-2" data-reveal>
      <div class="flex flex-col justify-center gap-8 bg-green p-6 text-cream md:p-12">
        <div class="flex flex-col gap-4">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cream">
            {contact.eyebrow}
          </p>
          <h2
            class="font-display max-w-md text-3xl font-medium leading-tight tracking-tight text-cream sm:text-4xl"
          >
            {contact.title}
          </h2>
          <p class="max-w-md leading-relaxed text-cream/75">
            {contact.description}
          </p>
        </div>
        <ul class="flex flex-col gap-3 text-sm text-cream/75">
          <li>
            {emailHref ? (
              <a href={emailHref} class="underline underline-offset-4">
                {contact.email}
              </a>
            ) : (
              <Placeholder inverse label="Email [PENDIENTE]" />
            )}
          </li>
          {contact.socials.map((social) => (
            <li>
              {isPending(social.url) ? (
                <Placeholder inverse label={`${social.label} [PENDIENTE]`} />
              ) : (
                <a href={social.url} class="underline underline-offset-4">
                  {social.label}
                </a>
              )}
            </li>
          ))}
          {contact.locationItems.map((item) => (
            <li>
              <span class="inline-flex items-center rounded-md border-2 border-dashed border-cream px-2 py-1 font-mono text-xs tracking-widest text-cream">
                {item.label} [{item.value}]
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-cream p-6 md:p-12">
        <ContactForm />
      </div>
    </div>
  </div>
</section>
