---
import { stickyCta } from "../lib/content";
import Button from "./ui/Button.astro";
---

<aside
  aria-label={stickyCta.ariaLabel}
  class="fixed inset-x-0 bottom-0 z-40 border-t border-green bg-cream p-3 md:hidden"
>
  <div class="mx-auto w-full max-w-6xl">
    <Button href={stickyCta.href} class="w-full">
      {stickyCta.label}
    </Button>
  </div>
</aside>
