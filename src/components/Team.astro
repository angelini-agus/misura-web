---
import { team, isPending } from "../lib/content";
import { Image } from "astro:assets";
import teamPlaceholder from "../assets/team-placeholder.png";
import GithubIcon from "./ui/GithubIcon.astro";
import LinkedinIcon from "./ui/LinkedinIcon.astro";
import Placeholder from "./ui/Placeholder.astro";

const socialIcons = { linkedin: LinkedinIcon, github: GithubIcon } as const;
---

{/*
  Sección de una pantalla: de `lg` para arriba mide exactamente
  `100dvh - --nav-h`. El encabezado entra arriba de las tarjetas, en una fila
  (eyebrow y título a la izquierda, descripción a la derecha: el mismo patrón que
  usa "Cómo trabajamos"), y las 2 tarjetas van centradas abajo. La fila del
  encabezado ocupa alto, así que la foto lo paga: su fórmula descuenta las 3rem
  del padding de la sección, los 4.5rem de esa fila y los 17.5rem del bloque de
  texto de la tarjeta. En mobile la sección no entra en una pantalla y apila: el
  `min-h` la deja crecer, no la recorta.
*/}
<section id="nosotros" class="scroll-mt-24 border-t border-green">
  <div
    class="mx-auto flex min-h-[calc(100dvh-var(--nav-h))] max-w-6xl flex-col justify-center px-4 py-[clamp(1.5rem,4dvh,3rem)] md:px-6"
  >
    <div
      class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      data-reveal
    >
      <div class="max-w-xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em]">
          {team.eyebrow}
        </p>
        <h2
          class="font-display mt-3 text-3xl font-medium leading-tight tracking-tight sm:text-4xl"
        >
          {team.title}
        </h2>
      </div>
      <p class="max-w-sm leading-relaxed text-green/80">{team.description}</p>
    </div>
    <div class="mx-auto mt-6 grid w-full max-w-3xl grid-cols-1 gap-6 sm:grid-cols-2">
      {team.members.map((member) => (
        <article
          class="flex flex-col overflow-hidden rounded-md border border-green bg-green text-cream transition-colors hover:border-green-dark"
        >
          {/* Placeholder photo shared by every member: decorative, so alt is empty.
              When real per-member photos replace the placeholder, describe the photo
              instead of repeating the member name, which is already the adjacent h3.
              El duotono envuelve solo la foto: si cubriera la tarjeta entera,
              también teñiría el nombre y el texto de abajo. La imagen va absoluta
              dentro del marco porque el alto del marco lo decide la fórmula del
              viewport, no la imagen: así el recorte lo hace object-cover. */}
          <div
            class="foto-duotono h-[22rem] lg:h-[min(30rem,calc(100dvh-var(--nav-h)-27rem))]"
          >
            <Image
              src={teamPlaceholder}
              alt=""
              widths={[400, 800]}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="flex flex-1 flex-col gap-2 border-t border-green p-5 md:p-6">
            <h3 class="font-display text-xl font-medium">{member.name}</h3>
            <p class="font-mono text-xs uppercase tracking-widest text-cream/70">
              {member.role}
            </p>
            <p class="mt-1 text-sm leading-relaxed text-cream/80">
              {member.description}
            </p>
            <div class="mt-auto flex flex-wrap gap-2.5 pt-4">
              {Object.entries(team.socialLabels).map(([key, label]) => {
                const href =
                  member.socials[key as keyof typeof member.socials];
                const Icon =
                  socialIcons[key as keyof typeof socialIcons];
                return href && !isPending(href) ? (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${label} de ${member.name}`}
                    class="inline-flex flex-1 items-center justify-center gap-2 rounded-md border border-cream/50 px-3.5 py-2 text-sm font-semibold text-cream transition duration-150 ease-out hover:border-cream hover:bg-cream hover:text-green active:translate-x-[-4px] active:translate-y-[4px] active:duration-75"
                  >
                    <Icon class="social-icon h-4 w-4 shrink-0" />
                    {label}
                  </a>
                ) : (
                  <Placeholder inverse label={`${label} [PENDIENTE]`} />
                );
              })}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
