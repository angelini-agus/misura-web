---
import { team, isPending } from "../lib/content";
import { Image } from "astro:assets";
import teamPlaceholder from "../assets/team-placeholder.png";
import Placeholder from "./ui/Placeholder.astro";
---

<section id="equipo" class="scroll-mt-24 border-t border-green">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <div class="max-w-xl" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.2em]">
        {team.eyebrow}
      </p>
      <h2
        class="font-display mt-3 text-3xl font-medium leading-tight tracking-tight sm:text-4xl"
      >
        {team.title}
      </h2>
      <p class="mt-4 leading-relaxed text-green/80">{team.description}</p>
    </div>
    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {team.members.map((member, index) => (
        <article
          class="flex flex-col border border-green"
          data-reveal
          style={{ transitionDelay: `${index * 60}ms` }}
        >
          <Image
            src={teamPlaceholder}
            alt={member.name}
            widths={[400]}
            sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
            class="aspect-[4/5] w-full object-cover grayscale"
            loading="lazy"
          />
          <div class="flex flex-1 flex-col gap-2 border-t border-green p-6">
            <h3 class="font-display text-xl font-medium">{member.name}</h3>
            <p class="font-mono text-xs uppercase tracking-widest text-green/70">
              {member.role}
            </p>
            <p class="mt-1 text-sm leading-relaxed text-green/80">
              {member.description}
            </p>
            <div class="mt-auto flex flex-wrap gap-3 pt-4">
              {Object.entries(team.socialLabels).map(([key, label]) => {
                const href =
                  member.socials[key as keyof typeof member.socials];
                return href && !isPending(href) ? (
                  <a
                    href={href}
                    class="text-sm underline underline-offset-4 hover:text-green-dark"
                  >
                    {label}
                  </a>
                ) : (
                  <Placeholder label={`${label} [PENDIENTE]`} />
                );
              })}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
