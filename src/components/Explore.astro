---
import { explore } from "../lib/content";
import MisureWord from "./ui/MisureWord.astro";
---

<section id="explorar" class="scroll-mt-24 border-t border-green">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <div class="max-w-xl" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.2em]">
        <MisureWord text={explore.eyebrow} />
      </p>
      <h2
        class="font-display mt-3 text-3xl font-medium leading-tight tracking-tight sm:text-4xl"
      >
        {explore.title}
      </h2>
      <p class="mt-4 leading-relaxed text-green/80">{explore.description}</p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {explore.items.map((item, index) => (
        <a
          href={item.href}
          class="group flex flex-col rounded-md border border-green bg-green p-6 text-cream transition-colors hover:bg-green-dark"
          data-reveal
          style={{ transitionDelay: `${index * 60}ms` }}
        >
          <h3 class="font-display text-xl font-medium">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-cream/80">
            {item.description}
          </p>
          <span class="mt-6 inline-block text-xs font-semibold uppercase tracking-[0.2em] underline underline-offset-4">
            {item.cta}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
