---
import { contact, footer, isPending, nav, site } from "../lib/content";
import ShareButton from "./ShareButton.astro";
import MisureWord from "./ui/MisureWord.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-green bg-cream">
  <div class="mx-auto max-w-6xl px-4 pt-10 pb-16 md:px-6 md:pb-8">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <img
          src="/misure-logo.svg"
          alt={site.name}
          class="h-10 w-auto"
        />
        <p class="mt-2 text-sm leading-relaxed text-green/70">{site.tagline}</p>
      </div>
      <nav class="flex flex-col gap-2 text-sm" aria-label="Navegación">
        <p class="text-xs uppercase tracking-[0.2em] text-green/60">
          {footer.navTitle}
        </p>
        {nav.map((item) => (
          <a
            href={item.href}
            class="w-fit text-green underline-offset-4 hover:underline"
          >
            {item.label}
          </a>
        ))}
      </nav>
      <nav class="flex flex-col gap-2 text-sm" aria-label="Contacto">
        <p class="text-xs uppercase tracking-[0.2em] text-green/60">
          {footer.contactTitle}
        </p>
        {isPending(contact.email) ? (
          <span class="w-fit text-green/60">{contact.email}</span>
        ) : (
          <a
            href={`mailto:${contact.email}`}
            class="w-fit text-green underline-offset-4 hover:underline"
          >
            {contact.email}
          </a>
        )}
        {contact.socials.map((social) =>
          isPending(social.url) ? (
            <span class="w-fit text-green/60">{social.label}</span>
          ) : (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-fit text-green underline-offset-4 hover:underline"
            >
              {social.label}
            </a>
          )
        )}
      </nav>
    </div>
    <div
      class="mt-8 flex flex-col items-center justify-between gap-3 border-t border-green pt-4 text-xs text-green/60 sm:flex-row"
    >
      <p>
        © {year} <MisureWord text={site.name}/> 
      </p>
      <ShareButton />
      <p>
        <MisureWord text={footer.tagline} />
      </p>
    </div>
  </div>
</footer>
