---
import { contact, footer, headerCta, isPending, nav, site } from "../lib/content";
import ShareButton from "./ShareButton.astro";
import InstagramIcon from "./ui/InstagramIcon.astro";
import LaptopIcon from "./ui/LaptopIcon.astro";
import LinkedinIcon from "./ui/LinkedinIcon.astro";
import MailIcon from "./ui/MailIcon.astro";
import MisureWord from "./ui/MisureWord.astro";
import PinIcon from "./ui/PinIcon.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-green bg-cream">
  <div class="mx-auto max-w-6xl px-4 pt-10 pb-20 md:px-6 md:pb-8">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <a href="/" class="inline-flex items-center">
          <img
            src="/misure-logo.svg"
            alt={site.name}
            class="h-10 w-auto"
          />
        </a>
        <p class="mt-2 text-sm leading-relaxed text-green/70">
          <MisureWord text={site.tagline} />
        </p>
      </div>
      <nav class="flex flex-col gap-2 text-sm" aria-label="Navegación">
        <p class="text-xs uppercase tracking-[0.2em] text-green/75">
          {footer.navTitle}
        </p>
        {nav.map((item) => (
          <a
            href={item.href}
            class="w-fit py-1 text-green underline-offset-4 hover:underline"
          >
            {item.label}
          </a>
        ))}
        <a
          href={headerCta.href}
          class="mt-1 inline-flex w-fit items-center rounded-md border-2 border-green bg-green px-5 py-2.5 text-sm font-semibold tracking-wide text-cream transition hover:border-green-light hover:bg-green-light active:translate-x-[-4px] active:translate-y-[4px] active:duration-75"
        >
          {footer.ctaLabel}
        </a>
      </nav>
      <nav class="flex flex-col gap-3 text-sm" aria-label="Contacto">
        <p class="text-xs uppercase tracking-[0.2em] text-green/75">
          {footer.contactTitle}
        </p>
        {isPending(contact.email) ? (
          <span class="flex w-fit items-center gap-3 text-green/75">
            <MailIcon class="h-5 w-5 shrink-0 text-green/75" />
            {contact.email}
          </span>
        ) : (
          <a
            href={`mailto:${contact.email}`}
            class="flex w-fit items-center gap-3 py-1 text-green underline-offset-4 hover:underline"
          >
            <MailIcon class="h-5 w-5 shrink-0 text-green/75" />
            {contact.email}
          </a>
        )}
        {contact.socials.map((social) =>
          isPending(social.url) ? (
            <span class="flex w-fit items-center gap-3 text-green/75">
              {social.label === "LinkedIn" ? (
                <LinkedinIcon class="h-5 w-5 shrink-0 text-green/75" />
              ) : (
                <InstagramIcon class="h-5 w-5 shrink-0 text-green/75" />
              )}
              {social.label}
            </span>
          ) : (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex w-fit items-center gap-3 py-1 text-green underline-offset-4 hover:underline"
            >
              {social.label === "LinkedIn" ? (
                <LinkedinIcon class="h-5 w-5 shrink-0 text-green/75" />
              ) : (
                <InstagramIcon class="h-5 w-5 shrink-0 text-green/75" />
              )}
              {social.displayLabel ?? social.label}
            </a>
          )
        )}
        {contact.locationItems.map((item) => (
          <span class="flex w-fit items-center gap-3 text-green">
            {item.label.includes("UBI") ? (
              <PinIcon class="h-5 w-5 shrink-0 text-green/75" />
            ) : (
              <LaptopIcon class="h-5 w-5 shrink-0 text-green/75" />
            )}
            <span>{item.value}</span>
          </span>
        ))}
      </nav>
    </div>
    <div
      class="mt-8 flex flex-col items-center justify-between gap-3 border-t border-green pt-4 text-xs text-green/75 sm:flex-row"
    >
      <p>
        © {year} <MisureWord text={site.name}/> 
      </p>
      <ShareButton />
      <p>
        <MisureWord text={footer.tagline} />
      </p>
    </div>
  </div>
</footer>
