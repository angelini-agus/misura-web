---
import { hero } from "../lib/content";
import HighlightWords from "./ui/HighlightWords.astro";
import Button from "./ui/Button.astro";
import MisureWord from "./ui/MisureWord.astro";
import CodePanel from "./ui/CodePanel.astro";
---

<!--
  --hero-top-h: lo que ocupa la barra de anuncio más el header sticky, que es lo
  que tapa el hero al llegar. Acá SÍ cuenta la barra de anuncio, a diferencia de
  la sección de contacto: el hero está arriba de todo, así que la barra todavía
  está visible.

  Tres valores porque la barra de anuncio cambia de alto según el ancho: su copy
  entra en una línea arriba de ~640px y envuelve a dos abajo, y el header mide 67
  en mobile y 77 desde md. Medido con el navegador: <368px = 68 + 67 = 135px (tres
  líneas de anuncio); 368-639px = 52 + 67 = 119px; 640-767px = 36 + 67 = 103px;
  md+ = 36 + 77 = 113px. Si cambia el copy del anuncio, el padding del header o su
  contenido más alto, hay que remedir: el alto del anuncio depende de cuántas
  líneas ocupe, no de un breakpoint fijo.

  El min-height de abajo trabaja junto con las media queries del final del
  archivo, que compactan el contenido en celulares bajos: ellas hacen que el
  contenido entre, esto hace que el hero ocupe la pantalla.
-->
<section
  id="inicio"
  class="scroll-mt-24 [--hero-top-h:6.4375rem] min-[23rem]:max-sm:[--hero-top-h:7.4375rem] max-[23rem]:[--hero-top-h:8.4375rem] md:[--hero-top-h:7.0625rem]"
>
  <div
    class="hero-grid mx-auto grid min-h-[calc(100dvh-var(--hero-top-h))] max-w-6xl grid-cols-1 items-center gap-5 px-4 py-6 md:grid-cols-[55%_45%] md:gap-16 md:px-6 md:py-16"
  >
    <div class="order-2 md:order-1">
      <h1
        data-reveal
        class="hero-title font-display max-w-xl text-3xl font-medium leading-[1.1] tracking-tight sm:text-4xl md:text-[3.4rem]"
      >
        {hero.title}
      </h1>
      <p
        data-reveal
        style={{ transitionDelay: "50ms" }}
        class="hero-subtitle font-display mt-3 max-w-xl text-lg font-medium leading-snug tracking-tight sm:text-xl md:text-2xl"
      >
        <HighlightWords text={hero.subtitle} phrases={hero.highlights} />
      </p>
      <p
        data-reveal
        style={{ transitionDelay: "100ms" }}
        class="hero-lead mt-4 max-w-xl text-base leading-relaxed text-green/80 sm:text-lg"
      >
        <MisureWord text={hero.lead} />
      </p>
      <div
        data-reveal
        style={{ transitionDelay: "150ms" }}
        class="hero-actions mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4"
      >
        <Button href={hero.ctaPrimary.href} class="w-full sm:w-auto">
          {hero.ctaPrimary.label}
        </Button>
        <Button href={hero.ctaSecondary.href} variant="outline" class="w-full sm:w-auto">
          {hero.ctaSecondary.label}
        </Button>
      </div>
    </div>
    <div class="hero-visual order-1 mx-auto w-full max-w-[min(15rem,30dvh)] sm:max-w-[min(36rem,40dvh)] md:order-2" data-reveal style={{ transitionDelay: "120ms" }}>
      <CodePanel />
    </div>
  </div>
</section>

<style>
  /* En celulares bajos el hero se compacta un escalon mas: es la unica forma
     de que los dos botones entren dentro de los primeros 100dvh a 375x667 y
     360x740, que es lo que la version mobile no cumplia. La condicion pide
     ancho de celular (hasta 30rem) Y alto bajo (hasta 820px), asi que la
     version desktop y los celulares altos no se tocan. */
  @media (max-width: 30rem) and (max-height: 820px) {
    .hero-grid {
      gap: 0.75rem;
      padding-top: 1.25rem;
      padding-bottom: 1.25rem;
    }

    .hero-title {
      font-size: 1.5rem;
      line-height: 1.15;
    }

    .hero-subtitle {
      margin-top: 0.5rem;
      font-size: 0.9375rem;
      line-height: 1.35;
    }

    .hero-lead {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
    }

    .hero-actions {
      margin-top: 1rem;
    }

    .hero-visual {
      max-width: min(11rem, 24dvh);
    }
  }

  /* Celulares bajos de verdad: 360x640 en adelante. Medido con el subtitulo
     puesto, el bloque de texto no entraba en los 100dvh (faltaban ~28px a
     360x640 y ~13px a 320x568) y los dos CTAs quedaban abajo del pliegue. Se
     achica escala otra vez (panel, padding, gaps y margenes), nunca el copy.
     El corte es 660px de alto a proposito: 375x667 tiene 82,8px libres y no
     necesita este escalon, asi que conserva el panel y el aire del anterior. */
  @media (max-width: 30rem) and (max-height: 660px) {
    .hero-grid {
      gap: 0.5rem;
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .hero-subtitle {
      margin-top: 0.375rem;
      font-size: 0.875rem;
      line-height: 1.3;
    }

    .hero-lead {
      margin-top: 0.5rem;
    }

    .hero-visual {
      max-width: min(10rem, 20dvh);
    }

    .hero-actions {
      margin-top: 0.75rem;
    }
  }

  /* Ventanas de escritorio bajas: hasta 720px de alto el bloque de texto del hero
     no entra en la primera pantalla y los dos CTAs quedaban abajo del pliegue
     (medido a 1440x647: el fondo de los botones en 690px, o sea 43px fuera de la
     pantalla; el hero mide 625px de contenido + los 113px de barra de anuncio y
     header = necesita 738px para entrar). Se achica escala otra vez, igual que en
     los tres escalones mobile de arriba: padding, titulo, margenes y panel, nunca
     el copy. El corte de 45rem esta por debajo de los 738px donde empieza a no
     entrar, asi que por encima de 720px de ventana no cambia nada. */
  @media (min-width: 48rem) and (max-height: 45rem) {
    .hero-grid {
      padding-top: 1.5rem;
      padding-bottom: 1.5rem;
    }

    .hero-title {
      font-size: 2.75rem;
      line-height: 1.08;
    }

    .hero-subtitle {
      margin-top: 0.5rem;
    }

    .hero-lead {
      margin-top: 0.75rem;
    }

    .hero-actions {
      margin-top: 1rem;
    }

    .hero-visual {
      max-width: min(30rem, 32dvh);
    }
  }

  /* Escritorios muy bajos (una notebook de 1080p al 200% de escala ronda los
     540px utiles): un escalon mas, sin tocar el copy ni la estructura. */
  @media (min-width: 48rem) and (max-height: 37.5rem) {
    .hero-grid {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .hero-title {
      font-size: 2.25rem;
    }

    .hero-visual {
      max-width: min(26rem, 26dvh);
    }
  }

  /* Pantallas muy bajas (un iPhone SE con las barras del navegador a la vista
     ronda los 550px utiles): un escalon mas. Los dos CTAs pasan a dos
     columnas y el panel achica otra vez, asi los botones entran sin tocar la
     tipografia ni el copy. El 18dvh del panel es por el subtitulo: a 320x568,
     con 20dvh quedaban solo 5,3px libres dentro del hero (medido con el
     build), y eso deja el pliegue a merced de como mida la fuente de
     reemplazo mientras carga la variable. */
  @media (max-width: 30rem) and (max-height: 620px) {
    .hero-grid {
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }

    .hero-visual {
      max-width: min(9rem, 18dvh);
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }

    /* :global hace falta: los botones son el root de otro componente, y Astro
       no le propaga el scope del padre, asi que un selector de hijo directo no
       matcheaba nada. Con px-3 las etiquetas de los dos CTAs envuelven menos. */
    .hero-actions :global(a) {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }
</style>
