---
import { hero } from "../lib/content";
import Button from "./ui/Button.astro";
import MisureWord from "./ui/MisureWord.astro";
import CodePanel from "./ui/CodePanel.astro";
---

<section id="inicio" class="scroll-mt-24">
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-5 px-4 py-6 md:grid-cols-[55%_45%] md:gap-16 md:px-6 md:py-28"
  >
    <div class="order-2 md:order-1">
      <h1
        data-reveal
        class="font-display max-w-xl text-3xl font-medium leading-[1.1] tracking-tight sm:text-4xl md:text-[3.4rem]"
      >
        {hero.title}
      </h1>
      <p
        data-reveal
        style={{ transitionDelay: "60ms" }}
        class="mt-4 max-w-xl text-base leading-relaxed text-green/80 sm:text-lg"
      >
        <MisureWord text={hero.lead} />
      </p>
      <div
        data-reveal
        style={{ transitionDelay: "120ms" }}
        class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4"
      >
        <Button href={hero.ctaPrimary.href} class="w-full sm:w-auto">
          {hero.ctaPrimary.label}
        </Button>
        <Button href={hero.ctaSecondary.href} variant="outline" class="w-full sm:w-auto">
          {hero.ctaSecondary.label}
        </Button>
      </div>
    </div>
    <div class="order-1 mx-auto w-full max-w-[min(15rem,30dvh)] sm:max-w-xl md:order-2" data-reveal style={{ transitionDelay: "120ms" }}>
      <CodePanel />
    </div>
  </div>
</section>
