---
import { hero } from "../lib/content";
import Button from "./ui/Button.astro";
import MisureWord from "./ui/MisureWord.astro";
import CodePanel from "./ui/CodePanel.astro";
---

<!--
  --hero-top-h: lo que ocupa la barra de anuncio más el header sticky, que es lo
  que tapa el hero al llegar. Acá SÍ cuenta la barra de anuncio, a diferencia de
  la sección de contacto: el hero está arriba de todo, así que la barra todavía
  está visible.

  Tres valores porque la barra de anuncio cambia de alto según el ancho: su copy
  entra en una línea arriba de ~640px y envuelve a dos abajo, y el header mide 67
  en mobile y 77 desde md. Medido con el navegador: <640px = 52 + 67 = 119px;
  640-767px = 36 + 67 = 103px; md+ = 36 + 77 = 113px. Si cambia el copy del
  anuncio, el padding del header o su contenido más alto, hay que remedir.

  El padding y el tope del panel de abajo no son decorativos: están ajustados
  para que el contenido entre en una pantalla. Con py-28 y el panel sin capar
  por alto de viewport, el hero se estiraba a 811px en 700x800 y a 845px en
  768x900, y ahí dejaba de ocupar una pantalla exacta.
-->
<section
  id="inicio"
  class="scroll-mt-24 [--hero-top-h:6.4375rem] max-sm:[--hero-top-h:7.4375rem] md:[--hero-top-h:7.0625rem]"
>
  <div
    class="mx-auto grid min-h-[calc(100dvh-var(--hero-top-h))] max-w-6xl grid-cols-1 items-center gap-5 px-4 py-6 md:grid-cols-[55%_45%] md:gap-16 md:px-6 md:py-16"
  >
    <div class="order-2 md:order-1">
      <h1
        data-reveal
        class="font-display max-w-xl text-3xl font-medium leading-[1.1] tracking-tight sm:text-4xl md:text-[3.4rem]"
      >
        {hero.title}
      </h1>
      <p
        data-reveal
        style={{ transitionDelay: "60ms" }}
        class="mt-4 max-w-xl text-base leading-relaxed text-green/80 sm:text-lg"
      >
        <MisureWord text={hero.lead} />
      </p>
      <div
        data-reveal
        style={{ transitionDelay: "120ms" }}
        class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4"
      >
        <Button href={hero.ctaPrimary.href} class="w-full sm:w-auto">
          {hero.ctaPrimary.label}
        </Button>
        <Button href={hero.ctaSecondary.href} variant="outline" class="w-full sm:w-auto">
          {hero.ctaSecondary.label}
        </Button>
      </div>
    </div>
    <div class="order-1 mx-auto w-full max-w-[min(15rem,30dvh)] sm:max-w-[min(36rem,40dvh)] md:order-2" data-reveal style={{ transitionDelay: "120ms" }}>
      <CodePanel />
    </div>
  </div>
</section>
