---
import { dictionaryEntry, hero } from "../lib/content";
import HighlightWords from "./ui/HighlightWords.astro";
import Button from "./ui/Button.astro";
import BrandWord from "./ui/BrandWord.astro";
import CodePanel from "./ui/CodePanel.astro";
---

<!--
  --hero-top-h: lo que ocupa la barra de anuncio más el header sticky, que es lo
  que tapa el hero al llegar. Acá SÍ cuenta la barra de anuncio, a diferencia de
  la sección de contacto: el hero está arriba de todo, así que la barra todavía
  está visible.

  Tres valores porque la barra de anuncio cambia de alto según el ancho: su copy
  entra en una línea arriba de ~640px y envuelve a dos abajo, y el header mide 67
  en mobile y 77 desde md. Medido con el navegador: <368px = 68 + 67 = 135px (tres
  líneas de anuncio); 368-639px = 52 + 67 = 119px; 640-767px = 36 + 67 = 103px;
  md+ = 36 + 77 = 113px. Si cambia el copy del anuncio, el padding del header o su
  contenido más alto, hay que remedir: el alto del anuncio depende de cuántas
  líneas ocupe, no de un breakpoint fijo.

  El min-height de abajo trabaja junto con las media queries del final del
  archivo, que compactan el contenido en celulares bajos: ellas hacen que el
  contenido entre, esto hace que el hero ocupe la pantalla.
-->
<section
  id="inicio"
  class="scroll-mt-24 [--hero-top-h:6.4375rem] min-[23rem]:max-sm:[--hero-top-h:7.4375rem] max-[23rem]:[--hero-top-h:8.4375rem] md:[--hero-top-h:7.0625rem]"
>
  <div
    class="hero-grid mx-auto grid min-h-[calc(100dvh-var(--hero-top-h))] max-w-6xl grid-cols-1 items-center gap-5 px-4 py-6 md:grid-cols-[55%_45%] md:gap-16 md:px-6 md:py-16"
  >
    <!-- Apertura de marca: el wordmark a gran escala con su fonetica, el mismo
         tratamiento que tenia la apertura de /nosotros. Ocupa la fila de arriba
         a todo el ancho y el contenido del hero queda debajo. Sin `order` el
         bloque va primero tambien en mobile, donde el panel y el texto llevan
         order-1 y order-2. -->
    <div
      class="hero-brand flex w-full flex-col items-center text-center md:col-span-2"
      data-reveal="blur"
    >
      <span class="wordmark wordmark-hero select-none" data-hero-wordmark
        >{dictionaryEntry.word}</span
      >
      <p
        class="font-typewriter mt-3 text-base text-green/90 tracking-wide sm:text-lg md:text-xl"
      >
        {dictionaryEntry.phonetic} /{dictionaryEntry.category}.
      </p>
    </div>

    <div class="order-2 md:order-1">
      <h1
        data-reveal
        class="hero-title font-display max-w-xl text-3xl font-medium leading-[1.1] tracking-tight sm:text-4xl md:text-[3.4rem]"
      >
        {hero.title}
      </h1>
      <p
        data-reveal
        style={{ transitionDelay: "50ms" }}
        class="hero-subtitle font-display mt-3 max-w-xl text-lg font-medium leading-snug tracking-tight sm:text-xl md:text-2xl"
      >
        <HighlightWords text={hero.subtitle} phrases={hero.highlights} />
      </p>
      <p
        data-reveal
        style={{ transitionDelay: "100ms" }}
        class="hero-lead mt-4 max-w-xl text-base leading-relaxed text-green/80 sm:text-lg"
      >
        <BrandWord text={hero.lead} />
      </p>
      <div
        data-reveal
        style={{ transitionDelay: "150ms" }}
        class="hero-actions mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4"
      >
        <Button href={hero.ctaPrimary.href} class="w-full sm:w-auto">
          {hero.ctaPrimary.label}
        </Button>
        <Button href={hero.ctaSecondary.href} variant="outline" class="w-full sm:w-auto">
          {hero.ctaSecondary.label}
        </Button>
      </div>
    </div>
    <div class="hero-visual order-1 mx-auto w-full max-w-[min(15rem,30dvh)] sm:max-w-[min(36rem,40dvh)] md:order-2" data-reveal style={{ transitionDelay: "120ms" }}>
      <CodePanel />
    </div>
  </div>
</section>

<style>
  /* El alto del wordmark de la apertura sale del alto de VENTANA, no del ancho:
     es el bloque que sobra o falta para que los dos CTAs entren en la primera
     pantalla. La cuenta es `alto de ventana - lo que ocupan la barra de anuncio
     y el header - el resto del hero`, con el tope y el piso del resto del
     diseno. Por encima del punto donde la cuenta da el tope (unas 1080px de
     ventana en escritorio) el wordmark se queda en su tamano maximo y no cambia
     nada; por debajo se achica de forma continua, sin escalones discretos.

     El resto del hero mide 842px en escritorio (medido: 905 de hero con 176 de
     wordmark, menos 40 de wordmark+fonetica+su margen, mas los 113 de barra y
     header) y 859px en mobile. El piso de 2.5rem evita que desaparezca. */
  .hero-grid {
    --wordmark-hero-size: clamp(2.5rem, calc(100dvh - 53.6875rem), 6rem);
  }

  @media (min-width: 48rem) {
    .hero-grid {
      --wordmark-hero-size: clamp(2.5rem, calc(100dvh - 52.625rem), 11rem);
    }
  }

  /* En celulares bajos el hero se compacta un escalon mas: es la unica forma
     de que los dos botones entren dentro de los primeros 100dvh a 375x667 y
     360x740, que es lo que la version mobile no cumplia. La condicion pide
     ancho de celular (hasta 30rem) Y alto bajo (hasta 820px), asi que la
     version desktop y los celulares altos no se tocan. */
  @media (max-width: 30rem) and (max-height: 820px) {
    .hero-grid {
      gap: 0.75rem;
      padding-top: 1.25rem;
      padding-bottom: 1.25rem;
    }

    .hero-title {
      font-size: 1.5rem;
      line-height: 1.15;
    }

    .hero-subtitle {
      margin-top: 0.5rem;
      font-size: 0.9375rem;
      line-height: 1.35;
    }

    .hero-lead {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
    }

    .hero-actions {
      margin-top: 1rem;
    }

    .hero-visual {
      max-width: min(11rem, 24dvh);
    }
  }

  /* Celulares bajos de verdad: 360x640 en adelante. Medido con el subtitulo
     puesto, el bloque de texto no entraba en los 100dvh (faltaban ~28px a
     360x640 y ~13px a 320x568) y los dos CTAs quedaban abajo del pliegue. Se
     achica escala otra vez (panel, padding, gaps y margenes), nunca el copy.
     El corte subio de 660px a 42rem (672px): con la apertura de marca el hero
     crece y a 668 todavia falta entrar, asi que el escalon tiene que empezar
     antes. Arriba de 820px de ventana sigue sin aplicarse nada. */
  @media (max-width: 30rem) and (max-height: 42rem) {
    .hero-grid {
      gap: 0.5rem;
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .hero-subtitle {
      margin-top: 0.375rem;
      font-size: 0.875rem;
      line-height: 1.3;
    }

    .hero-lead {
      margin-top: 0.5rem;
    }

    .hero-visual {
      max-width: min(10rem, 20dvh);
    }

    .hero-actions {
      margin-top: 0.75rem;
    }
  }

  /* El ultimo escalon antes de que el hero scrollee. A 656px de ventana el
     panel es lo unico que todavia tiene aire: el wordmark ya esta en su piso
     (2.5rem) y el copy no se toca. */
  @media (max-width: 30rem) and (max-height: 41rem) {
    .hero-title {
      font-size: 1.375rem;
      line-height: 1.12;
    }

    .hero-visual {
      max-width: min(8rem, 16dvh);
    }
  }

  /* Ventanas de escritorio bajas: el corte era 45rem con el hero sin wordmark;
     con la apertura de marca el contenido crece y el escalon tiene que empezar
     antes. A 49rem (784px de ventana) todavia falta entrar, y por encima de
     64rem no hace falta nada, asi que el escalon cubre ese hueco. Se achica
     escala otra vez, igual que en los escalones mobile: padding, `row-gap`,
     titulo, margenes y panel, nunca el copy. El `row-gap` separa la apertura de
     marca del contenido y es el aire mas caro y mas prescindible del bloque. */
  @media (min-width: 48rem) and (max-height: 49rem) {
    .hero-grid {
      row-gap: 1.5rem;
      padding-top: 1.5rem;
      padding-bottom: 1.5rem;
    }

    .hero-title {
      font-size: 2.75rem;
      line-height: 1.08;
    }

    .hero-subtitle {
      margin-top: 0.5rem;
    }

    .hero-lead {
      margin-top: 0.75rem;
    }

    .hero-actions {
      margin-top: 1rem;
    }

    .hero-visual {
      max-width: min(30rem, 32dvh);
    }
  }

  /* Escritorios muy bajos (una notebook de 1080p al 200% de escala ronda los
     540px utiles): un escalon mas, sin tocar el copy ni la estructura. */
  @media (min-width: 48rem) and (max-height: 37.5rem) {
    .hero-grid {
      row-gap: 1rem;
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .hero-title {
      font-size: 2.25rem;
    }

    .hero-visual {
      max-width: min(20rem, 20dvh);
    }
  }

  /* Pantallas muy bajas (un iPhone SE con las barras del navegador a la vista
     ronda los 550px utiles): un escalon mas. Los dos CTAs pasan a dos
     columnas y el panel achica otra vez, asi los botones entran sin tocar la
     tipografia ni el copy. El 18dvh del panel es por el subtitulo: a 320x568,
     con 20dvh quedaban solo 5,3px libres dentro del hero (medido con el
     build), y eso deja el pliegue a merced de como mida la fuente de
     reemplazo mientras carga la variable. */
  @media (max-width: 30rem) and (max-height: 620px) {
    .hero-grid {
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }

    .hero-visual {
      max-width: min(9rem, 18dvh);
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }

    /* :global hace falta: los botones son el root de otro componente, y Astro
       no le propaga el scope del padre, asi que un selector de hijo directo no
       matcheaba nada. Con px-3 las etiquetas de los dos CTAs envuelven menos. */
    .hero-actions :global(a) {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }
</style>

<script>
  let cleanupMorph: (() => void) | undefined;

  // El wordmark de la apertura viaja hasta el navbar mientras se scrollea: un
  // solo logo visible en todo momento, sin que aparezca duplicado al llegar
  // arriba. Vive aca y no en el diccionario de /nosotros porque la apertura de
  // marca se mudo a la home.
  const initLogoMorph = () => {
    cleanupMorph?.();
    cleanupMorph = undefined;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    const heroWordmark = document.querySelector<HTMLElement>(
      "[data-hero-wordmark]",
    );
    const headerLogo = document.querySelector<HTMLElement>(
      "[data-header-logo]",
    );
    const headerLogoLink = document.querySelector<HTMLAnchorElement>(
      "[data-header-logo-link]",
    );

    // En cualquier pagina que no sea la home no hay wordmark de apertura, asi
    // que el script no tiene nada que animar y sale sin tocar el header.
    if (!heroWordmark || !headerLogo || !headerLogoLink) return;

    let heroDocLeft = 0;
    let heroDocTop = 0;
    let heroWidth = 0;
    let targetWidth = 0;
    let layoutWidth = 0;
    let scaleInicio = 1;
    let scaleFin = 1;
    let announcementH = 0;
    let headerStickyTopOffset = 0;
    let headerRestX = 0;
    let travelDistance = 1;
    let currentProgress = 0;
    let isAtRest = false;

    // Posicion de LAYOUT de un elemento, no la pintada: `getBoundingClientRect`
    // incluye los transforms de las animaciones de reveal (`data-reveal` mueve
    // el contenido con translateY durante ~600ms despues de cargar la pagina), y
    // medir ahi dejaba el viaje 16px abajo en /nosotros: al arrancar, la caja del
    // wordmark ya estaba en su lugar pero su rect devolvia 16px mas. Sumando
    // `offsetTop` y `offsetLeft` por la cadena de `offsetParent` se obtiene la
    // posicion real del flujo, que es la misma desde el primer pintado y no
    // depende de en que momento del reveal se mida.
    const offsetDoc = (el: HTMLElement) => {
      let x = 0;
      let y = 0;
      let node: HTMLElement | null = el;
      while (node) {
        x += node.offsetLeft;
        y += node.offsetTop;
        node = node.offsetParent as HTMLElement | null;
      }
      return { x, y };
    };

    const measure = () => {
      const scrollY = window.scrollY;
      const linkRect = headerLogoLink.getBoundingClientRect();
      const heroRect = heroWordmark.getBoundingClientRect();
      const heroDoc = offsetDoc(heroWordmark);

      heroDocLeft = heroDoc.x;
      heroDocTop = heroDoc.y;
      heroWidth = heroWordmark.offsetWidth || heroRect.width;

      // El logo que viaja mide lo mismo en el hero y en el navbar, y el navbar
      // lo muestra achicado con el transform: el navegador nunca agranda nada.
      layoutWidth = headerLogo.offsetWidth || 628;
      targetWidth = headerLogoLink.offsetWidth || linkRect.width;
      if (targetWidth <= 0 || heroWidth <= 0 || layoutWidth <= 0) return;

      scaleInicio = heroWidth / layoutWidth;
      scaleFin = targetWidth / layoutWidth;

      const announcementBar = document.querySelector<HTMLElement>(".announcement-bar");
      announcementH = announcementBar ? announcementBar.offsetHeight : 0;

      headerStickyTopOffset = linkRect.top - Math.max(0, announcementH - scrollY);
      headerRestX = linkRect.left;

      // La distancia de scroll hasta que el wordmark cruza el nivel del header
      travelDistance = Math.max(1, heroDocTop - (headerStickyTopOffset + announcementH));

      update();
    };

    const update = () => {
      const scrollY = window.scrollY;
      const currentAnnouncement = Math.max(0, announcementH - scrollY);
      const currentHeaderRestY = currentAnnouncement + headerStickyTopOffset;
      const currentHeroY = heroDocTop - scrollY;

      // Progreso de 0 (arriba de todo) a 1 (apoyado en el navbar)
      const rawProgress = scrollY / travelDistance;
      const progress = Math.min(1, Math.max(0, rawProgress));
      currentProgress = progress;

      if (progress >= 1) {
        if (!isAtRest) {
          headerLogo.style.transform = `translate(0px, 0px) scale(${scaleFin.toFixed(4)})`;
          headerLogo.style.willChange = "auto";
          isAtRest = true;
        }
        return;
      }

      isAtRest = false;

      // Interpolacion directa y fluida (60/120 FPS sin reflow)
      const scale = scaleInicio + (scaleFin - scaleInicio) * progress;
      const targetX = heroDocLeft * (1 - progress) + headerRestX * progress;
      const targetY = currentHeroY * (1 - progress) + currentHeaderRestY * progress;

      const dx = targetX - headerRestX;
      const dy = targetY - currentHeaderRestY;

      headerLogo.style.transformOrigin = "0 0";
      // Transform 2D y sin `will-change`: con translate3d el navegador promueve
      // el logo a su propia capa, la rasteriza una vez y despues escala ese mapa
      // de bits, que es lo que lo hacia ver borroso mientras viajaba (medido: la
      // energia de bordes a mitad del viaje caia un 33%, de 7.97 a 5.36). En 2D y
      // sin promocion, el navegador repinta el texto en cada frame a la escala
      // real.
      headerLogo.style.transform = `translate(${dx.toFixed(2)}px, ${dy.toFixed(2)}px) scale(${scale.toFixed(4)})`;
    };

    // Ocultar el wordmark de la apertura para que solo exista un logo visible
    heroWordmark.style.opacity = "0";

    // Si hacen clic en el logo mientras aun esta en el hero, no navegar a home
    const onLinkClick = (event: MouseEvent) => {
      if (currentProgress < 0.85) {
        event.preventDefault();
      }
    };
    headerLogoLink.addEventListener("click", onLinkClick);

    let scrollRaf = 0;
    const onScroll = () => {
      if (!scrollRaf) {
        scrollRaf = window.requestAnimationFrame(() => {
          scrollRaf = 0;
          update();
        });
      }
    };

    let resizeTimer = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(measure, 50);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
    // Red de seguridad: el evento `load` de la ventana vuelve a medir cuando ya
    // terminaron de asentarse las imagenes y el primer layout. El ancho del
    // wordmark puede cambiar entre el primer pintado y `load`, asi que no
    // alcanza con medir una sola vez al arrancar.
    window.addEventListener("load", measure);

    // Medir de inmediato y otra vez cuando la tipografia del wordmark termina de
    // cargar: Lora cambia el ancho de la caja y el viaje se mide contra ese
    // ancho.
    measure();
    document.fonts?.ready.then(measure).catch(() => {});

    cleanupMorph = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onResize);
      window.removeEventListener("load", measure);
      headerLogoLink.removeEventListener("click", onLinkClick);
      if (scrollRaf) window.cancelAnimationFrame(scrollRaf);
      window.clearTimeout(resizeTimer);

      // Se vuelve al transform por defecto de la hoja (la escala del navbar), no
      // a "none": el wordmark mide 628px de layout y sin escala se veria
      // gigante.
      headerLogo.style.transform = `scale(${scaleFin.toFixed(4)})`;
      headerLogo.style.transformOrigin = "";
      headerLogo.style.willChange = "";
      heroWordmark.style.opacity = "";
    };
  };

  document.addEventListener("astro:page-load", initLogoMorph);
  document.addEventListener("astro:before-swap", () => {
    cleanupMorph?.();
  });
  initLogoMorph();
</script>
