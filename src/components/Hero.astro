---
import { hero } from "../lib/content";
import Button from "./ui/Button.astro";
import MisureWord from "./ui/MisureWord.astro";
import CodePanel from "./ui/CodePanel.astro";
---

<!--
  --hero-top-h: lo que ocupa la barra de anuncio más el header sticky, que es lo
  que tapa el hero al llegar. Acá SÍ cuenta la barra de anuncio, a diferencia de
  la sección de contacto: el hero está arriba de todo, así que la barra todavía
  está visible.

  Tres valores porque la barra de anuncio cambia de alto según el ancho: su copy
  entra en una línea arriba de ~640px y envuelve a dos abajo, y el header mide 67
  en mobile y 77 desde md. Medido con el navegador: <368px = 68 + 67 = 135px (tres
  líneas de anuncio); 368-639px = 52 + 67 = 119px; 640-767px = 36 + 67 = 103px;
  md+ = 36 + 77 = 113px. Si cambia el copy del anuncio, el padding del header o su
  contenido más alto, hay que remedir: el alto del anuncio depende de cuántas
  líneas ocupe, no de un breakpoint fijo.

  El min-height de abajo trabaja junto con las media queries del final del
  archivo, que compactan el contenido en celulares bajos: ellas hacen que el
  contenido entre, esto hace que el hero ocupe la pantalla.
-->
<section
  id="inicio"
  class="scroll-mt-24 [--hero-top-h:6.4375rem] min-[23rem]:max-sm:[--hero-top-h:7.4375rem] max-[23rem]:[--hero-top-h:8.4375rem] md:[--hero-top-h:7.0625rem]"
>
  <div
    class="hero-grid mx-auto grid min-h-[calc(100dvh-var(--hero-top-h))] max-w-6xl grid-cols-1 items-center gap-5 px-4 py-6 md:grid-cols-[55%_45%] md:gap-16 md:px-6 md:py-16"
  >
    <div class="order-2 md:order-1">
      <h1
        data-reveal
        class="hero-title font-display max-w-xl text-3xl font-medium leading-[1.1] tracking-tight sm:text-4xl md:text-[3.4rem]"
      >
        {hero.title}
      </h1>
      <p
        data-reveal
        style={{ transitionDelay: "60ms" }}
        class="hero-lead mt-4 max-w-xl text-base leading-relaxed text-green/80 sm:text-lg"
      >
        <MisureWord text={hero.lead} />
      </p>
      <div
        data-reveal
        style={{ transitionDelay: "120ms" }}
        class="hero-actions mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4"
      >
        <Button href={hero.ctaPrimary.href} class="w-full sm:w-auto">
          {hero.ctaPrimary.label}
        </Button>
        <Button href={hero.ctaSecondary.href} variant="outline" class="w-full sm:w-auto">
          {hero.ctaSecondary.label}
        </Button>
      </div>
    </div>
    <div class="hero-visual order-1 mx-auto w-full max-w-[min(15rem,30dvh)] sm:max-w-[min(36rem,40dvh)] md:order-2" data-reveal style={{ transitionDelay: "120ms" }}>
      <CodePanel />
    </div>
  </div>
</section>

<style>
  /* En celulares bajos el hero se compacta un escalon mas: es la unica forma
     de que los dos botones entren dentro de los primeros 100dvh a 375x667 y
     360x740, que es lo que la version mobile no cumplia. La condicion pide
     ancho de celular (hasta 30rem) Y alto bajo (hasta 820px), asi que la
     version desktop y los celulares altos no se tocan. */
  @media (max-width: 30rem) and (max-height: 820px) {
    .hero-grid {
      gap: 0.75rem;
      padding-top: 1.25rem;
      padding-bottom: 1.25rem;
    }

    .hero-title {
      font-size: 1.5rem;
      line-height: 1.15;
    }

    .hero-lead {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
    }

    .hero-actions {
      margin-top: 1rem;
    }

    .hero-visual {
      max-width: min(11rem, 24dvh);
    }
  }

  /* Pantallas muy bajas (un iPhone SE con las barras del navegador a la vista
     ronda los 550px utiles): un escalon mas. Los dos CTAs pasan a dos
     columnas y el panel achica otra vez, asi los botones entran sin tocar la
     tipografia ni el copy. */
  @media (max-width: 30rem) and (max-height: 620px) {
    .hero-grid {
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }

    .hero-visual {
      max-width: min(9rem, 20dvh);
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }

    /* :global hace falta: los botones son el root de otro componente, y Astro
       no le propaga el scope del padre, asi que un selector de hijo directo no
       matcheaba nada. Con px-3 las etiquetas de los dos CTAs envuelven menos. */
    .hero-actions :global(a) {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }
</style>
