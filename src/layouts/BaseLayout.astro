---
import ScrollRail from "../components/ScrollRail.astro";
import "@fontsource-variable/plus-jakarta-sans";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { contact, site } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogUrl?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = site.metaTitle,
  description = site.metaDescription,
  ogType = "website",
  ogUrl: ogUrlProp,
  ogImage = "/og-misure-software.png",
  canonical: canonicalProp,
} = Astro.props;

// Canonical and og:url derive from Astro.site (set in astro.config.mjs) plus the
// current path; site.url is the fallback origin.
const siteOrigin = Astro.site ?? new URL(site.url);
// The generated sitemap uses trailing-slash URLs (e.g. https://misure.dev/privacidad/),
// so the canonical follows that convention.
const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const pageUrl = new URL(pathname, siteOrigin).href;
const canonical = canonicalProp ?? pageUrl;
const ogUrl = ogUrlProp ?? pageUrl;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
  description: site.metaDescription,
  email: contact.email,
  address: {
    "@type": "PostalAddress",
    // The site states Rosario, Santa Fe. telephone and streetAddress can be
    // added once misure has real values for them.
    addressLocality: "Rosario",
    addressRegion: "Santa Fe",
  },
};

const gaId = import.meta.env.PUBLIC_GA_ID;
const gaConfigScript = gaId
  ? `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${gaId}');`
  : null;
---

<!doctype html>
<html lang="es" class="scroll-smooth h-full bg-cream">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    {gaId && (
      <script
        is:inline
        src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
      />
    )}
    {gaConfigScript && <script is:inline set:html={gaConfigScript} />}

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organizationSchema)}
    />
    <script is:inline>
      document.documentElement.classList.add("js");
      // El riel propio (ScrollRail.astro) oculta la barra nativa bajo estas clases.
      // Se marcan aca, en el <head>, y no en el script del componente: ahi llega
      // despues del primer pintado, y liberar el espacio de la barra reflowea el
      // contenido 6px (medido: CLS 0,032 con la clase post-pintado contra 0,011
      // de base). El corte es el mismo desktop del riel (48rem): `has-rail` es el
      // riel y `has-mark` la marca de lectura de mobile, que reemplaza a la nativa
      // ahi donde el riel no existe.
      function marcarRiel() {
        const desktop = window.matchMedia("(min-width: 48rem)").matches;
        document.documentElement.classList.toggle("has-rail", desktop);
        document.documentElement.classList.toggle("has-mark", !desktop);
      }
      marcarRiel();
      // El ClientRouter reemplaza el atributo `class` del <html> con el del
      // HTML servido en cada navegacion client-side (entrar a /proyectos desde
      // el navbar), asi que las clases se pierden y el sitio entero cae al estado
      // sin JS: mazos, reveals y animaciones desarmados. Hay que reponerlas en
      // cada swap (astro:after-swap corre antes de la transicion, sin flash).
      // `marcarRiel` es una declaracion de funcion a proposito: si el <head> se
      // vuelve a ejecutar en una navegacion, volver a declararla es valido, cosa
      // que no pasa con un `const`.
      document.addEventListener("astro:after-swap", () => {
        document.documentElement.classList.add("js");
        marcarRiel();
      });
    </script>
  </head>
  <body class="flex min-h-full flex-col bg-cream antialiased">
    <slot />
    <script>
      /* El texto suelto sobre el fondo de la pagina entra con desenfoque; el que
         vive adentro de un contenedor visual (tarjeta con fondo propio o caja
         con borde) se queda con el reveal simple. La distincion se resuelve
         mirando los estilos desde el elemento hasta su seccion, asi que una
         seccion nueva hereda la regla sin que nadie tenga que acordarse de
         marcarla. Para forzar el reveal simple, el elemento se marca a mano con
         data-reveal="plain" (cualquier valor explicito manda). */
      const tieneContenedorVisual = (nodo: Element) => {
        if (/^(img|svg|canvas|video|picture)$/i.test(nodo.tagName)) return true;
        const cs = getComputedStyle(nodo);
        const fondo = cs.backgroundColor;
        const pintado = fondo !== "rgba(0, 0, 0, 0)" && fondo !== "transparent";
        const conBorde =
          cs.borderTopStyle !== "none" && parseFloat(cs.borderTopWidth) > 0;
        return pintado || conBorde;
      };

      const contieneContenedorVisual = (el: Element) => {
        if (tieneContenedorVisual(el)) return true;
        return [...el.querySelectorAll("*")].some(tieneContenedorVisual);
      };

      const marcarTextoConDesenfoque = () => {
        const nuevos: HTMLElement[] = [];
        document
          .querySelectorAll<HTMLElement>("[data-reveal]")
          .forEach((el) => {
            if (el.getAttribute("data-reveal") !== "") return;
            // Si el bloque trae adentro su propio contenedor visual (los botones
            // del hero, la ilustracion del panel), no es texto suelto: se queda
            // con el reveal simple.
            if (contieneContenedorVisual(el)) return;
            let nodo: Element | null = el;
            while (nodo && nodo.tagName !== "SECTION") {
              // Un bloque con desenfoque ya cubre lo que tiene adentro: las
              // oraciones de la historia, por ejemplo, no llevan uno propio.
              if (nodo !== el && nodo.getAttribute("data-reveal") === "blur") {
                return;
              }
              if (tieneContenedorVisual(nodo)) return;
              nodo = nodo.parentElement;
            }
            // El atributo entra sin transicion, igual que en replayReveal: si
            // entrara animado, el observer revela el elemento un frame despues y
            // la animacion se corta a la mitad. Medido: el filtro se quedaba en
            // blur(0px) y el desenfoque no se veia nunca.
            el.style.transition = "none";
            el.setAttribute("data-reveal", "blur");
            nuevos.push(el);
          });
        if (!nuevos.length) return;
        void document.body.offsetHeight;
        nuevos.forEach((el) => {
          el.style.transition = "";
        });
      };
      document.addEventListener("astro:page-load", marcarTextoConDesenfoque);
      marcarTextoConDesenfoque();

      const initReveal = () => {
        const targets = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window)) {
          targets.forEach((el) => el.classList.add("is-visible"));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
          );
          targets.forEach((el) => observer.observe(el));
        }
      };
      document.addEventListener("astro:page-load", initReveal);
      initReveal();

      document.addEventListener("astro:before-swap", (event) => {
        event.newDocument
          .querySelectorAll("[data-reveal]")
          .forEach((el) => el.classList.add("is-visible"));
      });

      /* En una navegacion del cliente la pagina nueva entra con los reveals ya
         marcados (ver astro:before-swap), asi que lo que cae en el primer
         viewport no anima: el desvanecido solo se veia al recargar. Aca se le
         quita la marca a TODOS y se le vuelve a poner a los que ya estan a la
         vista, para que la transicion corra entera, igual que en una recarga.
         Los que quedan debajo del pliegue si quedan sin marca y los revela el
         observer al scrollear, como antes.

         El `transition: none` temporal es lo que hace que esto funcione. Sin el,
         sacar y poner la clase en el mismo tick no dispara ninguna transicion:
         el navegador no ve cambio neto porque el estado final es igual al
         inicial, y el efecto no se ve. Con el, la opacidad 0 queda aplicada como
         estado previo y al devolver la transicion y la marca la animacion
         arranca desde ahi. Medido: la opacidad sube de 0 a 0.70 en 220ms. */
      const replayReveal = () => {
        const marcados = document.querySelectorAll<HTMLElement>(
          "[data-reveal].is-visible",
        );
        if (!marcados.length) return;
        marcados.forEach((el) => {
          el.style.transition = "none";
          el.classList.remove("is-visible");
        });
        void document.body.offsetHeight;
        marcados.forEach((el) => {
          el.style.transition = "";
          const caja = el.getBoundingClientRect();
          if (caja.top < window.innerHeight && caja.bottom > 0) {
            el.classList.add("is-visible");
          }
        });
      };
      document.addEventListener("astro:page-load", replayReveal);

      const initCountUp = () => {
        const targets = document.querySelectorAll("[data-countup]");
        if (!targets.length) return;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const format = new Intl.NumberFormat("es-AR");

        const render = (el: HTMLElement, value: number) => {
          el.textContent = `${el.dataset.prefix ?? ""}${format.format(value)}${el.dataset.suffix ?? ""}`;
        };

        const animate = (el: HTMLElement) => {
          const raw = (el.dataset.raw ?? "").trim();
          const match = raw.match(/^(\D*)([\d.,]+)(\D*)$/);
          if (!match) return;
          const prefix = match[1];
          const digits = match[2].replace(/[^\d]/g, "");
          const suffix = match[3];
          const target = Number(digits);
          el.dataset.prefix = prefix;
          el.dataset.suffix = suffix;
          if (reduce || !target) {
            render(el, target);
            return;
          }
          const duration = 700;
          const start = performance.now();
          const step = (now: number) => {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            render(el, Math.round(target * eased));
            if (progress < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                animate(entry.target as HTMLElement);
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.4 }
        );

        targets.forEach((target) => {
          const element = target as HTMLElement;
          if (element.dataset.raw !== undefined) return;
          element.dataset.raw = (element.textContent ?? "").trim();
          observer.observe(element);
        });
      };
      document.addEventListener("astro:page-load", initCountUp);
      initCountUp();
    </script>
    <script>
      // Encuadre del destino: una seccion que se lee como tarjeta (el formulario)
      // pide CENTRAR su tarjeta en la franja entre el header y el borde inferior
      // de la ventana; el resto aterriza pegado al header. La seccion entera no se
      // puede centrar cuando es mas alta que esa franja (el navegador no centra
      // algo mas grande que el viewport), asi que se centra el elemento marcado
      // con `data-scroll-card` y su propio `scroll-margin-top`.
      const scrollAligned = (target: HTMLElement) => {
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        const navH = document.querySelector("header")?.offsetHeight ?? 0;
        // El header sticky tapa el arranque del destino, así que el anclaje lleva
        // scroll-margin de navH - 2px (con el header tapando esos 2px, la línea que
        // separa la sección no queda pegada a la del header: se ve una sola). Se
        // aplica acá y no sólo en CSS porque el handler frena la navegación al hash
        // con preventDefault: la URL no recibe el fragmento, `:target` no matchea y
        // el margen declarado en la hoja no llega. Para la llegada desde OTRA página
        // (donde el hash sí queda en la URL) sigue valiendo la regla `:target`.
        target.style.scrollMarginTop = `${navH - 2}px`;
        const card = target.querySelector<HTMLElement>("[data-scroll-card]");
        // Centrar solo si la tarjeta entra en la franja entre el header y el borde
        // inferior. Si es mas alta que la ventana (mobile), centrarla esconde el
        // arranque del formulario, asi que se alinea arriba como cualquier otra
        // seccion.
        const centrar =
          target.dataset.scrollAlign === "center" &&
          !!card &&
          card.offsetHeight <= window.innerHeight - navH;
        const destino = centrar && card ? card : target;
        destino.scrollIntoView({
          behavior: reduce ? "auto" : "smooth",
          block: centrar ? "center" : "start",
        });
      };

      const onCtaClick = (event: Event) => {
        const link = event.currentTarget as HTMLAnchorElement | null;
        if (!link) return;
        const href = link.getAttribute("href") || "";
        const hashIndex = href.indexOf("#");
        if (hashIndex === -1) return;
        const targetUrl = new URL(link.href, window.location.origin);
        const currentUrl = new URL(window.location.href);
        const samePage =
          targetUrl.pathname.replace(/\/+$/, "") ===
          currentUrl.pathname.replace(/\/+$/, "");
        if (!samePage) return;
        const hash = targetUrl.hash;
        if (!hash) return;
        const target = document.getElementById(hash.slice(1));
        if (!target) return;
        event.preventDefault();
        event.stopPropagation();
        scrollAligned(target);
      };

      // Llegada por hash desde OTRA pagina: ahi el handler de click no corre (la
      // navegacion la maneja el ClientRouter) y el router scrollea con alineacion
      // "start". Se reencuadra centrado apenas la pagina nueva termino de montarse.
      const alignHashTarget = () => {
        const hash = window.location.hash;
        if (!hash) return;
        const target = document.getElementById(hash.slice(1));
        if (!target || target.dataset.scrollAlign !== "center") return;
        setTimeout(() => scrollAligned(target), 80);
      };
      document.addEventListener("astro:page-load", alignHashTarget);
      const initCtaScroll = () => {
        document.querySelectorAll('a[href*="#"]').forEach((link) => {
          link.removeEventListener("click", onCtaClick, true);
          link.addEventListener("click", onCtaClick, true);
        });
      };
      document.addEventListener("astro:page-load", initCtaScroll);
      initCtaScroll();

      // Llegada a la página de un caso DESDE otra página (el mazo de /proyectos,
      // las tarjetas del inicio): se entra directo a la ficha, o sea la captura
      // con las tecnologías, sin pasar por el título. El evento de swap es lo
      // que distingue esta llegada de entrar por la URL o recargar: en esos dos
      // casos no hay swap, el scroll no se toca y se ve el título como siempre.
      let llegoNavegando = false;
      const irALaFicha = () => {
        const ficha = document.querySelector<HTMLElement>("[data-case-hero]");
        if (!ficha) return;
        ficha.scrollIntoView({ block: "start", behavior: "instant" });
      };
      document.addEventListener("astro:before-swap", () => {
        llegoNavegando = true;
      });
      // Se corre también acá, antes de la transición, para que no se vea el
      // salto desde el título; y de nuevo en page-load por si el router
      // reposiciona el scroll al terminar.
      document.addEventListener("astro:after-swap", irALaFicha);
      document.addEventListener("astro:page-load", () => {
        if (!llegoNavegando) return;
        llegoNavegando = false;
        irALaFicha();
      });
    </script>
  <ScrollRail />
  </body>
</html>
