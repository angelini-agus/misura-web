---
import "@fontsource-variable/plus-jakarta-sans";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { contact, site } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogUrl?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = site.metaTitle,
  description = site.metaDescription,
  ogType = "website",
  ogUrl: ogUrlProp,
  ogImage = "/og-misure-software.png",
  canonical: canonicalProp,
} = Astro.props;

// Canonical and og:url derive from Astro.site (set in astro.config.mjs) plus the
// current path; site.url is the fallback origin.
const siteOrigin = Astro.site ?? new URL(site.url);
// The generated sitemap uses trailing-slash URLs (e.g. https://misure.dev/privacidad/),
// so the canonical follows that convention.
const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const pageUrl = new URL(pathname, siteOrigin).href;
const canonical = canonicalProp ?? pageUrl;
const ogUrl = ogUrlProp ?? pageUrl;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
  description: site.metaDescription,
  email: contact.email,
  address: {
    "@type": "PostalAddress",
    // The site states Rosario, Santa Fe. telephone and streetAddress can be
    // added once misure has real values for them.
    addressLocality: "Rosario",
    addressRegion: "Santa Fe",
  },
};

const gaId = import.meta.env.PUBLIC_GA_ID;
const gaConfigScript = gaId
  ? `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${gaId}');`
  : null;
---

<!doctype html>
<html lang="es" class="scroll-smooth h-full bg-cream">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    {gaId && (
      <script
        is:inline
        src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
      />
    )}
    {gaConfigScript && <script is:inline set:html={gaConfigScript} />}

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organizationSchema)}
    />
    <script is:inline>
      document.documentElement.classList.add("js");
      // El ClientRouter reemplaza el atributo `class` del <html> con el del
      // HTML servido en cada navegacion client-side (entrar a /proyectos desde
      // el navbar), asi que la clase se pierde y el sitio entero cae al estado
      // sin JS: mazos, reveals y animaciones desarmados. Hay que reponerla en
      // cada swap (astro:after-swap corre antes de la transicion, sin flash).
      document.addEventListener("astro:after-swap", () => {
        document.documentElement.classList.add("js");
      });
    </script>
  </head>
  <body class="flex min-h-full flex-col bg-cream antialiased">
    <slot />
    <script>
      const initReveal = () => {
        const targets = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window)) {
          targets.forEach((el) => el.classList.add("is-visible"));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
          );
          targets.forEach((el) => observer.observe(el));
        }
      };
      document.addEventListener("astro:page-load", initReveal);
      initReveal();

      document.addEventListener("astro:before-swap", (event) => {
        event.newDocument
          .querySelectorAll("[data-reveal]")
          .forEach((el) => el.classList.add("is-visible"));
      });

      const restoreScrollReveal = () => {
        document.querySelectorAll("[data-reveal].is-visible").forEach((el) => {
          if (el.getBoundingClientRect().top > window.innerHeight) {
            el.classList.remove("is-visible");
          }
        });
      };
      document.addEventListener("astro:page-load", restoreScrollReveal);

      const initCountUp = () => {
        const targets = document.querySelectorAll("[data-countup]");
        if (!targets.length) return;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const format = new Intl.NumberFormat("es-AR");

        const render = (el: HTMLElement, value: number) => {
          el.textContent = `${el.dataset.prefix ?? ""}${format.format(value)}${el.dataset.suffix ?? ""}`;
        };

        const animate = (el: HTMLElement) => {
          const raw = (el.dataset.raw ?? "").trim();
          const match = raw.match(/^(\D*)([\d.,]+)(\D*)$/);
          if (!match) return;
          const prefix = match[1];
          const digits = match[2].replace(/[^\d]/g, "");
          const suffix = match[3];
          const target = Number(digits);
          el.dataset.prefix = prefix;
          el.dataset.suffix = suffix;
          if (reduce || !target) {
            render(el, target);
            return;
          }
          const duration = 700;
          const start = performance.now();
          const step = (now: number) => {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            render(el, Math.round(target * eased));
            if (progress < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                animate(entry.target as HTMLElement);
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.4 }
        );

        targets.forEach((target) => {
          const element = target as HTMLElement;
          if (element.dataset.raw !== undefined) return;
          element.dataset.raw = (element.textContent ?? "").trim();
          observer.observe(element);
        });
      };
      document.addEventListener("astro:page-load", initCountUp);
      initCountUp();
    </script>
    <script>
      const onCtaClick = (event: Event) => {
        const link = event.currentTarget as HTMLAnchorElement | null;
        if (!link) return;
        const href = link.getAttribute("href") || "";
        const hashIndex = href.indexOf("#");
        if (hashIndex === -1) return;
        const targetUrl = new URL(link.href, window.location.origin);
        const currentUrl = new URL(window.location.href);
        const samePage =
          targetUrl.pathname.replace(/\/+$/, "") ===
          currentUrl.pathname.replace(/\/+$/, "");
        if (!samePage) return;
        const hash = targetUrl.hash;
        if (!hash) return;
        const target = document.getElementById(hash.slice(1));
        if (!target) return;
        event.preventDefault();
        event.stopPropagation();
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        target.scrollIntoView({
          behavior: reduce ? "auto" : "smooth",
          block: "start",
        });
      };
      const initCtaScroll = () => {
        document.querySelectorAll('a[href*="#"]').forEach((link) => {
          link.removeEventListener("click", onCtaClick, true);
          link.addEventListener("click", onCtaClick, true);
        });
      };
      document.addEventListener("astro:page-load", initCtaScroll);
      initCtaScroll();
    </script>
  </body>
</html>
