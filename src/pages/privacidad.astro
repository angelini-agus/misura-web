---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageHeader from "../components/PageHeader.astro";
import Footer from "../components/Footer.astro";
import { privacy } from "../lib/content";
---

<BaseLayout title={privacy.title} description={privacy.description}>
  <Header />
  <main id="contenido" class="flex-1" tabindex="-1">
    <PageHeader
      eyebrow={privacy.eyebrow}
      title={privacy.h1}
      intro={privacy.intro}
    />
    <section class="border-t border-green">
      <div class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-20">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-green/75">
          {privacy.updatedAt}
        </p>
        <div class="mt-10 flex flex-col gap-10">
          {privacy.sections.map((section) => (
            <div>
              <h2
                class="font-display text-2xl font-medium leading-tight tracking-tight sm:text-3xl"
              >
                {section.title}
              </h2>
              {section.body.map((paragraph) => (
                <p class="mt-3 leading-relaxed text-green/80">{paragraph}</p>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
