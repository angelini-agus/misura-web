---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout
  title="Página no encontrada | BottegaDevs"
  description="El link que seguiste no existe o cambió de dirección. Volvé al inicio o contanos qué necesitabas: empezamos con un prototipo gratis."
>
  <Header />
  <main id="contenido" class="flex-1" tabindex="-1">
    <section class="mx-auto max-w-6xl px-4 py-24 md:px-6 md:py-32">
      <div class="max-w-2xl" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-green/70">
          Error 404
        </p>
        <h1
          class="font-display mt-3 text-4xl font-medium leading-tight tracking-tight sm:text-5xl"
        >
          Página no encontrada
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-green/80">
          El link que seguiste está roto o la dirección cambió. Volvé al inicio o
          contanos qué necesitabas y lo resolvemos.
        </p>
        <div class="mt-10 flex flex-wrap gap-4" data-reveal>
          <Button href="/">Volver al inicio</Button>
          <Button href="/contacto" variant="outline">Ir a contacto</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
