---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import About from "../components/About.astro";
import Team from "../components/Team.astro";
import HowWeWork from "../components/HowWeWork.astro";
import ClientQuote from "../components/ClientQuote.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import { pages, nosotrosCta } from "../lib/content";
---

<BaseLayout
  title={pages.nosotros.title}
  description={pages.nosotros.description}
>
  <Header />
  <main id="contenido" class="flex-1" tabindex="-1">
    <About />
    <Team />
    <HowWeWork />
    <ClientQuote />
    <CtaBanner
      eyebrow={nosotrosCta.eyebrow}
      title={nosotrosCta.title}
      label={nosotrosCta.label}
      href={nosotrosCta.href}
    />
  </main>
  <Footer />
  <StickyCta />
</BaseLayout>
