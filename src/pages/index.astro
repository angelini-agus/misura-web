---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Clients from "../components/Clients.astro";
import Problem from "../components/Problem.astro";
import Services from "../components/Services.astro";
import HowItWorksHome from "../components/HowItWorksHome.astro";
import ForWho from "../components/ForWho.astro";
import Differentiators from "../components/Differentiators.astro";
import Faq from "../components/Faq.astro";
import Explore from "../components/Explore.astro";
import Team from "../components/Team.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
---

<BaseLayout>
  <Header />
  <main id="contenido" class="flex-1" tabindex="-1">
    <Hero />
    <Clients />
    <Problem />
    <Services />
    <HowItWorksHome />
    <ForWho />
    <Differentiators />
    <Faq />
    <Explore />
    <Team />
    <Contact simple />
  </main>
  <Footer />
  <StickyCta />
</BaseLayout>
