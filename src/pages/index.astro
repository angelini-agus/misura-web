---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Clients from "../components/Clients.astro";
import Problem from "../components/Problem.astro";
import Services from "../components/Services.astro";
import ForWho from "../components/ForWho.astro";
import Differentiators from "../components/Differentiators.astro";
import Faq from "../components/Faq.astro";
import Explore from "../components/Explore.astro";
import TeamTeaser from "../components/TeamTeaser.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
---

<BaseLayout>
  <Header />
  <main id="contenido" class="flex-1" tabindex="-1">
    <Hero />
    <Clients />
    <!-- El equipo va aca, pegado a la prueba social, y no al final ni debajo del
         hero: cierra el par promesa+resultados con "esto lo hace este equipo", y
         entre las metricas y el problem statement funciona como respiro visual.
         Debajo del hero serian dos fotos sin contexto (el teaser no muestra
         nombres ni roles): decoracion antes de que se entienda la oferta. -->
    <TeamTeaser />
    <Problem />
    <Services />
    <ForWho />
    <Differentiators />
    <Faq />
    <Explore />
    <Contact simple />
  </main>
  <Footer />
  <StickyCta />
</BaseLayout>
