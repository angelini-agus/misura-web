---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Clients from "../components/Clients.astro";
import Differentiators from "../components/Differentiators.astro";
import Faq from "../components/Faq.astro";
import Explore from "../components/Explore.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
---

<BaseLayout>
  <Header />
  <main id="contenido" class="flex-1" tabindex="-1">
    <Hero />
    <Services />
    <Clients />
    <Differentiators />
    <Faq />
    <Explore />
  </main>
  <Footer />
  <StickyCta />
</BaseLayout>
